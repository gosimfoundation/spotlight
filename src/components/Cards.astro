---
interface Props {
	title: string,
    description: string,
    cards?: Array<{
        title: string,
        description: string,
        image: string,
        date?: string,
        location?: string,
    }>,
}

const { title, description, cards } = Astro.props;
---

<section
    class="section section-home-why"
    data-theme-section="light"
    data-bg-section="lightgray"
    id="why-participate"
>
    <div class="container">
        <div class="row row-title grid">
            <div class="col col-title">
                <h2>{title}</h2>
            </div>

            <div class="col styled-content">
                <p>{description}</p>
            </div>
        </div>

        <div class="row row-audience grid">
            {cards?.map((loop) => (
                <div class="col why-reasons">
                    <img
                        src={loop.image}
                        alt={loop.title}
                        width="48"
                        height="48"
                        loading="lazy"
                    />
                    <div class="why-content">
                        <h4>{loop.title}</h4>
                        <p>{loop.description}</p>
                        {(loop.date || loop.location) && (
                            <div class="card-facts">
                                {loop.date && <p class="card-date">{loop.date}</p>}
                                {loop.location && <p class="card-location">{loop.location}</p>}
                            </div>
                        )}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .card-facts {
        margin-top: 1rem;
    }
    .card-date {
        font-weight: 600;
        margin: 0;
    }
    .card-location {
        letter-spacing: 0.12em;
        margin: 0.15rem 0 0;
        opacity: 0.75;
    }
</style>
