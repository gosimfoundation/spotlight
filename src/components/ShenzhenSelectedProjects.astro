---
import { shenzhenSelectedProjects, shenzhenSelectionCopy } from "../data/shenzhen-selection";
import type { Locale } from "../i18n/translations";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = shenzhenSelectionCopy[locale];
// Enable the photo layout when the updated project photos are ready.
const showProjectPhotos = false;
---

<section class="selected-projects" id="selected-projects" data-theme-section="light" data-bg-section="light" aria-labelledby="selection-title">
  <div class="selected-projects-confetti" aria-hidden="true">
    <video id="selection-confetti-video" data-autoplay-video autoplay muted loop playsinline webkit-playsinline="true" preload="metadata">
      <source src="/videos/confetti.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="selection-shell">
    <div class="selected-projects-head">
      <svg class="selected-badge" viewBox="209 198 832 839" width="320" height="323" role="img" aria-label="Spotlight Shenzhen 2026">
        <image href="/images/shenzhen2026/spotlight-shenzhen-2026-badge.png" width="1250" height="1250" />
      </svg>
      <div class="selected-projects-copy">
        <p class="selection-eyebrow">SPOTLIGHT SHENZHEN 2026</p>
        <h2 id="selection-title">{c.title}</h2>
        <p class="selection-description">{c.description}</p>
        <p class="selection-date">{c.date}</p>
      </div>
    </div>
    <div class="selected-projects-note">
      <strong>{shenzhenSelectedProjects.length} {c.count}</strong>
      <span>{c.note}</span>
    </div>
    <ol class="selected-project-grid" aria-label={c.count}>
      {shenzhenSelectedProjects.map((project, index) => (
        <li>
          <article class="selection-card selected-project-card">
            {showProjectPhotos && <div class:list={["selected-project-media", { "selected-project-media--empty": !project.image, "selected-project-media--xlerobot": project.name === "XLeRobot" }]}>
              {project.image
                ? <img src={project.image} alt={project.name} loading="lazy" decoding="async" style={`object-position: ${project.imagePosition || "center"}`} />
                : <span class="project-media-label" aria-hidden="true">SPOTLIGHT / SHENZHEN 2026</span>}
              <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            </div>}
            <div class="selected-project-info">
              <h3>{project.name}</h3>
              <p>{project.description[locale]}</p>
              <a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${c.projectLink} · ${project.name}`}>
                {c.projectLink}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span>
              </a>
            </div>
          </article>
        </li>
      ))}
    </ol>
    <div class="selection-footer">
      <div><span class="closed-status">{c.status}</span><p>{c.closed}</p></div>
      <a href="https://shenzhen2026.gosim.org" target="_blank" rel="noopener noreferrer">
        {c.conference}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .selected-projects {
    --selection-ink: #171918;
    --selection-muted: #5e625f;
    position: relative; isolation: isolate; overflow: hidden;
    padding: clamp(60px, 5.5vw, 84px) 0;
    color: var(--selection-ink); background: #fffdf8; border-bottom: 1px solid var(--selection-ink);
    font-family: "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif; scroll-margin-top: 130px;
  }
  .selection-shell { position: relative; z-index: 1; width: min(1440px, calc(100% - 96px)); margin: 0 auto; }
  .selected-projects-confetti { position: absolute; z-index: 0; inset: 0 0 auto; height: clamp(400px, 45vw, 650px); overflow: hidden; opacity: .65; pointer-events: none; mix-blend-mode: multiply; }
  .selected-projects-confetti::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,253,248,.22), #fffdf8); }
  .selected-projects-confetti video { width: 100%; height: 100%; object-fit: cover; filter: saturate(.8); }
  .selected-projects-head { display: grid; grid-template-columns: clamp(240px, 25vw, 320px) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; margin-bottom: clamp(36px, 4vw, 56px); }
  .selected-badge { display: block; width: 100%; height: auto; overflow: visible; }
  .selection-eyebrow { display: flex; align-items: center; gap: 10px; margin: 0; color: #40596d; font-size: 14px; font-weight: 800; letter-spacing: .13em; line-height: 1.35; }
  .selection-eyebrow::before { content: ""; width: 15px; height: 3px; flex-shrink: 0; background: #ff431a; }
  .selected-projects-copy h2 { max-width: 20ch; margin: 14px 0 0; color: var(--selection-ink); font-size: clamp(2.2rem, 3.8vw, 3.8rem); font-weight: 700; line-height: 1.1; letter-spacing: -.045em; }
  :global(html[lang="zh"]) .selected-projects-copy h2 { max-width: none; line-height: 1.2; letter-spacing: -.025em; }
  .selection-description { max-width: 900px; margin: 18px 0 0; color: var(--selection-muted); font-size: 17px; line-height: 1.65; }
  .selection-date { margin: 18px 0 0; color: #40596d; font-size: 14px; font-weight: 750; line-height: 1.5; }
  .selected-projects-note { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 18px; color: var(--selection-muted); font-size: 13px; line-height: 1.5; }
  .selected-projects-note strong { color: var(--selection-ink); font-size: 18px; font-weight: 750; }
  .selected-project-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 1px; background: var(--selection-ink); list-style: none; }
  .selected-project-grid > li { min-width: 0; background: #fff; }
  .selected-project-card { display: flex; flex-direction: column; height: 100%; min-width: 0; background: #fff; }
  .selected-project-media { position: relative; flex-shrink: 0; aspect-ratio: 1.35; overflow: hidden; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; background: #e8e7e2; }
  .selected-project-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(0,0,0,.5)); }
  .selected-project-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .selected-project-media--xlerobot img { filter: brightness(1.28) contrast(.92); }
  .selected-project-media--xlerobot::after { background: linear-gradient(180deg, transparent 65%, rgba(0,0,0,.22)); }
  .project-number { position: relative; z-index: 1; margin-top: auto; color: #fff; text-shadow: 0 1px 7px rgba(0,0,0,.6); font-size: clamp(2.8rem, 4vw, 4.8rem); font-weight: 800; line-height: .85; letter-spacing: -.07em; }
  .project-media-label { color: #40596d; font-size: 10px; font-weight: 800; letter-spacing: .1em; line-height: 1.5; }
  .selected-project-media--empty::after { inset: auto 18px 18px auto; width: 32%; height: 32%; border: 1px solid rgba(23,25,24,.18); border-radius: 50%; background: none; }
  .selected-project-media--empty .project-number { color: #40596d; text-shadow: none; }
  .selected-project-grid > li:nth-child(4n + 2) .selected-project-media--empty { background: #edc5b2; }
  .selected-project-grid > li:nth-child(4n + 3) .selected-project-media--empty { background: #c6d2dc; }
  .selected-project-grid > li:nth-child(4n + 4) .selected-project-media--empty { background: #e7edf1; }
  .selected-project-info { flex: 1; min-height: 218px; padding: 22px; display: flex; flex-direction: column; align-items: flex-start; }
  .selected-project-media + .selected-project-info { border-top: 1px solid var(--selection-ink); }
  .selected-project-info h3 { margin: 0; color: var(--selection-ink); font-size: clamp(1.25rem, 1.55vw, 1.7rem); font-weight: 700; line-height: 1.2; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .selected-project-info p { margin: 12px 0 0; color: var(--selection-muted); font-size: 14px; line-height: 1.6; }
  .selected-project-info a { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 20px; border-bottom: 1px solid var(--selection-ink); color: var(--selection-ink); font-size: 13px; font-weight: 800; line-height: 1.5; text-decoration: none; }
  .selection-footer { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 36px; padding-top: 28px; border-top: 1px solid rgba(23,25,24,.22); }
  .closed-status { display: inline-flex; padding: 5px 9px; border: 1px solid #40596d; color: #40596d; background: #e7edf1; font-size: 13px; font-weight: 750; line-height: 1.4; }
  .selection-footer p { margin: 10px 0 0; color: var(--selection-muted); font-size: 14px; line-height: 1.6; }
  .selection-footer > a { display: inline-flex; align-items: center; gap: 24px; padding: 14px 20px; border: 1px solid var(--selection-ink); color: var(--selection-ink); font-size: 15px; font-weight: 750; text-decoration: none; }
  .selected-projects a:hover { color: #a53a22; border-color: #a53a22; }
  .selected-projects a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .selected-projects .shape-icon { width: 11px; height: 11px; }
  @media (max-width: 1100px) { .selection-shell { width: calc(100% - 56px); } .selected-project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .selected-projects { padding-block: 48px; }
    .selection-shell { width: calc(100% - 32px); }
    .selected-projects-head { grid-template-columns: 1fr; gap: 28px; margin-bottom: 32px; }
    .selected-badge { width: 200px; }
    .selected-projects-copy h2 { font-size: clamp(1.9rem, 7vw, 2.5rem); }
    .selection-description { font-size: 16px; }
    .selected-project-grid { grid-template-columns: 1fr; }
    .selected-project-media { aspect-ratio: 1.7; }
    .selected-project-info { min-height: 190px; padding: 20px; }
    .project-number { font-size: 4.4rem; }
    .selection-footer { align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .selected-projects-confetti { display: none; } }
</style>
