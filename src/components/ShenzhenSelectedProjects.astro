---
import { shenzhenSelectedProjects, shenzhenSelectionCopy } from "../data/shenzhen-selection";
import type { Locale } from "../i18n/translations";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = shenzhenSelectionCopy[locale];
---

<section class="selection" id="selected-projects" data-theme-section="light" data-bg-section="light" aria-labelledby="selection-title">
  <div class="selection-shell">
    <div class="selection-status">
      <span class="closed-status">{c.status}</span>
      <p>{c.closed}</p>
    </div>
    <div class="selection-heading">
      <div>
        <p class="selection-eyebrow">SPOTLIGHT SHENZHEN 2026 / {c.topic}</p>
        <h1 id="selection-title">{c.title}</h1>
        <p class="selection-description">{c.description}</p>
        <p class="selection-date">{c.date}</p>
      </div>
      <img class="selection-badge" src="/images/shenzhen2026/spotlight-shenzhen-2026-badge.png" alt="Spotlight Shenzhen 2026" width="1250" height="1250" />
    </div>
    <div class="selection-list-heading">
      <h2><strong>{shenzhenSelectedProjects.length}</strong> {c.count}</h2>
      <span>{c.note}</span>
    </div>
    <ol class="selection-grid" aria-label={c.count}>
      {shenzhenSelectedProjects.map((project, index) => (
        <li>
          <article class="selection-card">
            <span class="selection-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{project.name}</h3>
            <p>{project.description[locale]}</p>
            <a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${c.projectLink} · ${project.name}`}>
              {c.projectLink}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span>
            </a>
          </article>
        </li>
      ))}
    </ol>
    <a class="selection-conference" href="https://shenzhen2026.gosim.org" target="_blank" rel="noopener noreferrer">
      {c.conference}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .selection { color: #171918; background: #fffdf8; font-family: "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif; scroll-margin-top: 90px; }
  .selection-shell { width: min(1440px, calc(100% - 96px)); margin: 0 auto; padding: 112px 0 48px; }
  .selection-status { display: flex; align-items: center; gap: 16px; padding-bottom: 18px; border-bottom: 1px solid #d7d8d1; }
  .closed-status { display: inline-flex; align-items: center; flex-shrink: 0; gap: 8px; border: 1px solid #747b6e; padding: 6px 10px; color: #455b43; background: #edf2e8; font-size: 13px; line-height: 1.4; font-weight: 700; }
  .closed-status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #455b43; }
  .selection-status p { margin: 0; color: #5e625f; font-size: 14px; line-height: 1.5; }
  .selection-heading { display: grid; grid-template-columns: minmax(0, 1fr) 170px; align-items: center; gap: 24px; padding: 30px 0; }
  .selection-eyebrow { margin: 0; color: #a53a22; font-size: 12px; font-weight: 800; letter-spacing: .09em; line-height: 1.5; }
  .selection-heading h1 { max-width: 24ch; margin: 14px 0; color: #171918; font-size: clamp(2.2rem, 4.5vw, 4.5rem); font-weight: 650; line-height: 1.1; letter-spacing: -.04em; }
  .selection-description { max-width: 880px; margin: 0; color: #5e625f; font-size: 16px; line-height: 1.65; }
  .selection-date { margin: 16px 0 0; font-size: 14px; line-height: 1.5; font-weight: 750; }
  .selection-badge { width: 170px; height: 170px; object-fit: contain; }
  .selection-list-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; padding-bottom: 14px; }
  .selection-list-heading h2 { margin: 0; color: #171918; font-size: 18px; line-height: 1.5; font-weight: 650; }
  .selection-list-heading strong { margin-right: 6px; font-size: 28px; }
  .selection-list-heading > span { color: #5e625f; font-size: 12px; }
  .selection-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 1px; background: #d7d8d1; list-style: none; }
  .selection-grid > li { min-width: 0; background: #fff; }
  .selection-card { height: 100%; display: flex; flex-direction: column; align-items: flex-start; padding: 22px; }
  .selection-number { margin-bottom: 14px; color: #a53a22; font-size: 12px; font-weight: 800; letter-spacing: .08em; }
  .selection-card h3 { margin: 0; color: #171918; font-size: 20px; font-weight: 750; letter-spacing: -.025em; line-height: 1.35; overflow-wrap: anywhere; }
  .selection-card p { margin: 12px 0 18px; color: #5e625f; font-size: 14px; line-height: 1.6; }
  .selection-card a { display: inline-flex; align-items: center; gap: 10px; margin-top: auto; padding: 3px 0; border-bottom: 1px solid #171918; color: #171918; font-size: 12px; line-height: 1.5; font-weight: 800; text-decoration: none; }
  .selection a:hover { color: #a53a22; border-color: #a53a22; }
  .selection a:focus-visible { outline: 3px solid #a53a22; outline-offset: 5px; }
  .selection .shape-icon { width: 11px; height: 11px; }
  .selection-conference { display: inline-flex; gap: 18px; align-items: center; margin-top: 24px; padding: 12px 16px; border: 1px solid #171918; color: #171918; font-size: 14px; font-weight: 750; text-decoration: none; }
  @media (max-width: 1100px) { .selection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .selection-shell { width: calc(100% - 40px); padding-top: 94px; }
    .selection-status { align-items: flex-start; gap: 10px; }
    .selection-status p { font-size: 12px; }
    .selection-heading { grid-template-columns: minmax(0, 1fr) 76px; gap: 12px; align-items: start; }
    .selection-badge { width: 76px; height: 76px; }
    .selection-heading h1 { font-size: clamp(2rem, 6.5vw, 3rem); }
    .selection-description { font-size: 14px; }
    .selection-eyebrow { font-size: 10px; }
    .selection-card { padding: 18px; }
  }
  @media (max-width: 520px) {
    .selection-grid { grid-template-columns: 1fr; }
    .selection-heading { position: relative; display: block; padding-top: 24px; }
    .selection-badge { position: absolute; right: 0; top: 20px; width: 58px; height: 58px; }
    .selection-eyebrow { max-width: calc(100% - 70px); min-height: 48px; }
    .selection-card { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 0 12px; }
    .selection-number { grid-column: 1; grid-row: 1 / 4; margin: 5px 0 0; }
    .selection-card h3, .selection-card p, .selection-card a { grid-column: 2; }
    .selection-card a { justify-self: start; }
    .selection-card h3 { font-size: 18px; }
  }
</style>
