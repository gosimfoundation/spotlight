---
import { Picture } from "astro:assets"
import Layout from "layouts/Layout.astro"
import SpotlightHero from "components/SpotlightHero.astro"
import GosimDelft from "images/homepage/gosim-delft.png"
import GosimParis2 from "images/homepage/gosim-paris2025.png"
import GosimHangzhou from "images/homepage/gosim-hangzhou.png"
import GosimParis2026 from "images/homepage/paris-hero-bk.jpg"
import { getTranslations, getLocalizedPath, type Locale } from "../i18n/translations"

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const previousEvents = [
  {
    title: t("previous.paris2026.title"),
    date: t("previous.paris2026.date"),
    description: t("previous.paris2026.desc"),
    image: GosimParis2026,
    link: getLocalizedPath("/paris2026", locale),
  },
  {
    title: t("previous.hangzhou.title"),
    date: t("previous.hangzhou.date"),
    description: t("previous.hangzhou.desc"),
    image: GosimHangzhou,
    link: getLocalizedPath("/hangzhou2025", locale),
  },
  {
    title: t("previous.paris.title"),
    date: t("previous.paris.date"),
    description: t("previous.paris.desc"),
    image: GosimParis2,
    link: getLocalizedPath("/paris2025", locale),
  },
  {
    title: t("previous.delft.title"),
    date: t("previous.delft.date"),
    description: t("previous.delft.desc"),
    image: GosimDelft,
    link: getLocalizedPath("/delft2025", locale),
  },
];

const benefits = [
  { title: t("home.why.showcase.title"), description: t("home.why.showcase.desc") },
  { title: t("home.why.travel.title"), description: t("home.why.travel.desc") },
  { title: t("home.why.mentorship.title"), description: t("home.why.mentorship.desc") },
  { title: t("home.why.visibility.title"), description: t("home.why.visibility.desc") },
  { title: t("home.why.networking.title"), description: t("home.why.networking.desc") },
  { title: t("home.why.community.title"), description: t("home.why.community.desc") },
];
---

<Layout
  title={t("home.meta.title")}
  description={t("home.meta.desc")}
  navDarkMode={false}
  spotlightIntro={true}
  navBackground="header-home"
  pageTransitionName="Home"
  locale={locale}
  nativeScroll={true}
  footerVariant="spotlight"
  footerCta={{
    title: t("home.cta.title"),
    text: t("home.cta.text"),
    buttonText: t("home.cta.button"),
    buttonLink: getLocalizedPath("/shenzhen2026", locale),
  }}
>
  <SpotlightHero
    subtitle={t("home.hero.subtitle")}
    eyebrow={t("home.hero.eyebrow")}
    sceneLabel={t("home.hero.sceneLabel")}
    exploreLabel={t("home.hero.explore")}
    announcement={{
      text: t("home.hero.announcement"),
      link: getLocalizedPath("/shenzhen2026", locale),
    }}
  />

  <section
    class="home-section home-about"
    id="about"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="home-shell">
      <div class="section-label">
        <span>01</span>
        <span>{t("nav.about")}</span>
      </div>
      <div class="about-grid">
        <h2>{t("home.intro.heading")}</h2>
        <p>{t("home.intro.body")}</p>
      </div>
    </div>
  </section>

  <section
    class="home-section current-spotlight"
    id="current"
    data-theme-section="dark"
    data-bg-section="dark"
  >
    <div class="home-shell current-content">
      <div class="section-label section-label--light">
        <span>02</span>
        <span>{t("nav.upcoming")}</span>
      </div>

      <div class="current-layout">
        <div class="current-copy">
          <h2>{t("home.upcoming.card.title")}</h2>
          <p class="current-slogan">NEXT IS NOT GIVEN.</p>
          <p class="current-description">{t("home.upcoming.card.desc")}</p>
          <dl class="event-facts">
            <div>
              <dt>01</dt>
              <dd>{t("home.upcoming.date")}</dd>
            </div>
            <div>
              <dt>02</dt>
              <dd>{t("home.upcoming.location")}</dd>
            </div>
          </dl>
          <div class="event-links">
            <a href={getLocalizedPath("/shenzhen2026", locale)}>
              <span>{t("home.upcoming.button")}</span><span class="shape-icon shape-icon--arrow shape-icon--up-right event-link-icon" aria-hidden="true"></span>
            </a>
            <a href="https://shenzhen2026.gosim.org" target="_blank" rel="noopener noreferrer">
              <span>{t("home.upcoming.colocated")}</span><span class="shape-icon shape-icon--arrow shape-icon--up-right event-link-icon" aria-hidden="true"></span>
            </a>
          </div>
        </div>

        <div class="current-media">
          <video
            id="shenzhen-spotlight-video"
            class="current-video"
            data-shenzhen-video
            data-autoplay-video
            autoplay
            muted
            loop
            playsinline
            webkit-playsinline="true"
            preload="auto"
            poster="/images/shenzhen2026/shenzhen-video-poster.jpg"
          >
            <source
              src="/videos/shenzhen-spotlight-soundless-mobile.mp4"
              type="video/mp4"
              media="(max-width: 760px)"
            />
            <source src="/videos/shenzhen-spotlight-soundless.mp4" type="video/mp4" />
          </video>
          <button
            class="video-play-button"
            type="button"
            data-autoplay-fallback-for="shenzhen-spotlight-video"
            aria-controls="shenzhen-spotlight-video"
            hidden
          >
            <span class="shape-icon shape-icon--play" aria-hidden="true"></span>
            {t("home.upcoming.playVideo")}
          </button>
        </div>
      </div>
    </div>
  </section>

  <section
    class="home-section previous-section"
    id="previous"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="home-shell">
      <div class="section-label">
        <span>03</span>
        <span>{t("nav.previous")}</span>
      </div>
      <div class="section-heading">
        <h2>{t("previous.title")}</h2>
      </div>

      <div class="events-grid">
        {previousEvents.map((event, index) => (
          <a class:list={["event-card", `event-card--${index + 1}`]} href={event.link}>
            <div class="event-image">
              <Picture
                src={event.image}
                formats={["avif", "webp"]}
                alt={event.title}
                widths={[480, 720, 1080]}
                sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 42vw"
                loading="lazy"
              />
              <span class="event-icon" aria-hidden="true"><span class="shape-icon shape-icon--arrow shape-icon--up-right"></span></span>
            </div>
            <div class="event-copy">
              <p class="event-date">{event.date}</p>
              <h3>{event.title}</h3>
              <p>{event.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section
    class="home-section why-section"
    id="why"
    data-theme-section="light"
    data-bg-section="light"
  >
    <div class="home-shell">
      <div class="section-label">
        <span>04</span>
        <span>{t("nav.why")}</span>
      </div>
      <div class="why-intro">
        <h2>{t("home.why.title")}</h2>
        <p>{t("home.why.desc")}</p>
      </div>
      <ol class="benefits-grid">
        {benefits.map((benefit, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{benefit.title}</h3>
            <p>{benefit.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

<style>
  :global(body[data-bg-nav="header-home"]) {
    --home-ink: #062e37;
    --home-blue: #043e5d;
    --home-mint: #64e6bd;
    --home-paper: #f8f9f6;
    --home-rule: rgba(6, 46, 55, 0.18);
  }

  :global(body[data-bg-nav="header-home"] .main-nav-bar) {
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .home-section {
    position: relative;
    isolation: isolate;
    color: var(--home-ink);
    background: var(--home-paper);
    font-family: "Manrope", sans-serif;
  }

  .home-shell {
    width: min(86vw, 78rem);
    margin: 0 auto;
    padding: clamp(5.5rem, 10vw, 9rem) 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
    color: #315b52;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-label span:first-child {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--home-rule);
    border-radius: 50%;
    color: var(--home-ink);
    font-size: 0.64rem;
    letter-spacing: 0;
  }

  .section-label--light {
    color: rgba(255, 255, 255, 0.72);
  }

  .section-label--light span:first-child {
    border-color: rgba(255, 255, 255, 0.32);
    color: var(--home-mint);
  }

  .home-about {
    background: #eef2ee;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.72fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .about-grid h2,
  .section-heading h2,
  .why-intro h2 {
    margin: 0;
    font-family: "Manrope", sans-serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .about-grid h2 {
    max-width: 54rem;
    font-size: clamp(2.35rem, 4.2vw, 4.35rem);
    line-height: 1.18;
  }

  .about-grid p {
    margin: 0 0 0.45rem;
    color: #46605d;
    font-size: clamp(1rem, 1.2vw, 1.16rem);
    font-weight: 550;
    line-height: 1.7;
  }

  .current-spotlight {
    color: #fff;
    background: #062e37;
  }

  .current-content {
    padding-top: clamp(5.5rem, 8vw, 7.5rem);
    padding-bottom: clamp(5.5rem, 8vw, 7.5rem);
  }

  .current-content > .section-label {
    margin-bottom: clamp(2.75rem, 5vw, 4.5rem);
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .current-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr);
    gap: clamp(3rem, 6vw, 6.5rem);
    align-items: center;
  }

  .current-copy { max-width: 39rem; }

  .current-copy h2 {
    max-width: 10ch;
    margin: 0;
    color: #fff;
    font-family: "Manrope", sans-serif;
    font-size: clamp(3.25rem, 4.6vw, 5.2rem);
    font-weight: 620;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  :global(html[lang="zh"]) .current-copy h2 {
    max-width: 9ch;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  .current-slogan {
    margin: 1.35rem 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .current-description {
    max-width: 36rem;
    margin: 1.25rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    font-weight: 540;
    line-height: 1.7;
  }

  .event-facts {
    display: flex;
    gap: clamp(1.75rem, 4vw, 4rem);
    margin: clamp(2rem, 4vw, 3.25rem) 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }

  .event-facts div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: baseline;
  }

  .event-facts dt {
    color: #ff8068;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .event-facts dd {
    margin: 0;
    color: #fff;
    font-size: 0.84rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-links {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-top: 1.6rem;
  }

  .event-links a {
    min-height: 3.25rem;
    display: inline-flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    border: 1px solid #ff431a;
    color: #171918;
    background: #ff431a;
    font-size: 0.94rem;
    font-weight: 750;
    line-height: 1.2;
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .event-links a:last-child {
    color: #171918;
    border-color: rgba(247, 247, 244, 0.94);
    background: rgba(247, 247, 244, 0.94);
  }

  .event-links .event-link-icon {
    color: currentColor;
    font-style: normal;
  }

  .event-links a:hover {
    color: #171918;
    border-color: #fff;
    background: #fff;
  }

  .event-links a:last-child:hover {
    color: #171918;
    border-color: #ff431a;
    background: #ff431a;
  }

  .current-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #090909;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .current-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #090909;
    filter: none;
  }

  .video-play-button {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3rem;
    padding: 0 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    color: #fff;
    background: rgba(9, 9, 9, 0.72);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 750;
    cursor: pointer;
    transform: translate(-50%, -50%);
  }

  .video-play-button[hidden] { display: none; }
  .video-play-button span { font-size: 0.74rem; }

  .previous-section {
    background: var(--home-paper);
    content-visibility: auto;
    contain-intrinsic-size: auto 1100px;
  }

  .section-heading {
    max-width: 54rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-heading h2,
  .why-intro h2 {
    font-size: clamp(2.5rem, 4.6vw, 4.75rem);
    line-height: 1.14;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem) clamp(1.5rem, 3vw, 3rem);
  }

  .event-card {
    grid-column: span 6;
    color: var(--home-ink);
    text-decoration: none;
  }

  .event-card--1 {
    grid-column: span 7;
  }

  .event-card--2 {
    grid-column: span 5;
  }

  .event-image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #dfe8e4;
  }

  .event-card--2 .event-image {
    aspect-ratio: 5 / 4;
  }

  .event-image :global(picture),
  .event-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .event-image :global(img) {
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .event-image > .event-icon {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border-radius: 50%;
    color: var(--home-blue);
    background: var(--home-mint);
    font-size: 1rem;
  }

  .event-card:hover .event-image :global(img) {
    transform: scale(1.025);
  }

  .event-copy {
    border-top: 1px solid var(--home-rule);
    margin-top: 1rem;
    padding-top: 1.25rem;
  }

  .event-date {
    margin: 0 0 1.1rem;
    color: #417066;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .event-copy h3 {
    max-width: 30rem;
    margin: 0 0 0.8rem;
    font-size: clamp(1.45rem, 2.2vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .event-copy > p:last-child {
    max-width: 39rem;
    margin: 0;
    color: #526865;
    font-size: 0.94rem;
    font-weight: 520;
    line-height: 1.6;
  }

  .why-section {
    background: #eef2ee;
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }

  .why-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
    margin-bottom: clamp(4rem, 8vw, 7rem);
    align-items: end;
  }

  .why-intro p {
    margin: 0 0 0.3rem;
    color: #46605d;
    font-size: clamp(1rem, 1.25vw, 1.16rem);
    font-weight: 550;
    line-height: 1.7;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(3rem, 5vw, 5rem) clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .benefits-grid li {
    position: relative;
    border-top: 1px solid rgba(6, 46, 55, 0.28);
    padding-top: 1.2rem;
  }

  .benefits-grid li::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--home-mint);
  }

  .benefits-grid li > span {
    display: block;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    color: #417066;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .benefits-grid h3 {
    margin: 0 0 0.85rem;
    color: var(--home-ink);
    font-size: clamp(1.3rem, 2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .benefits-grid p {
    margin: 0;
    color: #526865;
    font-size: 0.94rem;
    font-weight: 530;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .about-grid,
    .why-intro {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .current-layout { grid-template-columns: 1fr; gap: 3.5rem; }

    .current-copy { max-width: 44rem; }

    .event-links {
      justify-content: flex-start;
    }

    .event-card,
    .event-card--1,
    .event-card--2 {
      grid-column: span 6;
    }

    .event-card--2 .event-image {
      aspect-ratio: 16 / 10;
    }

    .benefits-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .home-shell {
      width: min(88vw, 78rem);
      padding: 5rem 0;
    }

    .section-label {
      margin-bottom: 3.25rem;
    }

    .about-grid h2,
    .section-heading h2,
    .why-intro h2 {
      font-size: clamp(2rem, 8.5vw, 2.7rem);
      line-height: 1.16;
    }

    .current-copy h2 {
      font-size: clamp(3rem, 12vw, 4.5rem);
      line-height: 1.1;
    }

    .current-copy { max-width: 100%; }

    .event-links a { width: 100%; }

    .event-facts {
      flex-direction: column;
      gap: 0.8rem;
    }

    .events-grid {
      display: block;
    }

    .event-card {
      display: block;
      margin-bottom: 3.5rem;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
    }

    .benefits-grid li > span {
      margin-bottom: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-image :global(img) {
      transition: none;
    }
  }
</style>
