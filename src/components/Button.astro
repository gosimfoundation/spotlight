---
interface Props {
	text: string,
    link: string,
    openInNewTab?: boolean,
    class?: string,
    iconDirection?: "right" | "up-right" | "down" | "left",
}

const { text, link, openInNewTab, class: className, iconDirection } = Astro.props;
---

<div class={className || 'btn outline btn-hover xl'}>
    <a
        href={link}
        class="btn-click"
        target={openInNewTab ? "_blank" : "_self"}
        rel={openInNewTab ? "noopener noreferrer" : ""}
    >
        <div class="btn-content duplicate">
            <div class="btn-fill"></div>
            <span>{text}</span>
            {iconDirection && <span class:list={["shape-icon", "shape-icon--arrow", `shape-icon--${iconDirection}`]} aria-hidden="true"></span>}
        </div>

        <div class="border-box"></div>
    </a>
</div>
