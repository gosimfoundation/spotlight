---
import { locales, localeNames, getLocaleFromUrl, getLocalizedPath, type Locale } from "../i18n/translations";

interface Props {
  locale?: Locale;
}

const currentLocale = Astro.props.locale || getLocaleFromUrl(Astro.url);
const isShenzhenPath = /^\/(?:(?:en|fr|zh)\/)?shenzhen2026(?:\/|$)/.test(Astro.url.pathname);
const isApplicationPath = /^\/(?:(?:en|fr|zh)\/)?shenzhen2026\/apply(?:\/|$)/.test(Astro.url.pathname);
const currentPath = Astro.url.pathname.replace(/^\/(en|fr|zh)/, "") || "/";
const applicationPaths: Record<Locale, string> = {
  en: "/en/shenzhen2026/apply/",
  fr: "/fr/shenzhen2026/apply/",
  zh: "/shenzhen2026/apply/",
};
const localePath = (locale: Locale) => isApplicationPath
  ? applicationPaths[locale]
  : getLocalizedPath(currentPath, locale);
const availableLocales = isShenzhenPath ? locales.filter((locale) => locale !== "fr") : locales;
---

<div class="lang-switcher">
  <button
    type="button"
    class="lang-current"
    aria-label={`Change language. Current language: ${localeNames[currentLocale]}`}
    aria-haspopup="true"
    aria-expanded="false"
    title={localeNames[currentLocale]}
  >
    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M2 12h20"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
  </button>
  <div class="lang-dropdown">
    {availableLocales.map((locale) => (
      <a
        href={localePath(locale)}
        class={`lang-option ${locale === currentLocale ? "active" : ""}`}
        data-locale={locale}
      >
        {localeNames[locale]}
      </a>
    ))}
  </div>
</div>

<script>
  const closeLanguageSwitchers = (except?: HTMLElement) => {
    document.querySelectorAll<HTMLElement>(".lang-switcher.is-open").forEach((switcher) => {
      if (switcher === except) return;
      switcher.classList.remove("is-open");
      switcher.querySelector<HTMLButtonElement>(".lang-current")?.setAttribute("aria-expanded", "false");
    });
  };

  document.querySelectorAll<HTMLElement>(".lang-switcher").forEach((switcher) => {
    const button = switcher.querySelector<HTMLButtonElement>(".lang-current");
    button?.addEventListener("click", () => {
      const willOpen = !switcher.classList.contains("is-open");
      closeLanguageSwitchers(switcher);
      switcher.classList.toggle("is-open", willOpen);
      button.setAttribute("aria-expanded", String(willOpen));
    });

    switcher.querySelectorAll<HTMLElement>(".lang-option").forEach((el) => {
      el.addEventListener("click", () => {
        const locale = el.dataset.locale;
        if (locale) document.cookie = `locale=${locale};path=/;max-age=${60 * 60 * 24 * 365}`;
      });
    });
  });

  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest(".lang-switcher")) closeLanguageSwitchers();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeLanguageSwitchers();
  });
</script>

<style>
  .lang-switcher {
    position: relative;
    display: flex;
    align-items: center;
  }
  .lang-current {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    color: #fff;
    transition: background-color 0.15s ease;
  }
  .lang-current:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  /* Light nav theme */
  :global([data-theme-nav="light"]) .lang-current {
    background: transparent;
    color: var(--color-dark, #1a1a2e);
  }
  :global([data-theme-nav="light"]) .lang-current:hover {
    background: rgba(4, 62, 93, 0.08);
  }
  /* When nav scrolls and gets light fill */
  :global(.nav-fill-active) .lang-current {
    background: transparent;
    color: var(--color-dark, #1a1a2e);
  }
  .lang-dropdown {
    display: none;
    position: absolute;
    top: calc(100% - 2px);
    right: 0;
    padding-top: 0.4rem;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15);
    overflow: hidden;
    z-index: 100;
    min-width: 90px;
  }
  .lang-switcher:hover .lang-dropdown,
  .lang-switcher:focus-within .lang-dropdown,
  .lang-switcher.is-open .lang-dropdown {
    display: block;
  }
  .lang-option {
    display: block;
    padding: 0.55rem 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #333;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .lang-option:hover {
    background-color: #f0f0f5;
  }
  .lang-option.active {
    color: #076597;
    font-weight: 700;
  }
</style>
