const c = content[locale] || content.en;
const programPath = locale === "en" ? "/shenzhen2026/" : `/${locale}/shenzhen2026/`;
const summaryFields = [
  { name: "applicant_name", label: c.applicantName },
  { name: "applicant_email", label: c.applicantEmail },
  { name: "contact_handle", label: c.contactHandle },
  { name: "country_region", label: c.countryRegion },
  { name: "team_size", label: c.teamSize },
  { name: "team_members_and_roles", label: c.teamMembers },
  { name: "project_name", label: c.projectName },
  { name: "product_form", label: c.productForm, type: "select" },
  { name: "one_liner", label: c.oneLiner },
  { name: "target_users", label: c.targetUsers },
  { name: "agent_core", label: c.agentCore },
  { name: "current_stage", label: c.currentStage, type: "select" },
  { name: "prototype_url", label: c.prototypeUrl, type: "url" },
  { name: "demo_video_url", label: c.demoVideoUrl, type: "url" },
  { name: "repository_url", label: c.repositoryUrl, type: "url" },
  { name: "technology_summary", label: c.technologySummary },
  { name: "shenzhen_attendance", label: c.attendance, type: "select" },
  { name: "open_source_status", label: c.openSourceStatus, type: "select" },
  { name: "sprint_goal", label: c.sprintGoal },
  { name: "support_needs", label: c.supportNeeds, type: "checkboxes" },
  { name: "consents", label: c.summaryConsent, type: "consent" },
];
---

<Layout
  title={c.metaTitle}
  description={c.metaDesc}
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Spotlight Shenzhen 2026 Application"
  socialImage="/images/shenzhen2026/og-shenzhen-film.png"
  locale={locale}
  nativeScroll={true}
  footerVariant="spotlight"
>
  <div class="application-page monolith-application">
    <section class="application-hero" data-theme-section="light" aria-labelledby="application-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="application-container hero-content">
        <div class="hero-topline">
          <a class="back-link" href={programPath} aria-label={c.back}><span class="shape-icon shape-icon--arrow shape-icon--left" aria-hidden="true"></span>{c.back}</a>
        </div>
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="eyebrow">{c.eyebrow}</p>
            <h1 id="application-title">{c.title.split("\n").map((line) => <>{line}<br /></>)}</h1>
            <p class="hero-intro">{c.intro}</p>
          </div>
          <aside class="hero-status" aria-label={c.open}>
            <span class="status-index">01 / APPLICATION</span>
            <strong><span></span>{c.open}</strong>
            <ShenzhenDeadlines locale={locale} />
            <small>{c.time}</small>
          </aside>
        </div>
      </div>
    </section>

    <main class="application-container application-layout">
      <aside class="application-guide">
        <div class="guide-card">
          <p class="guide-title">{c.prepare}</p>
          <ul>{c.prepareItems.map((item) => <li>{item}</li>)}</ul>
          <p class="file-note">{c.fileNote}</p>
          <small>{c.required}</small>
        </div>
        <aside class="wechat-group-card" aria-labelledby="wechat-group-title">
          <p class="wechat-group-title" id="wechat-group-title">{c.wechatGroupTitle}</p>
          <a
            href="/images/shenzhen2026/spotlight-qa-wechat-group.png"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src="/images/shenzhen2026/spotlight-qa-wechat-group.png"
              alt={c.wechatGroupAlt}
              loading="lazy"
            />
            <span>{c.wechatGroupLink}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span></span>
          </a>
        </aside>
        <nav aria-label="Application sections">
          <ol>{c.sections.map((section, index) => <li data-registration-gated={index > 0 ? "true" : undefined} hidden={index > 0}><a href={`#section-${index + 1}`}><span>{String(index + 1).padStart(2, "0")}</span>{section}</a></li>)}</ol>
        </nav>
      </aside>

      <section class="form-column">
        <form
          id="application-form"
          novalidate
          data-language={locale}
          data-project-url="https://rotznvannxypesxaeyda.supabase.co"
          data-api-key="sb_publishable_CpwHPombYza4gK9F6f_WwQ_gwfDsXPz"
          data-error-message={c.error}
          data-too-fast-message={c.tooFast}
          data-submitting-label={c.submitting}
          data-registering-label={c.registering}
          data-logging-in-label={c.loggingIn}
          data-registration-action={c.registrationAction}
          data-login-action={c.loginAction}
          data-registration-error-message={c.registrationError}
          data-registration-invalid-email-message={c.registrationInvalidEmail}
          data-registration-rate-limit-message={c.registrationRateLimit}
          data-registration-existing-account-message={c.registrationExistingAccount}
          data-login-error-message={c.loginError}
          data-reset-error-message={c.resetError}
          data-reset-sent-message={c.resetSent}
          data-password-updated-message={c.passwordUpdated}
          data-draft-saving-message={c.draftSaving}
          data-draft-saved-message={c.draftSaved}
          data-draft-restored-message={c.draftRestored}
          data-submitted-already-message={c.submittedAlready}
          data-update-submit-label={c.updateSubmit}
          data-updating-label={c.updating}
        >
          <div class="honeypot" aria-hidden="true">
            <label for="company_website">Company website</label>
            <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <fieldset class="form-section" id="section-1">
            <legend><span>01</span>{c.registrationTitle}</legend>
            <p class="section-intro">{c.registrationIntro}</p>
            <div class="auth-mode-tabs" id="auth-mode-tabs" role="tablist" aria-label={c.registrationTitle}>
              <button type="button" id="register-tab" role="tab" aria-selected="true">{c.createAccountTab}</button>
              <button type="button" id="login-tab" role="tab" aria-selected="false">{c.loginTab}</button>
            </div>
            <div class="field-grid auth-fields" id="auth-fields">
              <label class="registration-only">{c.applicantName} *<input name="applicant_name" type="text" minlength="2" maxlength="120" autocomplete="name" required /></label>
              <label>{c.applicantEmail} *<input name="applicant_email" type="email" maxlength="320" autocomplete="email" required /></label>
              <label>{c.password} *<input name="account_password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required /><small>{c.passwordHelp}</small></label>
              <label class="registration-only">{c.contactHandle}<input name="contact_handle" type="text" maxlength="200" autocomplete="tel" /></label>
              <label class="registration-only">{c.countryRegion} *<input name="country_region" type="text" minlength="2" maxlength="120" required /></label>
            </div>
            <label class="consent registration-consent registration-only"><input name="registration_privacy_consent" type="checkbox" required /><span>{c.registrationConsent} <a href="/privacy/" target="_blank" rel="noopener noreferrer">Privacy Policy <span class="shape-icon shape-icon--arrow shape-icon--up-right consent-link-icon" aria-hidden="true"></span></a></span></label>
            <div class="registration-action" id="registration-action">
              <button type="button" id="registration-button"><span>{c.registrationAction}</span><span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span></button>
              <button type="button" class="text-button" id="forgot-password-button" hidden>{c.forgotPassword}</button>
              <p class="registration-message form-message" role="alert" aria-live="polite"></p>
            </div>
            <div class="account-confirmation" id="account-confirmation" role="status" aria-live="polite" hidden>
              <strong>{c.accountCreatedTitle}</strong>
              <p>{c.accountCreatedText}</p>
            </div>
            <div class="password-recovery" id="password-recovery" hidden>
              <label>{c.newPassword} *<input name="new_password" type="password" minlength="8" maxlength="72" autocomplete="new-password" /></label>
              <button type="button" id="update-password-button">{c.updatePassword}</button>
              <p class="form-message" role="alert" aria-live="polite"></p>
            </div>
            <div class="registration-complete" id="registration-complete" role="status" aria-live="polite" hidden>
              <strong>{c.registrationCompleteTitle}</strong>
              <p>{c.registrationCompleteText}</p>
              <div class="account-session"><span>{c.signedInAs}: <b id="account-email"></b></span><button type="button" id="sign-out-button">{c.signOut}</button></div>
            </div>
          </fieldset>

          <div class="application-questionnaire" id="application-questionnaire" hidden>
          <div class="draft-status" id="draft-status" role="status" aria-live="polite"></div>
          <fieldset class="form-section" id="section-2">
            <legend><span>02</span>{c.contactTitle}</legend>
            <p class="section-intro">{c.contactIntro}</p>
            <label class="team-size-field">{c.teamSize} *<input name="team_size" type="number" min="1" max="100" inputmode="numeric" required /></label>
            <label>{c.teamMembers} *<textarea name="team_members_and_roles" minlength="5" maxlength="2000" rows="4" required></textarea><small>{c.teamMembersHelp}</small></label>
          </fieldset>

          <fieldset class="form-section" id="section-3">
            <legend><span>03</span>{c.productTitle}</legend>
            <p class="section-intro">{c.productIntro}</p>
            <div class="field-grid">
              <label>{c.projectName} *<input name="project_name" type="text" minlength="2" maxlength="160" required /></label>
              <label>{c.productForm} *<select name="product_form" required>{c.productFormOptions.map((option) => <option value={option[0]} disabled={option[0] === ""} selected={option[0] === ""}>{option[1]}</option>)}</select></label>
            </div>
            <label class="field-full">{c.oneLiner} *<textarea name="one_liner" minlength="10" maxlength="240" rows="2" required></textarea><small>{c.oneLinerHelp}</small></label>
            <label class="field-full">{c.targetUsers} *<textarea name="target_users" minlength="30" maxlength="2500" rows="5" required></textarea></label>
            <label class="field-full">{c.agentCore} *<textarea name="agent_core" minlength="30" maxlength="3000" rows="5" required></textarea><small>{c.agentHelp}</small></label>
          </fieldset>

          <fieldset class="form-section" id="section-4">
            <legend><span>04</span>{c.proofTitle}</legend>
            <p class="section-intro">{c.proofIntro}</p>
            <div class="field-grid">
              <label>{c.currentStage} *<select name="current_stage" required>{c.currentStageOptions.map((option) => <option value={option[0]} disabled={option[0] === ""} selected={option[0] === ""}>{option[1]}</option>)}</select></label>
              <label>{c.prototypeUrl} *<input name="prototype_url" type="url" maxlength="500" inputmode="url" placeholder="https://" required /><small>{c.prototypeHelp}</small></label>
              <label>{c.demoVideoUrl} *<input name="demo_video_url" type="url" maxlength="500" inputmode="url" placeholder="https://" required /><small>{c.demoVideoHelp}</small></label>
              <label>{c.repositoryUrl}<input name="repository_url" type="url" maxlength="500" inputmode="url" placeholder="https://" /></label>
            </div>
            <label class="field-full">{c.technologySummary} *<textarea name="technology_summary" minlength="20" maxlength="3000" rows="6" required></textarea><small>{c.technologyHelp}</small></label>
          </fieldset>

          <fieldset class="form-section" id="section-5">
            <legend><span>05</span>{c.shenzhenTitle}</legend>
            <p class="section-intro">{c.shenzhenIntro}</p>
            <div class="field-grid">
              <label>{c.attendance} *<select name="shenzhen_attendance" required>{c.attendanceOptions.map((option) => <option value={option[0]} disabled={option[0] === ""} selected={option[0] === ""}>{option[1]}</option>)}</select></label>
              <label>{c.openSourceStatus} *<select name="open_source_status" required>{c.openSourceOptions.map((option) => <option value={option[0]} disabled={option[0] === ""} selected={option[0] === ""}>{option[1]}</option>)}</select></label>
            </div>
            <label class="field-full">{c.sprintGoal} *<textarea name="sprint_goal" minlength="20" maxlength="2500" rows="5" required></textarea></label>
            <div class="field-full checkbox-group">
              <span class="checkbox-title">{c.supportNeeds}</span>
              <div class="checkbox-grid">{c.supportOptions.map((option) => <label><input type="checkbox" name="support_needs" value={option[0]} /><span>{option[1]}</span></label>)}</div>
            </div>
          </fieldset>

          <fieldset class="form-section confirm-section" id="section-6">
            <legend><span>06</span>{c.confirmTitle}</legend>
            <p class="section-intro">{c.confirmIntro}</p>
            <label class="consent"><input name="privacy_consent" type="checkbox" required /><span>{c.privacyConsent} <a href="/privacy/" target="_blank" rel="noopener noreferrer">Privacy Policy <span class="shape-icon shape-icon--arrow shape-icon--up-right consent-link-icon" aria-hidden="true"></span></a></span></label>
            <label class="consent"><input name="code_of_conduct_consent" type="checkbox" required /><span>{c.codeConsent} <a href="/code-of-conduct/" target="_blank" rel="noopener noreferrer">Code of Conduct <span class="shape-icon shape-icon--arrow shape-icon--up-right consent-link-icon" aria-hidden="true"></span></a></span></label>
            <label class="consent"><input name="submission_declaration" type="checkbox" required /><span>{c.declaration}</span></label>
            <div class="submit-area">
              <button type="submit"><span>{c.submit}</span><span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span></button>
              <small>{c.submitNote}</small>
              <p class="form-message" role="alert" aria-live="polite"></p>
            </div>
          </fieldset>
          </div>
        </form>

        <section
          class="success-panel"
          id="success-panel"
          data-summary-fields={JSON.stringify(summaryFields)}
          data-summary-empty={c.summaryEmpty}
          data-summary-confirmed={c.summaryConfirmed}
          data-success-eyebrow={c.successEyebrow}
          data-success-title={c.successTitle}
          data-success-text={c.successText}
          data-update-success-eyebrow={c.updateSuccessEyebrow}
          data-update-success-title={c.updateSuccessTitle}
          data-update-success-text={c.updateSuccessText}
          data-sample-preview={c.samplePreview}
          aria-live="polite"
          hidden
        >
          <p class="sample-preview-label" id="sample-preview-label" hidden>{c.samplePreview}</p>
          <div class="success-overview">
            <div class="success-copy">
              <p class="eyebrow" id="success-eyebrow">{c.successEyebrow}</p>
              <h2 id="success-title">{c.successTitle}</h2>
              <p id="success-text">{c.successText}</p>
            </div>
            <div class="success-controls">
              <div class="success-account">
                <span>{c.signedInAs}: <b id="success-account-email"></b></span>
                <button type="button" id="success-sign-out-button">{c.signOut}</button>
              </div>
              <div class="reference-card"><span>{c.reference}</span><strong id="submission-reference"></strong></div>
              <div class="submission-actions" id="submission-actions">
                <button type="button" id="edit-submission-button"><span>{c.editSubmission}</span><span class="shape-icon shape-icon--arrow" aria-hidden="true"></span></button>
                <button type="button" id="restart-submission-button">{c.startNewVersion}</button>
                <p>{c.replaceNote}</p>
              </div>
            </div>
          </div>
          <section class="submission-summary" aria-labelledby="submission-summary-title">
            <h3 id="submission-summary-title">{c.summaryTitle}</h3>
            <p>{c.summaryIntro}</p>
            <dl id="submission-summary"></dl>
          </section>
          <a href={programPath}><span>{c.returnProgram}</span><span class="shape-icon shape-icon--arrow" aria-hidden="true"></span></a>
        </section>
      </section>
    </main>
  </div>
</Layout>

<script>
  import { createClient, type User } from "@supabase/supabase-js";

  const form = document.querySelector<HTMLFormElement>("#application-form");
  const successPanel = document.querySelector<HTMLElement>("#success-panel");
  const referenceOutput = document.querySelector<HTMLElement>("#submission-reference");
  const summaryOutput = document.querySelector<HTMLDListElement>("#submission-summary");
  const successEyebrow = document.querySelector<HTMLElement>("#success-eyebrow");
  const successTitle = document.querySelector<HTMLElement>("#success-title");
  const successText = document.querySelector<HTMLElement>("#success-text");
  const successAccountEmail = document.querySelector<HTMLElement>("#success-account-email");
  const successSignOutButton = document.querySelector<HTMLButtonElement>("#success-sign-out-button");
  const samplePreviewLabel = document.querySelector<HTMLElement>("#sample-preview-label");
  const editSubmissionButton = document.querySelector<HTMLButtonElement>("#edit-submission-button");
  const restartSubmissionButton = document.querySelector<HTMLButtonElement>("#restart-submission-button");
  const submissionActions = document.querySelector<HTMLElement>("#submission-actions");
  const questionnaire = document.querySelector<HTMLElement>("#application-questionnaire");
  const registrationButton = document.querySelector<HTMLButtonElement>("#registration-button");
  const registrationComplete = document.querySelector<HTMLElement>("#registration-complete");
  const registrationAction = document.querySelector<HTMLElement>("#registration-action");
  const registrationMessage = document.querySelector<HTMLElement>(".registration-message");
  const accountConfirmation = document.querySelector<HTMLElement>("#account-confirmation");
  const accountEmail = document.querySelector<HTMLElement>("#account-email");
  const authModeTabs = document.querySelector<HTMLElement>("#auth-mode-tabs");
  const authFields = document.querySelector<HTMLElement>("#auth-fields");
  const registerTab = document.querySelector<HTMLButtonElement>("#register-tab");
  const loginTab = document.querySelector<HTMLButtonElement>("#login-tab");
  const forgotPasswordButton = document.querySelector<HTMLButtonElement>("#forgot-password-button");
  const passwordRecovery = document.querySelector<HTMLElement>("#password-recovery");
  const updatePasswordButton = document.querySelector<HTMLButtonElement>("#update-password-button");
  const signOutButton = document.querySelector<HTMLButtonElement>("#sign-out-button");
  const draftStatus = document.querySelector<HTMLElement>("#draft-status");
  const gatedNavigationItems = Array.from(document.querySelectorAll<HTMLElement>("[data-registration-gated]"));
  const registrationOnlyItems = Array.from(document.querySelectorAll<HTMLElement>(".registration-only"));
  const startedAt = Date.now();

  const projectUrl = form?.dataset.projectUrl || "";
  const apiKey = form?.dataset.apiKey || "";
  const isSamplePreview = new URLSearchParams(window.location.search).get("preview") === "submitted";
  const supabase = createClient(projectUrl, apiKey, {
    auth: {
      persistSession: true,
      autoRefreshToken: true,
      detectSessionInUrl: true,
    },
  });

  type AuthMode = "register" | "login";
  type RegistrationState = {
    userId: string;
    publicReference: string;
    applicantName: string;
    applicantEmail: string;
    contactHandle: string;
    countryRegion: string;
    registeredAt: string;
    submittedAt: string | null;
  };
  type DraftData = Record<string, string | boolean | string[]>;
  type ApplicationData = Record<string, string | number | boolean | string[] | null>;
  type SummaryField = {
    name: string;
    label: string;
    type?: "url" | "select" | "checkboxes" | "consent";
  };

  let authMode: AuthMode = "register";
  let registrationState: RegistrationState | null = null;
  let currentUser: User | null = null;
  let activeUserId = "";
  let draftSaveTimer: number | undefined;
  let draftSaveInFlight = false;
  let existingApplication: ApplicationData | null = null;
  let isEditingSubmission = false;

  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".application-guide nav a"));
  const formSections = Array.from(document.querySelectorAll<HTMLElement>(".form-section[id]"));
  const setActiveSection = (id: string) => {
    sectionLinks.forEach((link) => {
      const isActive = link.hash === `#${id}`;
      link.classList.toggle("is-active", isActive);
      if (isActive) link.setAttribute("aria-current", "step");
      else link.removeAttribute("aria-current");
    });
  };

  if (formSections.length && sectionLinks.length) {
    setActiveSection(formSections[0].id);
    const sectionObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) setActiveSection((visible[0].target as HTMLElement).id);
    }, { rootMargin: "-110px 0px -64% 0px", threshold: 0 });
    formSections.forEach((section) => sectionObserver.observe(section));
  }

  const getInput = (name: string) => form?.elements.namedItem(name) as HTMLInputElement | null;
  const registrationFieldNames = ["applicant_name", "applicant_email", "account_password", "contact_handle", "country_region", "registration_privacy_consent"];
  const loginFieldNames = ["applicant_email", "account_password"];
  const draftFieldNames = [
    "team_size", "team_members_and_roles", "project_name", "product_form", "one_liner",
    "target_users", "agent_core", "current_stage", "prototype_url", "demo_video_url",
    "repository_url", "technology_summary", "open_source_status", "shenzhen_attendance",
    "sprint_goal", "privacy_consent", "code_of_conduct_consent", "submission_declaration",
  ];
  const meaningfulDraftFields = draftFieldNames.filter((name) => !name.endsWith("_consent") && name !== "submission_declaration");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = submitButton?.querySelector<HTMLElement>("span");
  const initialSubmitLabel = submitLabel?.textContent || "Submit application";

  const setSubmitMode = (editing: boolean) => {
    isEditingSubmission = editing;
    if (submitButton) submitButton.disabled = false;
    if (submitLabel) submitLabel.textContent = editing
      ? form?.dataset.updateSubmitLabel || "Save & replace application"
      : initialSubmitLabel;
  };

  const setSuccessCopy = (updated: boolean) => {
    if (!successPanel) return;
    if (successEyebrow) successEyebrow.textContent = updated
      ? successPanel.dataset.updateSuccessEyebrow || "Application updated"
      : successPanel.dataset.successEyebrow || "Application received";
    if (successTitle) successTitle.textContent = updated
      ? successPanel.dataset.updateSuccessTitle || "Your changes have been saved."
      : successPanel.dataset.successTitle || "Thank you. Your project is in review.";
    if (successText) successText.textContent = updated
      ? successPanel.dataset.updateSuccessText || "Your updated application has replaced the previous version."
      : successPanel.dataset.successText || "We will contact you if the selection team needs anything else.";
  };

  const setAuthMode = (mode: AuthMode) => {
    authMode = mode;
    const isRegister = mode === "register";
    registrationOnlyItems.forEach((item) => {
      item.hidden = !isRegister;
      item.querySelectorAll<HTMLInputElement>("input").forEach((input) => { input.disabled = !isRegister; });
    });
    registerTab?.setAttribute("aria-selected", String(isRegister));
    loginTab?.setAttribute("aria-selected", String(!isRegister));
    const password = getInput("account_password");
    if (password) password.autocomplete = isRegister ? "new-password" : "current-password";
    const label = registrationButton?.querySelector<HTMLElement>("span");
    if (label) label.textContent = isRegister
      ? form?.dataset.registrationAction || "Create account"
      : form?.dataset.loginAction || "Sign in";
    if (forgotPasswordButton) forgotPasswordButton.hidden = isRegister;
    if (registrationMessage) registrationMessage.textContent = "";
    if (accountConfirmation) accountConfirmation.hidden = true;
  };

  const validateAuth = () => {
    const names = authMode === "register" ? registrationFieldNames : loginFieldNames;
    for (const name of names) {
      const control = getInput(name);
      if (control && !control.checkValidity()) {
        control.reportValidity();
        return false;
      }
    }
    return true;
  };

  const setAuthBusy = (busy: boolean) => {
    if (registrationButton) registrationButton.disabled = busy;
    const label = registrationButton?.querySelector<HTMLElement>("span");
    if (label) {
      label.textContent = busy
        ? authMode === "register"
          ? form?.dataset.registeringLabel || "Creating account…"
          : form?.dataset.loggingInLabel || "Signing in…"
        : authMode === "register"
          ? form?.dataset.registrationAction || "Create account"
          : form?.dataset.loginAction || "Sign in";
    }
  };

  const authRedirectUrl = (recovery = false) => {
    const url = new URL(window.location.href);
    url.hash = "";
    url.search = recovery ? "?password-recovery=1" : "";
    return url.toString();
  };

  const showSignedOut = () => {
    currentUser = null;
    activeUserId = "";
    registrationState = null;
    existingApplication = null;
    setSubmitMode(false);
    summaryOutput?.replaceChildren();
    if (referenceOutput) referenceOutput.textContent = "";
    authModeTabs?.removeAttribute("hidden");
    authFields?.removeAttribute("hidden");
    registrationAction?.removeAttribute("hidden");
    if (registrationComplete) registrationComplete.hidden = true;
    if (accountConfirmation) accountConfirmation.hidden = true;
    if (passwordRecovery) passwordRecovery.hidden = true;
    if (questionnaire) questionnaire.hidden = true;
    if (successPanel) successPanel.hidden = true;
    if (form) form.hidden = false;
    if (samplePreviewLabel) samplePreviewLabel.hidden = true;
    gatedNavigationItems.forEach((item) => { item.hidden = true; });
    registrationFieldNames.forEach((name) => {
      const input = getInput(name);
      if (input) {
        input.readOnly = false;
        input.disabled = false;
      }
    });
    setAuthMode("login");
  };

  const displaySubmitted = (reference: string, shouldScroll = false, updated = false) => {
    if (questionnaire) questionnaire.hidden = true;
    if (form) form.hidden = true;
    setSubmitMode(false);
    setSuccessCopy(updated);
    if (submissionActions) submissionActions.hidden = !existingApplication;
    if (referenceOutput) referenceOutput.textContent = reference;
    if (successAccountEmail) successAccountEmail.textContent = registrationState?.applicantEmail || "";
    if (samplePreviewLabel) samplePreviewLabel.hidden = !isSamplePreview;
    const summary = successPanel?.querySelector<HTMLElement>(".submission-summary");
    if (summary && !summaryOutput?.children.length) summary.hidden = true;
    if (successPanel) {
      successPanel.hidden = false;
      if (shouldScroll) successPanel.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  };

  const showQuestionnaire = (state: RegistrationState, shouldScroll = false) => {
    registrationState = state;
    if (form) form.hidden = false;
    const values: Record<string, string> = {
      applicant_name: state.applicantName,
      applicant_email: state.applicantEmail,
      contact_handle: state.contactHandle,
      country_region: state.countryRegion,
    };
    Object.entries(values).forEach(([name, value]) => {
      const input = getInput(name);
      if (input) {
        input.value = value;
        input.readOnly = true;
        input.disabled = true;
      }
    });
    const password = getInput("account_password");
    if (password) {
      password.value = "";
      password.disabled = true;
    }
    const consent = getInput("registration_privacy_consent");
    if (consent) {
      consent.checked = true;
      consent.disabled = true;
    }
    if (authModeTabs) authModeTabs.hidden = true;
    if (authFields) authFields.hidden = true;
    if (registrationAction) registrationAction.hidden = true;
    if (accountConfirmation) accountConfirmation.hidden = true;
    if (passwordRecovery) passwordRecovery.hidden = true;
    if (registrationComplete) registrationComplete.hidden = false;
    if (accountEmail) accountEmail.textContent = state.applicantEmail;
    gatedNavigationItems.forEach((item) => { item.hidden = Boolean(state.submittedAt); });
    if (state.submittedAt) {
      displaySubmitted(state.publicReference);
      return;
    }
    if (successPanel) successPanel.hidden = true;
    if (questionnaire) {
      questionnaire.hidden = false;
      if (shouldScroll) document.querySelector("#section-2")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  };

  const collectDraft = (): DraftData => {
    const draft: DraftData = {};
    draftFieldNames.forEach((name) => {
      const control = form?.elements.namedItem(name);
      if (control instanceof RadioNodeList) return;
      if (control instanceof HTMLInputElement && control.type === "checkbox") draft[name] = control.checked;
      else if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) draft[name] = control.value;
    });
    draft.support_needs = Array.from(form?.querySelectorAll<HTMLInputElement>('input[name="support_needs"]:checked') || []).map((input) => input.value);
    return draft;
  };

  const applyDraft = (draft: ApplicationData) => {
    Object.entries(draft).forEach(([name, value]) => {
      if (name === "support_needs" && Array.isArray(value)) {
        form?.querySelectorAll<HTMLInputElement>('input[name="support_needs"]').forEach((input) => { input.checked = value.includes(input.value); });
        return;
      }
      const control = form?.elements.namedItem(name);
      if (control instanceof HTMLInputElement && control.type === "checkbox") control.checked = Boolean(value);
      else if (
        (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement)
        && (typeof value === "string" || typeof value === "number")
      ) control.value = String(value);
    });
  };

  const applyApplication = (application: ApplicationData) => {
    applyDraft(application);
  };

  const clearQuestionnaire = () => {
    draftFieldNames.forEach((name) => {
      const control = form?.elements.namedItem(name);
      if (control instanceof HTMLInputElement && control.type === "checkbox") control.checked = false;
      else if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) control.value = "";
    });
    form?.querySelectorAll<HTMLInputElement>('input[name="support_needs"]').forEach((input) => { input.checked = false; });
    if (draftStatus) draftStatus.textContent = "";
  };

  const hasMeaningfulDraft = (draft: DraftData) => meaningfulDraftFields.some((name) => {
    const value = draft[name];
    return Array.isArray(value) ? value.length > 0 : typeof value === "string" && value.trim().length > 0;
  }) || (Array.isArray(draft.support_needs) && draft.support_needs.length > 0);

  const saveDraft = async () => {
    if (isSamplePreview || !currentUser || !registrationState || (registrationState.submittedAt && !isEditingSubmission) || draftSaveInFlight) return;
    const draft = collectDraft();
    if (!hasMeaningfulDraft(draft)) return;
    draftSaveInFlight = true;
    if (draftStatus) draftStatus.textContent = form?.dataset.draftSavingMessage || "Saving draft…";
    const { error } = await supabase.from("spotlight_shenzhen_2026_drafts").upsert({
      user_id: currentUser.id,
      draft_data: draft,
      updated_at: new Date().toISOString(),
    });
    draftSaveInFlight = false;
    if (error) {
      console.error(error);
      if (draftStatus) draftStatus.textContent = "";
      return;
    }
    if (draftStatus) draftStatus.textContent = form?.dataset.draftSavedMessage || "Draft saved";
  };

  const scheduleDraftSave = () => {
    if (draftSaveTimer) window.clearTimeout(draftSaveTimer);
    draftSaveTimer = window.setTimeout(saveDraft, 700);
  };

  questionnaire?.addEventListener("input", scheduleDraftSave);
  questionnaire?.addEventListener("change", scheduleDraftSave);

  const loadDraft = async (userId: string) => {
    const { data, error } = await supabase
      .from("spotlight_shenzhen_2026_drafts")
      .select("draft_data")
      .eq("user_id", userId)
      .maybeSingle();
    if (error) {
      console.error(error);
      return;
    }
    if (data?.draft_data && typeof data.draft_data === "object") {
      applyDraft(data.draft_data as DraftData);
      if (draftStatus) draftStatus.textContent = form?.dataset.draftRestoredMessage || "Saved draft restored";
    }
  };

  const loadSubmittedApplication = async (userId: string) => {
    const { data, error } = await supabase
      .from("spotlight_shenzhen_2026_applications")
      .select("id, user_id, public_reference, created_at, updated_at, application_language, applicant_name, applicant_email, contact_handle, country_region, team_size, team_members_and_roles, project_name, product_form, one_liner, target_users, problem_statement, category_thesis, agent_core, current_stage, prototype_url, demo_video_url, repository_url, technology_summary, open_source_status, shenzhen_attendance, sprint_goal, support_needs, privacy_consent, code_of_conduct_consent, submission_declaration, source_path")
      .eq("user_id", userId)
      .maybeSingle();
    if (error) {
      console.error(error);
      return;
    }
    if (!data) return;
    existingApplication = data as ApplicationData;
    applyApplication(existingApplication);
    renderSubmissionSummary(existingApplication);
  };

  const loadAccount = async (user: User, shouldScroll = false) => {
    if (activeUserId === user.id && registrationState) return;
    currentUser = user;
    existingApplication = null;
    summaryOutput?.replaceChildren();
    const { data, error } = await supabase
      .from("spotlight_shenzhen_2026_accounts")
      .select("user_id, public_reference, created_at, submitted_at, applicant_name, applicant_email, contact_handle, country_region")
      .eq("user_id", user.id)
      .maybeSingle();
    if (error || !data) {
      console.error(error || new Error("No Spotlight Shenzhen account was found."));
      if (registrationMessage) registrationMessage.textContent = form?.dataset.loginErrorMessage || "This account is not registered for this program.";
      return;
    }
    activeUserId = user.id;
    const state: RegistrationState = {
      userId: data.user_id,
      publicReference: data.public_reference,
      applicantName: data.applicant_name,
      applicantEmail: data.applicant_email,
      contactHandle: data.contact_handle || "",
      countryRegion: data.country_region,
      registeredAt: data.created_at,
      submittedAt: data.submitted_at,
    };
    if (state.submittedAt) await loadSubmittedApplication(user.id);
    showQuestionnaire(state, shouldScroll);
    await loadDraft(user.id);
  };

  const registerAccount = async () => {
    if (!form || !validateAuth()) return;
    const values = new FormData(form);
    if (String(values.get("company_website") || "").trim()) return;
    setAuthBusy(true);
    if (registrationMessage) registrationMessage.textContent = "";
    const email = String(values.get("applicant_email") || "").trim().toLowerCase();
    const password = String(values.get("account_password") || "");
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        emailRedirectTo: authRedirectUrl(),
        data: {
          spotlight_program: "shenzhen2026",
          application_language: form.dataset.language || "en",
          applicant_name: String(values.get("applicant_name") || "").trim(),
          contact_handle: String(values.get("contact_handle") || "").trim(),
          country_region: String(values.get("country_region") || "").trim(),
          privacy_consent: values.get("registration_privacy_consent") === "on",
          source_path: window.location.pathname,
        },
      },
    });
    setAuthBusy(false);
    if (error) {
      console.error(error);
      if (registrationMessage) {
        if (error.code === "email_address_invalid") {
          registrationMessage.textContent = form.dataset.registrationInvalidEmailMessage || form.dataset.registrationErrorMessage || "Account creation failed.";
        } else if (error.code === "over_email_send_rate_limit" || error.status === 429) {
          registrationMessage.textContent = form.dataset.registrationRateLimitMessage || form.dataset.registrationErrorMessage || "Account creation failed.";
        } else if (error.code === "user_already_exists" || error.code === "email_exists") {
          registrationMessage.textContent = form.dataset.registrationExistingAccountMessage || form.dataset.registrationErrorMessage || "Account creation failed.";
        } else {
          registrationMessage.textContent = form.dataset.registrationErrorMessage || "Account creation failed.";
        }
      }
      return;
    }
    getInput("account_password")!.value = "";
    if (data.session && data.user) {
      await loadAccount(data.user, true);
      return;
    }
    if (accountConfirmation) accountConfirmation.hidden = false;
  };

  const signIn = async () => {
    if (!form || !validateAuth()) return;
    const values = new FormData(form);
    setAuthBusy(true);
    if (registrationMessage) registrationMessage.textContent = "";
    const { data, error } = await supabase.auth.signInWithPassword({
      email: String(values.get("applicant_email") || "").trim().toLowerCase(),
      password: String(values.get("account_password") || ""),
    });
    setAuthBusy(false);
    if (error || !data.user) {
      console.error(error);
      if (registrationMessage) registrationMessage.textContent = form.dataset.loginErrorMessage || "Sign in failed.";
      return;
    }
    getInput("account_password")!.value = "";
    await loadAccount(data.user, true);
  };

  registrationButton?.addEventListener("click", () => {
    if (authMode === "register") void registerAccount();
    else void signIn();
  });
  registerTab?.addEventListener("click", () => setAuthMode("register"));
  loginTab?.addEventListener("click", () => setAuthMode("login"));

  forgotPasswordButton?.addEventListener("click", async () => {
    const email = getInput("applicant_email");
    if (!email || !email.checkValidity()) {
      email?.reportValidity();
      return;
    }
    if (registrationMessage) registrationMessage.textContent = "";
    const { error } = await supabase.auth.resetPasswordForEmail(email.value.trim().toLowerCase(), {
      redirectTo: authRedirectUrl(true),
    });
    if (error) {
      console.error(error);
      if (registrationMessage) registrationMessage.textContent = form?.dataset.resetErrorMessage || "Could not send reset email.";
      return;
    }
    if (registrationMessage) registrationMessage.textContent = form?.dataset.resetSentMessage || "Password reset email sent.";
  });

  const showPasswordRecovery = () => {
    if (authModeTabs) authModeTabs.hidden = true;
    if (authFields) authFields.hidden = true;
    if (registrationAction) registrationAction.hidden = true;
    if (registrationComplete) registrationComplete.hidden = true;
    if (passwordRecovery) passwordRecovery.hidden = false;
  };

  updatePasswordButton?.addEventListener("click", async () => {
    const newPassword = getInput("new_password");
    const message = passwordRecovery?.querySelector<HTMLElement>(".form-message");
    if (!newPassword || !newPassword.checkValidity()) {
      newPassword?.reportValidity();
      return;
    }
    updatePasswordButton.disabled = true;
    const { data, error } = await supabase.auth.updateUser({ password: newPassword.value });
    updatePasswordButton.disabled = false;
    if (error || !data.user) {
      console.error(error);
      if (message) message.textContent = form?.dataset.loginErrorMessage || "Could not update password.";
      return;
    }
    newPassword.value = "";
    if (message) message.textContent = form?.dataset.passwordUpdatedMessage || "Password updated.";
    await loadAccount(data.user, true);
  });

  const signOut = async () => {
    if (isSamplePreview) {
      const url = new URL(window.location.href);
      url.searchParams.delete("preview");
      window.location.assign(`${url.pathname}${url.search}${url.hash}`);
      return;
    }
    await supabase.auth.signOut();
    form?.reset();
    showSignedOut();
  };
  signOutButton?.addEventListener("click", () => { void signOut(); });
  successSignOutButton?.addEventListener("click", () => { void signOut(); });

  const renderSubmissionSummary = (payload: Record<string, string | number | boolean | string[] | null>) => {
    if (!successPanel || !summaryOutput) return;
    const fields = JSON.parse(successPanel.dataset.summaryFields || "[]") as SummaryField[];
    const emptyLabel = successPanel.dataset.summaryEmpty || "—";
    const confirmedLabel = successPanel.dataset.summaryConfirmed || "Confirmed";
    const fragment = document.createDocumentFragment();
    fields.forEach((field) => {
      const row = document.createElement("div");
      const term = document.createElement("dt");
      const detail = document.createElement("dd");
      term.textContent = field.label;
      let displayValue: string | number | null = payload[field.name] as string | number | null;
      if (field.type === "select") {
        const select = form?.querySelector<HTMLSelectElement>(`select[name="${field.name}"]`);
        displayValue = select?.selectedOptions[0]?.textContent?.trim() || emptyLabel;
      } else if (field.type === "checkboxes") {
        const selected = Array.from(form?.querySelectorAll<HTMLInputElement>(`input[name="${field.name}"]:checked`) || [])
          .map((input) => input.closest("label")?.textContent?.trim())
          .filter(Boolean);
        displayValue = selected.length ? selected.join("、") : emptyLabel;
      } else if (field.type === "consent") {
        displayValue = confirmedLabel;
      }
      if (field.type === "url" && typeof displayValue === "string" && displayValue) {
        const link = document.createElement("a");
        link.href = displayValue;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = displayValue;
        detail.append(link);
      } else {
        detail.textContent = displayValue === null || displayValue === "" ? emptyLabel : String(displayValue);
      }
      row.append(term, detail);
      fragment.append(row);
    });
    summaryOutput.replaceChildren(fragment);
    const summary = successPanel.querySelector<HTMLElement>(".submission-summary");
    if (summary) summary.hidden = false;
  };

  const beginSubmissionEdit = async (restart = false) => {
    if (!registrationState?.submittedAt || (!isSamplePreview && !currentUser) || !existingApplication) return;
    if (restart) {
      clearQuestionnaire();
      if (!isSamplePreview && currentUser) {
        const { error } = await supabase
          .from("spotlight_shenzhen_2026_drafts")
          .delete()
          .eq("user_id", currentUser.id);
        if (error) console.error(error);
      }
    }
    setSubmitMode(true);
    if (form) form.hidden = false;
    if (successPanel) successPanel.hidden = true;
    if (questionnaire) questionnaire.hidden = false;
    gatedNavigationItems.forEach((item) => { item.hidden = false; });
    document.querySelector("#section-2")?.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  editSubmissionButton?.addEventListener("click", () => { void beginSubmissionEdit(); });
  restartSubmissionButton?.addEventListener("click", () => { void beginSubmissionEdit(true); });

  const registerApplicationTools = () => {
    type ApplicationModelContext = {
      registerTool: (tool: {
        name: string;
        title: string;
        description: string;
        inputSchema: object;
        annotations: { readOnlyHint: boolean; untrustedContentHint: boolean };
        execute: (input: unknown) => Promise<Record<string, string>>;
      }, options?: { signal?: AbortSignal }) => void | Promise<void>;
    };
    const context = (document as Document & { modelContext?: ApplicationModelContext }).modelContext;
    if (!context?.registerTool) return;
    const lifecycle = new AbortController();
    try {
      void Promise.resolve(context.registerTool({
        name: "start_submission_edit",
        title: "Edit submitted Spotlight application",
        description: "Open the existing submitted application in edit mode while preserving its current answers.",
        inputSchema: { type: "object", properties: {}, additionalProperties: false },
        annotations: { readOnlyHint: true, untrustedContentHint: false },
        async execute(input) {
          if (!input || typeof input !== "object" || Array.isArray(input) || Object.keys(input).length > 0) {
            throw new Error("This action does not accept input fields.");
          }
          if (!registrationState?.submittedAt || !existingApplication) {
            throw new Error("No submitted application is available to edit.");
          }
          await beginSubmissionEdit(false);
          return { status: "editing", reference: registrationState.publicReference };
        },
      }, { signal: lifecycle.signal })).catch((error) => console.error(error));
    } catch (error) {
      console.error(error);
    }
    window.addEventListener("pagehide", () => lifecycle.abort(), { once: true });
  };
  registerApplicationTools();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!registrationState || (!currentUser && !isSamplePreview)) {
      setAuthMode("login");
      document.querySelector("#section-1")?.scrollIntoView({ behavior: "smooth", block: "start" });
      return;
    }
    if (registrationState.submittedAt && !isEditingSubmission) {
      displaySubmitted(registrationState.publicReference, true);
      return;
    }
    if (!form.reportValidity()) return;
    const message = form.querySelector<HTMLElement>(".submit-area .form-message");
    const originalLabel = submitLabel?.textContent || "Submit";
    const values = new FormData(form);
    if (String(values.get("company_website") || "").trim()) return;
    if (!isSamplePreview && Date.now() - startedAt < 2500) {
      if (message) message.textContent = form.dataset.tooFastMessage || "Please review your answers.";
      return;
    }
    if (draftSaveTimer) window.clearTimeout(draftSaveTimer);
    await saveDraft();
    const targetUsers = String(values.get("target_users") || "").trim();
    const agentCore = String(values.get("agent_core") || "").trim();
    const userId = currentUser?.id || "spotlight-sample-user";
    const payload: Record<string, string | number | boolean | string[] | null> = {
      user_id: userId,
      public_reference: registrationState.publicReference,
      application_language: form.dataset.language || "en",
      applicant_name: registrationState.applicantName,
      applicant_email: registrationState.applicantEmail,
      contact_handle: registrationState.contactHandle || null,
      country_region: registrationState.countryRegion,
      team_size: Number(values.get("team_size")),
      team_members_and_roles: String(values.get("team_members_and_roles") || "").trim(),
      project_name: String(values.get("project_name") || "").trim(),
      product_form: String(values.get("product_form") || ""),
      one_liner: String(values.get("one_liner") || "").trim(),
      target_users: targetUsers,
      problem_statement: targetUsers,
      category_thesis: agentCore,
      agent_core: agentCore,
      current_stage: String(values.get("current_stage") || ""),
      prototype_url: String(values.get("prototype_url") || "").trim(),
      demo_video_url: String(values.get("demo_video_url") || "").trim(),
      repository_url: String(values.get("repository_url") || "").trim() || null,
      technology_summary: String(values.get("technology_summary") || "").trim(),
      open_source_status: String(values.get("open_source_status") || ""),
      shenzhen_attendance: String(values.get("shenzhen_attendance") || ""),
      sprint_goal: String(values.get("sprint_goal") || "").trim(),
      support_needs: values.getAll("support_needs").map(String),
      privacy_consent: values.get("privacy_consent") === "on",
      code_of_conduct_consent: values.get("code_of_conduct_consent") === "on",
      submission_declaration: values.get("submission_declaration") === "on",
      source_path: window.location.pathname,
    };
    if (submitButton) submitButton.disabled = true;
    const isUpdate = Boolean(registrationState.submittedAt);
    if (submitLabel) submitLabel.textContent = isUpdate
      ? form.dataset.updatingLabel || "Saving changes…"
      : form.dataset.submittingLabel || "Submitting…";
    if (message) message.textContent = "";
    let error = null;
    if (isSamplePreview) {
      error = null;
    } else if (isUpdate) {
      const {
        user_id: _userId,
        public_reference: _publicReference,
        applicant_name: _applicantName,
        applicant_email: _applicantEmail,
        contact_handle: _contactHandle,
        country_region: _countryRegion,
        ...editablePayload
      } = payload;
      const result = await supabase
        .from("spotlight_shenzhen_2026_applications")
        .update(editablePayload)
        .eq("user_id", userId)
        .eq("public_reference", registrationState.publicReference)
        .select("id")
        .single();
      error = result.error;
    } else {
      const result = await supabase.from("spotlight_shenzhen_2026_applications").insert(payload);
      error = result.error;
    }
    if (error) {
      console.error(error);
      if (message) message.textContent = form.dataset.errorMessage || "Submission failed. Please try again.";
      if (submitButton) submitButton.disabled = false;
      if (submitLabel) submitLabel.textContent = originalLabel;
      return;
    }
    registrationState.submittedAt ||= new Date().toISOString();
    existingApplication = payload;
    if (isUpdate && !isSamplePreview) {
      const { error: draftDeleteError } = await supabase
        .from("spotlight_shenzhen_2026_drafts")
        .delete()
        .eq("user_id", userId);
      if (draftDeleteError) console.error(draftDeleteError);
    }
    renderSubmissionSummary(payload);
    gatedNavigationItems.forEach((item) => { item.hidden = true; });
    displaySubmitted(registrationState.publicReference, true, isUpdate);
  });

  supabase.auth.onAuthStateChange((event, session) => {
    if (isSamplePreview) return;
    window.setTimeout(() => {
      if (event === "PASSWORD_RECOVERY") {
        showPasswordRecovery();
        return;
      }
      if (session?.user) void loadAccount(session.user);
      else if (event === "SIGNED_OUT") showSignedOut();
    }, 0);
  });

  const initializeAuth = async () => {
    setAuthMode("register");
    if (isSamplePreview) {
      const language = form?.dataset.language || "en";
      const isChinese = language === "zh";
      const isFrench = language === "fr";
      const state: RegistrationState = {
        userId: "spotlight-sample-user",
        publicReference: "SZ26-SAMPLE",
        applicantName: isChinese ? "Spotlight 示例团队" : isFrench ? "Équipe exemple Spotlight" : "Spotlight Sample Team",
