---
import Layout from "layouts/Layout.astro";
import { shenzhenSelectionCopy } from "../data/shenzhen-selection";
import { getLocalizedPath, type Locale } from "../i18n/translations";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = shenzhenSelectionCopy[locale];
const selectionPath = `${getLocalizedPath("/shenzhen2026", locale)}#selected-projects`;
---

<Layout title={`${c.closedTitle} · Spotlight Shenzhen 2026`} description={c.closedDescription} navDarkMode={false} navBackground="header-home" pageTransitionName="Spotlight Shenzhen 2026 Applications Closed" socialImage="/images/shenzhen2026/og-shenzhen-film.png" locale={locale} nativeScroll={true} footerVariant="spotlight">
  <section class="closed-page" data-theme-section="light" aria-labelledby="closed-title">
    <div class="closed-container">
      <img src="/images/shenzhen2026/spotlight-shenzhen-2026-badge.png" alt="Spotlight Shenzhen 2026" width="1250" height="1250" />
      <p class="closed-eyebrow">SPOTLIGHT SHENZHEN 2026</p>
      <h1 id="closed-title">{c.closedTitle}</h1>
      <p class="closed-description">{c.closedDescription}</p>
      <div class="closed-actions">
        <a class="selection-link" href={selectionPath}>{c.viewSelection}<span class="shape-icon shape-icon--arrow" aria-hidden="true"></span></a>
        <a href="https://shenzhen2026.gosim.org" target="_blank" rel="noopener noreferrer">{c.conference}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span></a>
      </div>
      <p class="closed-date">{c.date}</p>
    </div>
  </section>
</Layout>

<style>
  .closed-page { min-height: 80svh; padding: 128px 24px 64px; color: #171918; background: #fffdf8; font-family: "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif; }
  .closed-container { max-width: 800px; margin: 0 auto; }
  .closed-container > img { width: 130px; height: 130px; object-fit: contain; margin-bottom: 24px; }
  .closed-eyebrow { margin: 0; color: #a53a22; font-size: 12px; font-weight: 800; letter-spacing: .1em; }
  .closed-container h1 { margin: 16px 0 24px; color: #171918; font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.1; font-weight: 650; letter-spacing: -.04em; }
  .closed-description { max-width: 650px; color: #5e625f; font-size: 18px; line-height: 1.65; }
  .closed-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 28px 0; }
  .closed-actions a { display: inline-flex; gap: 20px; align-items: center; padding: 14px 18px; border: 1px solid #171918; color: #171918; font-size: 14px; line-height: 1.5; font-weight: 750; text-decoration: none; }
  .closed-actions .selection-link { background: #ff6a43; }
  .closed-actions a:hover { color: #fff; background: #171918; }
  .closed-actions a:focus-visible { outline: 3px solid #a53a22; outline-offset: 4px; }
  .closed-date { color: #5e625f; font-size: 14px; }
  @media (max-width: 520px) { .closed-page { padding-top: 100px; } .closed-description { font-size: 16px; } }
</style>
