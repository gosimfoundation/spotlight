<script>
  const form = document.querySelector<HTMLFormElement>("#application-form");
  const successPanel = document.querySelector<HTMLElement>("#success-panel");
  const referenceOutput = document.querySelector<HTMLElement>("#submission-reference");
  const summaryOutput = document.querySelector<HTMLDListElement>("#submission-summary");
  const startedAt = Date.now();

  document.querySelectorAll<HTMLAnchorElement>(".application-language-switch a").forEach((link) => {
    link.addEventListener("click", () => {
      const selectedLocale = link.dataset.locale;
      if (selectedLocale) document.cookie = `locale=${selectedLocale};path=/;max-age=${60 * 60 * 24 * 365}`;
    });
  });

  const optionalTextFields = [
    "contact_handle", "team_organization", "project_url", "demo_video_url",
    "repository_url", "traction", "license_name", "support_details",
  ];

  const createReference = () => {
    const bytes = new Uint8Array(6);
    crypto.getRandomValues(bytes);
    return `SZ26-${Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("").toUpperCase()}`;
  };

  type SummaryField = {
    name: string;
    label: string;
    type?: "url" | "select" | "checkboxes" | "consent";
  };

  const renderSubmissionSummary = (payload: Record<string, string | number | boolean | string[] | null>) => {
    if (!successPanel || !summaryOutput) return;
    const fields = JSON.parse(successPanel.dataset.summaryFields || "[]") as SummaryField[];
    const emptyLabel = successPanel.dataset.summaryEmpty || "—";
    const confirmedLabel = successPanel.dataset.summaryConfirmed || "Confirmed";
    const fragment = document.createDocumentFragment();

    fields.forEach((field) => {
      const row = document.createElement("div");
      const term = document.createElement("dt");
      const detail = document.createElement("dd");
      term.textContent = field.label;

      let displayValue: string | number | null = payload[field.name] as string | number | null;
      if (field.type === "select") {
        const select = form?.querySelector<HTMLSelectElement>(`select[name="${field.name}"]`);
        displayValue = select?.selectedOptions[0]?.textContent?.trim() || emptyLabel;
      } else if (field.type === "checkboxes") {
        const selected = Array.from(form?.querySelectorAll<HTMLInputElement>(`input[name="${field.name}"]:checked`) || [])
          .map((input) => input.closest("label")?.textContent?.trim())
          .filter(Boolean);
        displayValue = selected.length ? selected.join("、") : emptyLabel;
      } else if (field.type === "consent") {
        displayValue = confirmedLabel;
      }

      if (field.type === "url" && typeof displayValue === "string" && displayValue) {
        const link = document.createElement("a");
        link.href = displayValue;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = displayValue;
        detail.append(link);
      } else {
        detail.textContent = displayValue === null || displayValue === "" ? emptyLabel : String(displayValue);
      }

      row.append(term, detail);
      fragment.append(row);
    });

    summaryOutput.replaceChildren(fragment);
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const message = form.querySelector<HTMLElement>(".form-message");
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = submitButton?.querySelector<HTMLElement>("span");
    const originalLabel = submitLabel?.textContent || "Submit";
    const values = new FormData(form);

    if (String(values.get("company_website") || "").trim()) return;
    if (Date.now() - startedAt < 2500) {
      if (message) message.textContent = form.dataset.tooFastMessage || "Please review your answers.";
      return;
    }

    const reference = createReference();
    const payload: Record<string, string | number | boolean | string[] | null> = {
      public_reference: reference,
      application_language: form.dataset.language || "en",
      applicant_name: String(values.get("applicant_name") || "").trim(),
      applicant_email: String(values.get("applicant_email") || "").trim().toLowerCase(),
      contact_handle: String(values.get("contact_handle") || "").trim(),
      country_region: String(values.get("country_region") || "").trim(),
      team_organization: String(values.get("team_organization") || "").trim(),
      team_size: Number(values.get("team_size")),
      team_members_and_roles: String(values.get("team_members_and_roles") || "").trim(),
      project_name: String(values.get("project_name") || "").trim(),
      project_url: String(values.get("project_url") || "").trim(),
      product_form: String(values.get("product_form") || ""),
      one_liner: String(values.get("one_liner") || "").trim(),
      target_users: String(values.get("target_users") || "").trim(),
      problem_statement: String(values.get("problem_statement") || "").trim(),
      category_thesis: String(values.get("category_thesis") || "").trim(),
      agent_core: String(values.get("agent_core") || "").trim(),
      current_stage: String(values.get("current_stage") || ""),
      prototype_url: String(values.get("prototype_url") || "").trim(),
      demo_video_url: String(values.get("demo_video_url") || "").trim(),
      repository_url: String(values.get("repository_url") || "").trim(),
      technology_summary: String(values.get("technology_summary") || "").trim(),
      traction: String(values.get("traction") || "").trim(),
      open_source_status: String(values.get("open_source_status") || ""),
      license_name: String(values.get("license_name") || "").trim(),
      shenzhen_attendance: String(values.get("shenzhen_attendance") || ""),
      sprint_goal: String(values.get("sprint_goal") || "").trim(),
      support_needs: values.getAll("support_needs").map(String),
      support_details: String(values.get("support_details") || "").trim(),
      privacy_consent: values.get("privacy_consent") === "on",
      code_of_conduct_consent: values.get("code_of_conduct_consent") === "on",
      submission_declaration: values.get("submission_declaration") === "on",
      source_path: window.location.pathname,
    };

    optionalTextFields.forEach((field) => {
      if (payload[field] === "") payload[field] = null;
    });

    if (submitButton) submitButton.disabled = true;
    if (submitLabel) submitLabel.textContent = form.dataset.submittingLabel || "Submitting…";
    if (message) message.textContent = "";

    try {
      const response = await fetch(`${form.dataset.projectUrl}/rest/v1/spotlight_shenzhen_2026_applications`, {
        method: "POST",
        headers: {
          apikey: form.dataset.apiKey || "",
          "Content-Type": "application/json",
          Prefer: "return=minimal",
        },
        body: JSON.stringify(payload),
      });

      if (!response.ok) throw new Error(`Submission failed: ${response.status}`);
      renderSubmissionSummary(payload);
      form.hidden = true;
      if (referenceOutput) referenceOutput.textContent = reference;
      if (successPanel) {
        successPanel.hidden = false;
        successPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    } catch (error) {
      console.error(error);
      if (message) message.textContent = form.dataset.errorMessage || "Submission failed. Please try again.";
      if (submitButton) submitButton.disabled = false;
      if (submitLabel) submitLabel.textContent = originalLabel;
    }
  });
</script>

