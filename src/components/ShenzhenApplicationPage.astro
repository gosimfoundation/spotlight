    successText: "Conservez la référence ci-dessous. Nous contacterons l’adresse principale si l’équipe de sélection a besoin d’informations.",
    reference: "Référence",
    summaryTitle: "Informations envoyées",
    summaryIntro: "Voici les informations transmises avec cette candidature.",
    summaryEmpty: "Non renseigné",
    summaryConfirmed: "Confirmé",
    summaryConsent: "Confirmations obligatoires",
