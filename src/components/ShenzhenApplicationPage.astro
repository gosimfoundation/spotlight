        registeredAt: "2026-09-01T09:00:00.000Z",
        submittedAt: "2026-09-06T09:00:00.000Z",
      };
      const sampleApplication: ApplicationData = {
        user_id: state.userId,
        public_reference: state.publicReference,
        application_language: language,
        applicant_name: state.applicantName,
        applicant_email: state.applicantEmail,
        contact_handle: state.contactHandle,
        country_region: state.countryRegion,
        team_size: 3,
        team_members_and_roles: isChinese
          ? "林然负责产品与交互，周宁负责 Agent 系统，陈一负责硬件原型。"
          : "Lin leads product and interaction, Zhou builds the agent system, and Chen owns the hardware prototype.",
        project_name: "Context Relay",
        product_form: "cross_device",
        one_liner: isChinese
          ? "一个连接手机、开源手表与智能眼镜的出行 Agent，在行程变化时主动重排下一步。"
          : "A travel agent across phone, open-source watch, and smart glasses that replans the next step when a trip changes.",
        target_users: isChinese
          ? "面向频繁独自出差的人。当航班、会议或接驳临时变化时，用户不必在多个 App 之间反复查询和重排。"
          : "For frequent solo travelers who currently jump between several apps when a flight, meeting, or transfer changes.",
        problem_statement: "",
        category_thesis: "",
        agent_core: isChinese
          ? "Agent 读取日历与实时行程，判断变化影响，调用地图和交通工具，并把确认后的新安排同步到不同设备。"
          : "The agent reads calendar and live itinerary data, evaluates changes, calls mapping and transit tools, then syncs the confirmed plan across devices.",
        current_stage: "prototype",
        prototype_url: "https://example.com/spotlight-prototype",
        demo_video_url: "https://example.com/spotlight-demo",
        repository_url: "https://github.com/example/context-relay",
        technology_summary: isChinese
          ? "原型包含一个网页控制台、手机端界面和开源手表客户端；Agent 通过工具调用连接日历、地图与通知服务。"
          : "The prototype combines a web console, mobile interface, and open-source watch client, with tool calls to calendar, maps, and notifications.",
        shenzhen_attendance: "yes",
        open_source_status: "planning_core",
        sprint_goal: isChinese
          ? "接通真实地图与日历，把手表通知流程做成稳定的 90 秒现场演示。"
          : "Connect live maps and calendar data, then turn the watch workflow into a reliable 90-second stage demo.",
        support_needs: ["product", "hardware", "demo_story"],
        privacy_consent: true,
        code_of_conduct_consent: true,
        submission_declaration: true,
        source_path: window.location.pathname,
      };
      existingApplication = sampleApplication;
      applyApplication(sampleApplication);
      renderSubmissionSummary(sampleApplication);
      showQuestionnaire(state);
      return;
    }
    const { data } = await supabase.auth.getSession();
    if (data.session?.user) await loadAccount(data.session.user);
  };
  void initializeAuth();
</script>

