<Layout
  title={c.metaTitle}
  description={c.metaDesc}
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Spotlight Shenzhen 2026 Application"
  socialImage="/images/shenzhen2026/og-shenzhen.png"
  locale={locale}
  nativeScroll={true}
>
  <div class="application-page">
    <header class="application-hero" data-theme-section="dark">
      <div class="hero-grid"></div>
      <div class="application-container hero-content">
        <div class="hero-topline">
          <a class="back-link" href={programPath}>← {c.back}</a>
          <nav class="application-language-switch" aria-label="Application language">
            {languageLinks.map((item) => (
              <a href={item.href} data-locale={item.locale} aria-current={locale === item.locale ? "page" : undefined}>{item.label}</a>
            ))}
          </nav>
        </div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.title.split("\n").map((line) => <>{line}<br /></>)}</h1>
        <p class="hero-intro">{c.intro}</p>
        <div class="hero-status">
          <strong><span></span>{c.open}</strong>
          <p>{c.timing}</p>
          <small>{c.time}</small>
        </div>
      </div>
    </header>

    <main class="application-container application-layout">
      <aside class="application-guide">
        <div class="guide-card">
          <p class="guide-title">{c.prepare}</p>
