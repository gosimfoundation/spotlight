---
interface Props {
  subtitle: string;
  eyebrow: string;
  sceneLabel: string;
  skipLabel: string;
  replayLabel: string;
  exploreLabel: string;
  announcement: {
    text: string;
    link: string;
  };
}

const {
  subtitle,
  eyebrow,
  sceneLabel,
  skipLabel,
  replayLabel,
  exploreLabel,
  announcement,
} = Astro.props;
---

<section
  class="spotlight-hero is-playing"
  data-spotlight-hero
  data-bg-section="header-home"
  aria-label={sceneLabel}
>
  <div class="stage-haze" aria-hidden="true"></div>

  <div class="spotlight-scene" aria-hidden="true">
    <div class="beam beam-robot" style="--reveal: .2s;"><i></i></div>
    <div class="beam beam-laptop" style="--reveal: .85s;"><i></i></div>
    <div class="beam beam-watch" style="--reveal: 1.5s;"><i></i></div>
    <div class="beam beam-telescope" style="--reveal: 2.15s;"><i></i></div>

    <div class="product-stage">
      <img
        class="stage-products stage-products-base"
        src="/images/homepage/spotlight-stage.png"
        alt=""
      />
      <div class="product-reveal reveal-robot" style="--reveal: .28s; --reveal-x: 13%;">
        <img class="stage-products" src="/images/homepage/spotlight-stage.png" alt="" />
      </div>
      <div class="product-reveal reveal-laptop" style="--reveal: .93s; --reveal-x: 38%;">
        <img class="stage-products" src="/images/homepage/spotlight-stage.png" alt="" />
      </div>
      <div class="product-reveal reveal-watch" style="--reveal: 1.58s; --reveal-x: 63%;">
        <img class="stage-products" src="/images/homepage/spotlight-stage.png" alt="" />
      </div>
      <div class="product-reveal reveal-telescope" style="--reveal: 2.23s; --reveal-x: 88%;">
        <img class="stage-products" src="/images/homepage/spotlight-stage.png" alt="" />
      </div>
    </div>
  </div>

  <div class="light-wash" aria-hidden="true"></div>

  <div class="hero-finale">
    <div class="finale-copy">
      <p class="finale-eyebrow"><span></span>{eyebrow}</p>
      <img
        class="finale-logo"
        src="/images/gosim-logo-official.svg"
        alt="GOSIM"
        width="255"
        height="72"
      />
      <h1>Spotlight</h1>
      <p class="finale-subtitle">{subtitle}</p>
      <a href={announcement.link} class="finale-announcement">
        <span class="announcement-pulse"></span>
        <span>{announcement.text}</span>
        <i aria-hidden="true">↗</i>
      </a>
    </div>

    <a class="explore-cue" href="#about">
      <span>{exploreLabel}</span>
      <i aria-hidden="true">↓</i>
    </a>
  </div>

  <button class="intro-control skip-intro" type="button" data-skip-intro>
    {skipLabel}<span aria-hidden="true"> →</span>
  </button>
  <button class="intro-control replay-intro" type="button" data-replay-intro>
    <span aria-hidden="true">↻ </span>{replayLabel}
  </button>
</section>

<script>
  const initSpotlightHeroes = () => {
    document.querySelectorAll("[data-spotlight-hero]").forEach((hero) => {
      if (!(hero instanceof HTMLElement) || hero.dataset.initialized === "true") return;
      hero.dataset.initialized = "true";

      const skipButton = hero.querySelector("[data-skip-intro]");
      const replayButton = hero.querySelector("[data-replay-intro]");
      let completionTimer;

      const setNavigationTheme = (theme) => {
        document.body.dataset.themeNav = theme;
      };

      const completeIntro = () => {
        window.clearTimeout(completionTimer);
        hero.classList.remove("is-playing");
        hero.classList.add("is-complete");
        setNavigationTheme("light");
      };

      const playIntro = () => {
        window.clearTimeout(completionTimer);
        hero.classList.remove("is-playing", "is-complete");
        setNavigationTheme("dark");
        void hero.offsetWidth;
        hero.classList.add("is-playing");
        completionTimer = window.setTimeout(completeIntro, 4300);
      };

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        completeIntro();
      } else {
        setNavigationTheme("dark");
        completionTimer = window.setTimeout(completeIntro, 4300);
      }

      skipButton?.addEventListener("click", completeIntro);
      replayButton?.addEventListener("click", playIntro);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSpotlightHeroes, { once: true });
  } else {
    initSpotlightHeroes();
  }
</script>

<style>
  .spotlight-hero {
    --ink: #062e37;
    --mint: #64e6bd;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #050708;
    color: #fff;
    font-family: 'Manrope', sans-serif;
    transition: background-color .6s ease;
  }

  .stage-haze {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: .42;
    background:
      radial-gradient(circle at 50% 8%, rgba(134, 175, 171, .16), transparent 32%),
      repeating-radial-gradient(ellipse at 50% 110%, transparent 0 28px, rgba(255,255,255,.018) 29px 30px),
      linear-gradient(180deg, #050708 0%, #071012 62%, #0d1718 100%);
  }

  .spotlight-scene,
  .hero-finale,
  .light-wash {
    position: absolute;
    inset: 0;
  }

  .spotlight-scene {
    z-index: 2;
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .beam {
    position: absolute;
    top: -4%;
    left: var(--x);
    z-index: 3;
    width: clamp(9rem, 22vw, 24rem);
    height: 76%;
    opacity: 0;
    transform: translateX(-50%);
    transform-origin: 50% 0;
    clip-path: polygon(48% 0, 52% 0, 100% 100%, 0 100%);
    background: linear-gradient(180deg, rgba(242, 246, 242, .82), rgba(230, 240, 234, .17) 68%, rgba(230, 240, 234, 0));
    filter: blur(7px);
    mix-blend-mode: screen;
  }

  .beam i {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 88%, rgba(233, 242, 236, .72), transparent 57%);
    animation: beamBreathe 1.7s ease-in-out infinite alternate;
  }

  .beam-robot { --x: 13%; }
  .beam-laptop { --x: 38%; }
  .beam-watch { --x: 63%; }
  .beam-telescope { --x: 88%; }

  .product-stage,
  .product-reveal,
  .stage-products {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .product-stage {
    z-index: 2;
    overflow: hidden;
  }

  .stage-products {
    object-fit: contain;
    object-position: center bottom;
  }

  .stage-products-base {
    opacity: .7;
    filter: brightness(.25) contrast(1.08);
  }

  .product-reveal {
    --reveal-y: 73%;
    opacity: 0;
    -webkit-mask-image: radial-gradient(ellipse 17% 38% at var(--reveal-x) var(--reveal-y), #000 14%, rgba(0,0,0,.9) 43%, transparent 78%);
    mask-image: radial-gradient(ellipse 17% 38% at var(--reveal-x) var(--reveal-y), #000 14%, rgba(0,0,0,.9) 43%, transparent 78%);
  }

  .product-reveal .stage-products {
    filter: brightness(1.12) contrast(1.08);
  }

  .light-wash {
    z-index: 5;
    opacity: 0;
    transform: scale(.08);
    border-radius: 50%;
    background: radial-gradient(circle, #fafbf8 0 42%, rgba(250,251,248,.98) 61%, rgba(240,243,238,.62) 74%, transparent 76%);
    filter: blur(18px);
    pointer-events: none;
  }

  .hero-finale {
    z-index: 6;
    display: grid;
    place-items: stretch;
    overflow: hidden;
    opacity: 0;
    color: var(--ink);
    background: #f8f9f6;
    pointer-events: none;
  }

  .finale-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: min(86vw, 78rem);
    margin: 0 auto;
    padding: clamp(8rem, 15vh, 10rem) 0 clamp(7rem, 13vh, 9rem);
    text-align: left;
  }

  .finale-eyebrow {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: .65rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: #315b52;
    font-size: clamp(.75rem, .82vw, .84rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: .13em;
    text-wrap: balance;
    text-transform: uppercase;
  }
  .finale-eyebrow span {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: none;
  }
  .finale-copy h1 {
    margin-top: clamp(1.15rem, 2vw, 1.75rem);
    color: var(--ink);
    font-family: 'Manrope', sans-serif;
    font-size: clamp(4.2rem, 10vw, 9rem);
    font-weight: 600;
    line-height: .92;
    letter-spacing: -.055em;
  }

  .finale-logo {
    width: clamp(8rem, 11vw, 10.5rem);
    height: auto;
    filter: brightness(0) saturate(100%) invert(17%) sepia(23%) saturate(1179%) hue-rotate(135deg) brightness(91%) contrast(96%);
  }
  .finale-subtitle {
    max-width: 38rem;
    margin: clamp(1.5rem, 3vw, 2.4rem) 0 0;
    color: #46605d;
    font-size: clamp(1.05rem, 1.3vw, 1.22rem);
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .finale-announcement {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    width: min(100%, 42rem);
    max-width: 100%;
    margin-top: clamp(1.75rem, 3.5vw, 3rem);
    padding: 1rem 0;
    border-top: 1px solid rgba(11,54,56,.22);
    border-bottom: 1px solid rgba(11,54,56,.22);
    border-radius: 0;
    color: #174c40;
    background: transparent;
    box-shadow: none;
    font-size: clamp(.8rem, .95vw, .92rem);
    font-weight: 600;
    line-height: 1.45;
    text-decoration: none;
    text-align: left;
    text-wrap: balance;
    pointer-events: auto;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .finale-announcement:hover {
    transform: none;
    border-color: rgba(11,54,56,.55);
    box-shadow: none;
  }
  .announcement-pulse {
    flex: 0 0 auto;
    width: .42rem;
    height: .42rem;
    border-radius: 50%;
    background: #48d2a5;
    box-shadow: none;
  }
  .finale-announcement i {
    flex: 0 0 auto;
    font-style: normal;
    font-size: 1rem;
  }

  .explore-cue {
    position: absolute;
    z-index: 3;
    bottom: 2.2rem;
    left: 7%;
    display: flex;
    align-items: center;
    gap: .6rem;
    transform: none;
    color: rgba(6,46,55,.65);
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-decoration: none;
    text-transform: uppercase;
    pointer-events: auto;
  }
  .explore-cue i {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 1px solid rgba(6,46,55,.19);
    border-radius: 50%;
    font-style: normal;
    animation: none;
  }

  .intro-control {
    position: absolute;
    z-index: 12;
    right: clamp(1.1rem, 3vw, 2.5rem);
    bottom: clamp(1.1rem, 3vw, 2.5rem);
    padding: .65rem .9rem;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 999px;
    color: rgba(255,255,255,.78);
    background: rgba(5,10,10,.22);
    backdrop-filter: blur(10px);
    font: inherit;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color .2s ease, background .2s ease, transform .2s ease;
  }
  .intro-control:hover {
    color: #fff;
    background: rgba(255,255,255,.1);
    transform: translateY(-2px);
  }
  .replay-intro {
    opacity: 0;
    visibility: hidden;
    color: rgba(6,46,55,.7);
    border-color: rgba(6,46,55,.15);
    background: transparent;
  }
  .replay-intro:hover {
    color: var(--ink);
    background: #fff;
  }

  .is-playing .beam {
    animation: beamReveal .22s var(--reveal) cubic-bezier(.2,.75,.2,1) both, beamExit .48s 3.05s ease forwards;
  }
  .is-playing .product-reveal {
    animation: productReveal .5s var(--reveal) ease both, productExit .48s 3.08s ease forwards;
  }
  .is-playing .light-wash { animation: lightWash 1.05s 2.95s cubic-bezier(.7,0,.25,1) both; }
  .is-playing .hero-finale { animation: finaleReveal .68s 3.42s ease both; }
  .is-playing .finale-copy { animation: copyReveal .58s 3.5s cubic-bezier(.2,.8,.2,1) both; }
  .is-playing .explore-cue { animation: copyReveal .45s 3.78s ease both; }
  .is-playing .skip-intro { animation: controlExit .2s 2.95s ease forwards; }

  .is-complete {
    background: #fff;
  }
  .is-complete .stage-haze,
  .is-complete .spotlight-scene,
  .is-complete .light-wash,
  .is-complete .skip-intro {
    opacity: 0;
    visibility: hidden;
  }
  .is-complete .hero-finale,
  .is-complete .finale-copy,
  .is-complete .explore-cue {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    animation: none;
  }
  .is-complete .replay-intro {
    opacity: 1;
    visibility: visible;
  }

  @keyframes beamReveal {
    from { opacity: 0; transform: translateX(-50%) scaleX(.2); }
    to { opacity: .78; transform: translateX(-50%) scaleX(1); }
  }
  @keyframes beamExit { to { opacity: .06; } }
  @keyframes beamBreathe { to { opacity: .62; transform: scaleX(.88); } }
  @keyframes productReveal {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes productExit { to { opacity: .08; } }
  @keyframes lightWash {
    0% { opacity: 0; transform: scale(.08); }
    35% { opacity: .88; }
    100% { opacity: 1; transform: scale(2.2); }
  }
  @keyframes finaleReveal { from { opacity: 0; } to { opacity: 1; } }
  @keyframes copyReveal {
    from { opacity: 0; transform: translateY(25px) scale(.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes controlExit { to { opacity: 0; visibility: hidden; } }
  @keyframes cueBounce { 50% { transform: translateY(4px); } }

  @media (max-width: 720px) {
    .spotlight-hero { min-height: max(100svh, 40rem); }
    .beam-robot { --x: 10%; }
    .beam-laptop { --x: 36%; }
    .beam-watch { --x: 64%; }
    .beam-telescope { --x: 90%; }
    .beam { width: 36vw; height: 100%; }
    .product-reveal { --reveal-y: 87%; }
    .finale-copy {
      width: 88vw;
      padding: 7rem 0 6.5rem;
    }
    .finale-eyebrow {
      font-size: .72rem;
      letter-spacing: .1em;
    }
    .finale-copy h1 { font-size: clamp(3.45rem, 17vw, 6rem); }
    .finale-logo { width: 7.5rem; }
    .finale-subtitle { font-size: 1rem; }
    .finale-announcement {
      align-items: flex-start;
      padding: .9rem 0;
    }
    .finale-announcement i { margin-left: auto; }
    .explore-cue { bottom: 1.35rem; }
    .intro-control { bottom: 1.1rem; }
    .is-complete .replay-intro { bottom: auto; top: 6rem; }
  }

  @media (max-height: 700px) and (min-width: 721px) {
    .finale-copy { padding-top: 6rem; }
    .finale-copy h1 { font-size: clamp(4rem, 12vh, 7rem); }
    .finale-subtitle { margin-top: 1.3rem; }
    .finale-announcement { margin-top: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight-hero { background: #fff; }
    .spotlight-scene,
    .stage-haze,
    .light-wash,
    .skip-intro { display: none; }
    .hero-finale,
    .finale-copy,
    .explore-cue {
      opacity: 1;
      transform: none;
      animation: none !important;
      pointer-events: auto;
    }
    .explore-cue i { animation: none; }
  }
</style>
