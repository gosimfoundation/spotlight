---
interface Props {
  subtitle: string;
  eyebrow: string;
  sceneLabel: string;
  skipLabel: string;
  replayLabel: string;
  exploreLabel: string;
  announcement: {
    text: string;
    link: string;
  };
  objectLabels: {
    robot: string;
    laptop: string;
    watch: string;
    telescope: string;
  };
}

const {
  subtitle,
  eyebrow,
  sceneLabel,
  skipLabel,
  replayLabel,
  exploreLabel,
  announcement,
  objectLabels,
} = Astro.props;
---

<section
  class="spotlight-hero is-playing"
  data-spotlight-hero
  data-bg-section="header-home"
  aria-label={sceneLabel}
>
  <div class="stage-haze" aria-hidden="true"></div>

  <div class="spotlight-scene" aria-hidden="true">
    <div class="lighting-rig">
      <span></span><span></span><span></span><span></span>
    </div>

    <div class="beam beam-robot" style="--reveal: .65s; --beam-color: 179, 255, 225;"><i></i></div>
    <div class="beam beam-laptop" style="--reveal: 2.1s; --beam-color: 154, 218, 255;"><i></i></div>
    <div class="beam beam-watch" style="--reveal: 3.55s; --beam-color: 255, 222, 147;"><i></i></div>
    <div class="beam beam-telescope" style="--reveal: 5s; --beam-color: 202, 183, 255;"><i></i></div>

    <div class="stage-floor"></div>

    <div class="exhibit exhibit-robot" style="--reveal: .75s;">
      <div class="prop robot">
        <div class="robot-antenna"></div>
        <div class="robot-head"><i></i><i></i></div>
        <div class="robot-neck"></div>
        <div class="robot-body"><span></span></div>
        <div class="robot-arm arm-left"></div>
        <div class="robot-arm arm-right"></div>
        <div class="robot-leg leg-left"></div>
        <div class="robot-leg leg-right"></div>
      </div>
      <div class="pedestal"><span>{objectLabels.robot}</span></div>
    </div>

    <div class="exhibit exhibit-laptop" style="--reveal: 2.2s;">
      <div class="prop laptop">
        <div class="laptop-screen"><i></i><i></i><i></i></div>
        <div class="laptop-base"><span></span></div>
      </div>
      <div class="pedestal"><span>{objectLabels.laptop}</span></div>
    </div>

    <div class="exhibit exhibit-watch" style="--reveal: 3.65s;">
      <div class="prop watch">
        <div class="watch-strap"></div>
        <div class="watch-face"><span>10:08</span><i></i></div>
        <div class="watch-crown"></div>
      </div>
      <div class="pedestal"><span>{objectLabels.watch}</span></div>
    </div>

    <div class="exhibit exhibit-telescope" style="--reveal: 5.1s;">
      <div class="prop telescope">
        <div class="telescope-tube"><i></i><span></span></div>
        <div class="telescope-joint"></div>
        <div class="telescope-leg leg-a"></div>
        <div class="telescope-leg leg-b"></div>
        <div class="telescope-leg leg-c"></div>
      </div>
      <div class="pedestal"><span>{objectLabels.telescope}</span></div>
    </div>

    <div class="stage-counter">
      <i></i><i></i><i></i><i></i>
    </div>
  </div>

  <div class="light-wash" aria-hidden="true"></div>

  <div class="hero-finale">
    <div class="finale-orbit orbit-one" aria-hidden="true"></div>
    <div class="finale-orbit orbit-two" aria-hidden="true"></div>
    <div class="finale-copy">
      <p class="finale-eyebrow"><span></span>{eyebrow}</p>
      <h1>
        <span class="title-gosim">GOSIM</span>
        <span class="title-spotlight">Spotlight</span>
      </h1>
      <p class="finale-subtitle">{subtitle}</p>
      <a href={announcement.link} class="finale-announcement">
        <span class="announcement-pulse"></span>
        <span>{announcement.text}</span>
        <i aria-hidden="true">↗</i>
      </a>
    </div>

    <a class="explore-cue" href="#about">
      <span>{exploreLabel}</span>
      <i aria-hidden="true">↓</i>
    </a>
  </div>

  <button class="intro-control skip-intro" type="button" data-skip-intro>
    {skipLabel}<span aria-hidden="true"> →</span>
  </button>
  <button class="intro-control replay-intro" type="button" data-replay-intro>
    <span aria-hidden="true">↻ </span>{replayLabel}
  </button>
</section>

<script>
  const initSpotlightHeroes = () => {
    document.querySelectorAll("[data-spotlight-hero]").forEach((hero) => {
      if (!(hero instanceof HTMLElement) || hero.dataset.initialized === "true") return;
      hero.dataset.initialized = "true";

      const skipButton = hero.querySelector("[data-skip-intro]");
      const replayButton = hero.querySelector("[data-replay-intro]");
      let completionTimer;

      const setNavigationTheme = (theme) => {
        document.body.dataset.themeNav = theme;
      };

      const completeIntro = () => {
        window.clearTimeout(completionTimer);
        hero.classList.remove("is-playing");
        hero.classList.add("is-complete");
        setNavigationTheme("light");
      };

      const playIntro = () => {
        window.clearTimeout(completionTimer);
        hero.classList.remove("is-playing", "is-complete");
        setNavigationTheme("dark");
        void hero.offsetWidth;
        hero.classList.add("is-playing");
        completionTimer = window.setTimeout(completeIntro, 9200);
      };

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        completeIntro();
      } else {
        setNavigationTheme("dark");
        completionTimer = window.setTimeout(completeIntro, 9200);
      }

      skipButton?.addEventListener("click", completeIntro);
      replayButton?.addEventListener("click", playIntro);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSpotlightHeroes, { once: true });
  } else {
    initSpotlightHeroes();
  }
</script>

<style>
  .spotlight-hero {
    --ink: #062e37;
    --mint: #64e6bd;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #050708;
    color: #fff;
    transition: background-color .6s ease;
  }

  .stage-haze {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: .42;
    background:
      radial-gradient(circle at 50% 8%, rgba(134, 175, 171, .16), transparent 32%),
      repeating-radial-gradient(ellipse at 50% 110%, transparent 0 28px, rgba(255,255,255,.018) 29px 30px),
      linear-gradient(180deg, #050708 0%, #071012 62%, #0d1718 100%);
  }

  .spotlight-scene,
  .hero-finale,
  .light-wash {
    position: absolute;
    inset: 0;
  }

  .spotlight-scene {
    z-index: 2;
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .lighting-rig {
    position: absolute;
    top: -1.2rem;
    left: 5%;
    width: 90%;
    height: 2.6rem;
    border-radius: 0 0 30% 30%;
    border-bottom: 1px solid rgba(255,255,255,.14);
    background: linear-gradient(180deg, #000, #121717 70%, #202929);
    box-shadow: 0 8px 25px rgba(0,0,0,.85);
  }

  .lighting-rig span {
    position: absolute;
    top: 1.55rem;
    left: var(--x);
    width: 1.5rem;
    height: .8rem;
    border-radius: 0 0 50% 50%;
    background: #323a3a;
    box-shadow: inset 0 -2px 6px rgba(255,255,255,.09), 0 4px 8px #000;
    transform: translateX(-50%);
  }

  .lighting-rig span:nth-child(1) { --x: 13%; }
  .lighting-rig span:nth-child(2) { --x: 38%; }
  .lighting-rig span:nth-child(3) { --x: 63%; }
  .lighting-rig span:nth-child(4) { --x: 88%; }

  .beam {
    position: absolute;
    top: 1.2rem;
    left: var(--x);
    z-index: 1;
    width: clamp(9rem, 22vw, 24rem);
    height: 76%;
    opacity: 0;
    transform: translateX(-50%);
    transform-origin: 50% 0;
    clip-path: polygon(48% 0, 52% 0, 100% 100%, 0 100%);
    background: linear-gradient(180deg, rgba(var(--beam-color), .8), rgba(var(--beam-color), .19) 68%, rgba(var(--beam-color), 0));
    filter: blur(7px);
    mix-blend-mode: screen;
  }

  .beam i {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 88%, rgba(var(--beam-color), .8), transparent 57%);
    animation: beamBreathe 1.7s ease-in-out infinite alternate;
  }

  .beam-robot, .exhibit-robot { --x: 13%; }
  .beam-laptop, .exhibit-laptop { --x: 38%; }
  .beam-watch, .exhibit-watch { --x: 63%; }
  .beam-telescope, .exhibit-telescope { --x: 88%; }

  .stage-floor {
    position: absolute;
    z-index: 0;
    left: -20%;
    right: -20%;
    bottom: -20%;
    height: 55%;
    transform: rotateX(66deg);
    transform-origin: center top;
    background:
      linear-gradient(rgba(126, 255, 221, .08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(126, 255, 221, .08) 1px, transparent 1px),
      radial-gradient(ellipse at center, #182827, #060a0b 62%);
    background-size: 48px 48px, 48px 48px, auto;
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }

  .exhibit {
    position: absolute;
    z-index: 4;
    left: var(--x);
    bottom: 13%;
    width: clamp(5.2rem, 11vw, 10.5rem);
    height: clamp(11rem, 28vw, 22rem);
    opacity: 0;
    transform: translateX(-50%) translateY(35px) rotateX(-7deg) scale(.78);
    transform-origin: center bottom;
    transform-style: preserve-3d;
  }

  .prop {
    position: absolute;
    left: 50%;
    bottom: 24%;
    width: 100%;
    height: 65%;
    transform: translateX(-50%);
    filter: drop-shadow(0 24px 15px rgba(0,0,0,.65));
    animation: propFloat 2.6s ease-in-out infinite alternate;
  }

  .pedestal {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 112%;
    height: 24%;
    transform: translateX(-50%) perspective(260px) rotateX(4deg);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 7px 7px 2px 2px;
    background: linear-gradient(145deg, #384342, #121918 52%, #293433);
    box-shadow: inset 0 2px 2px rgba(255,255,255,.17), 0 30px 35px rgba(0,0,0,.55);
  }

  .pedestal::after {
    content: "";
    position: absolute;
    top: -5px;
    left: -5%;
    width: 110%;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(255,255,255,.7), rgba(151,255,224,.16) 48%, transparent 72%);
  }

  .pedestal span {
    position: absolute;
    inset: auto .25rem .35rem;
    color: rgba(255,255,255,.66);
    font-size: clamp(.45rem, .65vw, .66rem);
    line-height: 1;
    letter-spacing: .13em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Robot */
  .robot { bottom: 22%; }
  .robot-antenna {
    position: absolute;
    top: 0;
    left: 50%;
    width: 4px;
    height: 18%;
    transform: translateX(-50%);
    border-radius: 4px;
    background: #a5b5af;
  }
  .robot-antenna::before {
    content: "";
    position: absolute;
    top: -5px;
    left: 50%;
    width: 10px;
    height: 10px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #6affcc;
    box-shadow: 0 0 12px #6affcc;
  }
  .robot-head {
    position: absolute;
    top: 14%;
    left: 14%;
    width: 72%;
    height: 26%;
    border: 2px solid #d8e1dc;
    border-radius: 29% 29% 22% 22%;
    background: linear-gradient(145deg, #f7fbf8, #aebbb5 65%, #72827c);
    box-shadow: inset -8px -7px 13px rgba(28,58,51,.35), inset 4px 4px 7px #fff;
  }
  .robot-head::after {
    content: "";
    position: absolute;
    inset: 20% 12%;
    border-radius: 36%;
    background: linear-gradient(145deg, #173334, #071313);
    box-shadow: inset 0 2px 5px rgba(115,255,220,.22);
  }
  .robot-head i {
    position: absolute;
    z-index: 1;
    top: 47%;
    width: 9%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #7bffda;
    box-shadow: 0 0 8px #7bffda;
  }
  .robot-head i:first-child { left: 33%; }
  .robot-head i:last-child { right: 33%; }
  .robot-neck {
    position: absolute;
    top: 39%;
    left: 43%;
    width: 14%;
    height: 9%;
    background: #82938c;
  }
  .robot-body {
    position: absolute;
    top: 46%;
    left: 22%;
    width: 56%;
    height: 31%;
    border-radius: 24% 24% 35% 35%;
    background: linear-gradient(145deg, #f4f8f5, #a6b4ae 64%, #667870);
    box-shadow: inset 5px 4px 6px #fff, inset -8px -6px 10px rgba(15,53,44,.25);
  }
  .robot-body span {
    position: absolute;
    top: 25%;
    left: 50%;
    width: 32%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border: 2px solid #699e8f;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #aaffea, #38caa4 55%, #176e5d);
    box-shadow: 0 0 12px rgba(85,255,211,.5);
  }
  .robot-arm,
  .robot-leg {
    position: absolute;
    border-radius: 999px;
    background: linear-gradient(90deg, #74857e, #dce5df 48%, #798b84);
  }
  .robot-arm { top: 49%; width: 13%; height: 33%; }
  .robot-arm::after,
  .robot-leg::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 130%;
    height: 12%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #dce6e1;
  }
  .arm-left { left: 9%; transform: rotate(8deg); }
  .arm-right { right: 9%; transform: rotate(-8deg); }
  .robot-leg { top: 73%; width: 15%; height: 24%; }
  .leg-left { left: 30%; }
  .leg-right { right: 30%; }

  /* Laptop */
  .laptop { bottom: 17%; height: 53%; transform: translateX(-50%) rotateY(-5deg); }
  .laptop-screen {
    position: absolute;
    inset: 2% 8% 20%;
    overflow: hidden;
    border: 5px solid #aeb9b5;
    border-radius: 7px;
    background:
      radial-gradient(circle at 72% 24%, rgba(108,255,218,.82) 0 8%, transparent 9%),
      linear-gradient(150deg, #173e48, #09212a 58%, #0e1017);
    box-shadow: inset 0 0 25px rgba(62,226,198,.18), 7px 10px 17px rgba(0,0,0,.45);
  }
  .laptop-screen::before {
    content: "";
    position: absolute;
    left: 12%;
    right: 12%;
    top: 22%;
    height: 3px;
    border-radius: 2px;
    background: #88ffde;
    box-shadow: 0 13px 0 rgba(136,255,222,.55), 0 26px 0 rgba(136,255,222,.22);
  }
  .laptop-screen i {
    position: absolute;
    bottom: 12%;
    width: 6%;
    border-radius: 4px 4px 0 0;
    background: #7afad7;
  }
  .laptop-screen i:nth-child(1) { left: 62%; height: 20%; }
  .laptop-screen i:nth-child(2) { left: 72%; height: 35%; }
  .laptop-screen i:nth-child(3) { left: 82%; height: 49%; }
  .laptop-base {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8%;
    height: 18%;
    transform: perspective(130px) rotateX(55deg);
    border-radius: 4px 4px 10px 10px;
    background: linear-gradient(180deg, #eef3ef, #82918b);
    box-shadow: 0 9px 8px rgba(0,0,0,.5);
  }
  .laptop-base span {
    position: absolute;
    top: 22%;
    left: 39%;
    width: 22%;
    height: 34%;
    border: 1px solid rgba(23,56,48,.3);
    border-radius: 2px;
  }

  /* Watch */
  .watch { bottom: 18%; height: 63%; transform: translateX(-50%) rotate(-9deg); }
  .watch-strap {
    position: absolute;
    top: 0;
    left: 34%;
    width: 32%;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #111918, #475852 48%, #101817);
    box-shadow: inset 3px 0 5px rgba(255,255,255,.12), inset -4px 0 5px #050706;
  }
  .watch-strap::after {
    content: "";
    position: absolute;
    inset: 8% 25%;
    background: repeating-radial-gradient(circle, #7b8984 0 2px, transparent 3px 12px);
  }
  .watch-face {
    position: absolute;
    top: 31%;
    left: 18%;
    width: 64%;
    height: 39%;
    border: 5px solid #c5d0cb;
    border-radius: 29%;
    background: radial-gradient(circle at 38% 28%, #264b46, #061211 60%);
    box-shadow: inset 3px 4px 5px rgba(116,255,220,.18), 8px 10px 16px rgba(0,0,0,.5);
  }
  .watch-face span {
    position: absolute;
    top: 29%;
    left: 12%;
    color: #9affdf;
    font-size: clamp(.55rem, 1.1vw, 1rem);
    font-weight: 500;
    letter-spacing: .04em;
    text-shadow: 0 0 10px rgba(101,255,215,.65);
  }
  .watch-face i {
    position: absolute;
    left: 13%;
    bottom: 16%;
    width: 72%;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, #77fbd6 0 35%, rgba(119,251,214,.2) 36%);
  }
  .watch-crown {
    position: absolute;
    top: 42%;
    right: 11%;
    width: 8%;
    height: 14%;
    border-radius: 0 4px 4px 0;
    background: #81908a;
  }

  /* Telescope */
  .telescope { bottom: 17%; height: 64%; transform: translateX(-50%); }
  .telescope-tube {
    position: absolute;
    top: 10%;
    left: 1%;
    width: 102%;
    height: 24%;
    transform: rotate(-18deg);
    border-radius: 999px 27% 27% 999px;
    background: linear-gradient(180deg, #dce6e1, #75877f 48%, #344740 67%, #bcc8c2);
    box-shadow: inset 0 5px 6px rgba(255,255,255,.6), 8px 12px 16px rgba(0,0,0,.45);
  }
  .telescope-tube::before {
    content: "";
    position: absolute;
    left: -5%;
    top: -10%;
    width: 17%;
    height: 120%;
    border-radius: 35%;
    background: linear-gradient(90deg, #162d29, #9eb0a9 70%);
  }
  .telescope-tube i {
    position: absolute;
    right: -4%;
    top: -11%;
    width: 18%;
    height: 122%;
    border-radius: 30%;
    background: linear-gradient(90deg, #5d6f68, #d7e2dd);
  }
  .telescope-tube span {
    position: absolute;
    left: 34%;
    top: 30%;
    width: 24%;
    height: 40%;
    border-radius: 4px;
    background: #133d37;
    box-shadow: inset 0 0 6px #68eac5;
  }
  .telescope-joint {
    position: absolute;
    top: 34%;
    left: 42%;
    width: 20%;
    aspect-ratio: 1;
    border: 4px solid #b7c3bd;
    border-radius: 50%;
    background: radial-gradient(circle, #83f5d5 0 15%, #2b4640 17% 58%, #73857e 60%);
  }
  .telescope-leg {
    position: absolute;
    top: 46%;
    left: 49%;
    width: 7%;
    height: 52%;
    transform-origin: center top;
    border-radius: 4px;
    background: linear-gradient(90deg, #53645e, #c3cec9 55%, #45564f);
  }
  .telescope .leg-a { transform: rotate(20deg); }
  .telescope .leg-b { transform: rotate(-20deg); }
  .telescope .leg-c { transform: translateX(-1px) scaleY(.94); }

  .stage-counter {
    position: absolute;
    z-index: 8;
    left: 50%;
    bottom: 5%;
    display: flex;
    gap: .45rem;
    transform: translateX(-50%);
  }
  .stage-counter i {
    width: 1.8rem;
    height: 2px;
    overflow: hidden;
    background: rgba(255,255,255,.16);
  }
  .stage-counter i::after {
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    transform: translateX(-101%);
    background: #a7ffe5;
  }

  .light-wash {
    z-index: 5;
    opacity: 0;
    transform: scale(.08);
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 38%, rgba(243,255,251,.98) 55%, rgba(197,255,236,.58) 72%, transparent 74%);
    filter: blur(18px);
    pointer-events: none;
  }

  .hero-finale {
    z-index: 6;
    display: grid;
    place-items: center;
    overflow: hidden;
    opacity: 0;
    color: var(--ink);
    background:
      radial-gradient(circle at 82% 17%, rgba(100,230,189,.2), transparent 22%),
      radial-gradient(circle at 10% 86%, rgba(113,185,255,.12), transparent 28%),
      #fff;
    pointer-events: none;
  }

  .finale-copy {
    position: relative;
    z-index: 2;
    width: min(90vw, 76rem);
    padding: 8rem 1rem 7rem;
    text-align: center;
  }

  .finale-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .65rem;
    margin-bottom: clamp(1.1rem, 2.5vw, 2rem);
    color: #276254;
    font-size: clamp(.7rem, 1vw, .9rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .finale-eyebrow span {
    width: .55rem;
    height: .55rem;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 6px rgba(100,230,189,.18), 0 0 20px rgba(55,210,161,.5);
  }
  .finale-copy h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--ink);
    font-family: 'Manrope', sans-serif;
    font-size: clamp(4rem, 11vw, 10.5rem);
    font-weight: 600;
    line-height: .77;
    letter-spacing: -.075em;
  }
  .title-gosim {
    position: relative;
    z-index: 1;
    font-size: .39em;
    line-height: 1;
    letter-spacing: .34em;
    transform: translateX(.17em);
  }
  .title-spotlight {
    position: relative;
    background: linear-gradient(92deg, #073a42 5%, #0b7966 48%, #59d3ac 74%, #093c44 98%);
    background-size: 180% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 12px 30px rgba(31,128,104,.13));
    animation: titleShimmer 4.5s linear infinite;
  }
  .title-spotlight::after {
    content: "";
    position: absolute;
    left: 9%;
