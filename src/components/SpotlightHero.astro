---
interface Props {
  subtitle: string;
  eyebrow: string;
  sceneLabel: string;
  exploreLabel: string;
  announcement: {
    label: string;
    title: string;
    link: string;
  };
}

const {
  subtitle,
  eyebrow,
  sceneLabel,
  exploreLabel,
  announcement,
} = Astro.props;
---

<section
  class="spotlight-hero is-playing"
  data-spotlight-hero
  data-bg-section="header-home"
  aria-label={sceneLabel}
>
  <div class="spotlight-scene" aria-hidden="true"></div>

  <div class="hero-finale">
    <div class="finale-copy">
      <p class="finale-eyebrow"><span></span>{eyebrow}</p>
      <a
        class="finale-logo-link"
        href="https://gosim.org"
        aria-label="Visit the GOSIM website"
      >
        <img
          class="finale-logo"
          src="/images/gosim-logo-official.svg"
          alt="GOSIM"
          width="255"
          height="72"
        />
      </a>
      <h1 class="finale-wordmark">
        <img
          src="/images/spotlight-navbar-logo.svg"
          alt="Spotlight"
          width="124"
          height="35"
        />
      </h1>
      <p class="finale-subtitle">{subtitle}</p>
      <a href={announcement.link} class="finale-announcement">
        <span class="announcement-pulse"></span>
        <span class="announcement-copy">
          <span class="announcement-label">{announcement.label}</span>
          <strong>{announcement.title}</strong>
        </span>
        <span class="shape-icon shape-icon--arrow shape-icon--up-right announcement-icon" aria-hidden="true"></span>
      </a>
    </div>

    <a class="explore-cue" href="#about">
      <span>{exploreLabel}</span>
      <span class="explore-icon" aria-hidden="true"><span class="shape-icon shape-icon--arrow shape-icon--down"></span></span>
    </a>
  </div>

</section>

<script>
  const initSpotlightHeroes = () => {
    document.querySelectorAll("[data-spotlight-hero]").forEach((hero) => {
      if (!(hero instanceof HTMLElement) || hero.dataset.initialized === "true") return;
      hero.dataset.initialized = "true";
      document.body.dataset.themeNav = "light";
      document.body.dataset.spotlightIntro = "playing";

      let completionTimer;
      let alignmentObserver;
      const wordmark = hero.querySelector(".finale-wordmark img");

      const alignSpotlightToWordmark = () => {
        if (!(wordmark instanceof HTMLImageElement)) return;

        const heroBounds = hero.getBoundingClientRect();
        const wordmarkBounds = wordmark.getBoundingClientRect();
        if (!heroBounds.width || !heroBounds.height || !wordmarkBounds.width || !wordmarkBounds.height) return;

        const focusX = ((wordmarkBounds.left + wordmarkBounds.width / 2 - heroBounds.left) / heroBounds.width) * 100;
        const focusY = ((wordmarkBounds.top + wordmarkBounds.height / 2 - heroBounds.top) / heroBounds.height) * 100;
        hero.style.setProperty("--focus-x", `${focusX}%`);
        hero.style.setProperty("--focus-y", `${focusY}%`);
      };

      alignSpotlightToWordmark();
      window.requestAnimationFrame(alignSpotlightToWordmark);

      if ("ResizeObserver" in window && wordmark instanceof HTMLImageElement) {
        alignmentObserver = new ResizeObserver(alignSpotlightToWordmark);
        alignmentObserver.observe(hero);
        alignmentObserver.observe(wordmark);
      }

      const completeIntro = () => {
        window.clearTimeout(completionTimer);
        alignmentObserver?.disconnect();
        hero.classList.remove("is-playing");
        hero.classList.add("is-complete");
        document.body.dataset.spotlightIntro = "complete";
      };

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        completeIntro();
      } else {
        completionTimer = window.setTimeout(completeIntro, 1750);
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSpotlightHeroes, { once: true });
  } else {
    initSpotlightHeroes();
  }
</script>

<style>
  @property --spot-x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 76%;
  }

  @property --spot-y {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 30%;
  }

  @property --spot-radius {
    syntax: '<length>';
    inherits: false;
    initial-value: 1px;
  }

  .spotlight-hero {
    --ink: #062e37;
    --mint: #64e6bd;
    --focus-x: 35%;
    --focus-y: 52%;
    --focus-radius: min(34vw, 26rem);
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #050708;
    color: #fff;
    font-family: 'Manrope', sans-serif;
    transition: background-color .6s ease;
  }

  .spotlight-scene,
  .hero-finale {
    position: absolute;
    inset: 0;
  }

  .spotlight-scene {
    --spot-x: 76%;
    --spot-y: 30%;
    --spot-radius: 1px;
    z-index: 7;
    background: var(--color-dark, #043e5d);
    -webkit-mask-image: radial-gradient(
      circle at var(--spot-x) var(--spot-y),
      transparent 0 calc(var(--spot-radius) - 28px),
      rgba(0, 0, 0, .16) calc(var(--spot-radius) - 20px),
      rgba(0, 0, 0, .52) calc(var(--spot-radius) - 9px),
      #000 var(--spot-radius)
    );
    mask-image: radial-gradient(
      circle at var(--spot-x) var(--spot-y),
      transparent 0 calc(var(--spot-radius) - 28px),
      rgba(0, 0, 0, .16) calc(var(--spot-radius) - 20px),
      rgba(0, 0, 0, .52) calc(var(--spot-radius) - 9px),
      #000 var(--spot-radius)
    );
    pointer-events: none;
  }

  :global(body[data-spotlight-intro="playing"] .main-nav-bar .has-sublinks svg) {
    stroke: var(--color-dark, #043e5d) !important;
  }

  :global(body[data-spotlight-intro="playing"] .main-nav-bar) {
    pointer-events: none;
  }

  .hero-finale {
    z-index: 6;
    display: grid;
    place-items: stretch;
    overflow: hidden;
    opacity: 1;
    color: var(--ink);
    background: #f8f9f6;
    pointer-events: none;
  }

  .finale-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: min(86vw, 78rem);
    margin: 0 auto;
    padding: clamp(8rem, 15vh, 10rem) 0 clamp(7rem, 13vh, 9rem);
    text-align: left;
  }

  .finale-eyebrow {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: .65rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: #315b52;
    font-size: clamp(.75rem, .82vw, .84rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: .13em;
    text-wrap: balance;
    text-transform: uppercase;
  }
  .finale-eyebrow span {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: none;
  }
  .finale-wordmark {
    margin-top: clamp(1.15rem, 2vw, 1.75rem);
    line-height: 0;
  }
  .finale-wordmark img {
    display: block;
    width: clamp(19rem, 38vw, 39rem);
    height: auto;
    filter: brightness(0) saturate(100%) invert(15%) sepia(25%) saturate(1227%) hue-rotate(139deg) brightness(91%) contrast(99%);
  }

  .finale-logo {
    width: clamp(8rem, 11vw, 10.5rem);
    height: auto;
    filter: brightness(0) saturate(100%) invert(17%) sepia(23%) saturate(1179%) hue-rotate(135deg) brightness(91%) contrast(96%);
  }
  .finale-logo-link {
    display: inline-flex;
    width: max-content;
    line-height: 0;
    pointer-events: auto;
  }
  .finale-subtitle {
    max-width: 38rem;
    margin: clamp(1.5rem, 3vw, 2.4rem) 0 0;
    color: #46605d;
    font-size: clamp(1.05rem, 1.3vw, 1.22rem);
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .finale-announcement {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    width: min(100%, 48rem);
    max-width: 100%;
    margin-top: clamp(1.75rem, 3.5vw, 3rem);
    padding: 1.15rem 1.25rem;
    border: 1px solid #df3c18;
    border-radius: 0;
    color: #102b2e;
    background: #ff5a36;
    box-shadow: 0 0.75rem 2rem rgba(6, 46, 55, .14);
    font-size: clamp(.9rem, 1vw, 1rem);
    font-weight: 700;
    line-height: 1.45;
    text-decoration: none;
    text-align: left;
    text-wrap: balance;
    pointer-events: auto;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .finale-announcement:hover {
    transform: translateY(-3px);
    border-color: #bd2e0d;
    box-shadow: 0 1rem 2.5rem rgba(6, 46, 55, .2);
  }
  .announcement-pulse {
    flex: 0 0 auto;
    width: .58rem;
    height: .58rem;
    border-radius: 50%;
    background: #102b2e;
    box-shadow: 0 0 0 .35rem rgba(16, 43, 46, .12);
  }
  .announcement-copy {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-direction: column;
    gap: .2rem;
  }
  .announcement-label {
    font-size: .65rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .announcement-copy strong {
    font-size: clamp(1.05rem, 1.45vw, 1.4rem);
    font-weight: 780;
    line-height: 1.3;
    letter-spacing: -.015em;
  }
  .finale-announcement .announcement-icon {
    flex: 0 0 auto;
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: #102b2e;
    font-style: normal;
    font-size: .95rem;
  }

  .explore-cue {
    position: absolute;
    z-index: 3;
    bottom: 2.2rem;
    left: 7%;
    display: flex;
    align-items: center;
    gap: .6rem;
    transform: none;
    color: rgba(6,46,55,.65);
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-decoration: none;
    text-transform: uppercase;
    pointer-events: auto;
  }
  .explore-cue .explore-icon {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 1px solid rgba(6,46,55,.19);
    border-radius: 50%;
    font-style: normal;
    animation: none;
  }

  .is-playing .spotlight-scene { animation: circularReveal 1.55s .08s cubic-bezier(.32,.78,.2,1) both; }
  .is-playing .hero-finale a { pointer-events: none; }

  .is-complete {
    background: #fff;
  }
  .is-complete .spotlight-scene {
    opacity: 0;
    visibility: hidden;
  }
  .is-complete .hero-finale,
  .is-complete .finale-copy,
  .is-complete .explore-cue {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    animation: none;
  }
  @keyframes circularReveal {
    0%, 7% {
      --spot-x: 76%;
      --spot-y: 30%;
      --spot-radius: 1px;
    }
    43%, 61% {
      --spot-x: var(--focus-x);
      --spot-y: var(--focus-y);
      --spot-radius: var(--focus-radius);
    }
    100% {
      --spot-x: var(--focus-x);
      --spot-y: var(--focus-y);
      --spot-radius: 160vmax;
    }
  }
  @keyframes cueBounce { 50% { transform: translateY(4px); } }

  @media (max-width: 720px) {
    .spotlight-hero {
      --focus-x: 46%;
      --focus-y: 50%;
      --focus-radius: min(45vw, 12rem);
      min-height: max(100svh, 40rem);
    }
    .finale-copy {
      width: 88vw;
      padding: 7rem 0 6.5rem;
    }
    .finale-eyebrow {
      font-size: .72rem;
      letter-spacing: .1em;
    }
    .finale-wordmark img { width: min(80vw, 28rem); }
    .finale-logo { width: 7.5rem; }
    .finale-subtitle { font-size: 1rem; }
    .finale-announcement {
      gap: .85rem;
      padding: 1rem;
    }
    .announcement-pulse { display: none; }
    .announcement-copy strong { font-size: 1rem; }
    .finale-announcement .announcement-icon {
      width: 2.4rem;
      height: 2.4rem;
      margin-left: auto;
    }
    .explore-cue { bottom: 1.35rem; }
  }

  @media (max-height: 700px) and (min-width: 721px) {
    .finale-copy { padding-top: 6rem; }
    .finale-wordmark img { width: min(34rem, 43vw); }
    .finale-subtitle { margin-top: 1.3rem; }
    .finale-announcement { margin-top: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight-hero { background: #fff; }
    .spotlight-scene { display: none; }
    .hero-finale,
    .finale-copy,
    .explore-cue {
      opacity: 1;
      transform: none;
      animation: none !important;
      pointer-events: auto;
    }
    .explore-cue .explore-icon { animation: none; }
  }
</style>
