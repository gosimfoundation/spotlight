---
interface Props {
  subtitle: string;
  eyebrow: string;
  sceneLabel: string;
  skipLabel: string;
  replayLabel: string;
  exploreLabel: string;
  announcement: {
    text: string;
    link: string;
  };
}

const {
  subtitle,
  eyebrow,
  sceneLabel,
  skipLabel,
  replayLabel,
  exploreLabel,
  announcement,
} = Astro.props;
---

<section
  class="spotlight-hero is-playing"
  data-spotlight-hero
  data-bg-section="header-home"
  aria-label={sceneLabel}
>
  <div class="spotlight-scene" aria-hidden="true"></div>

  <div class="hero-finale">
    <div class="finale-copy">
      <p class="finale-eyebrow"><span></span>{eyebrow}</p>
      <img
        class="finale-logo"
        src="/images/gosim-logo-official.svg"
        alt="GOSIM"
        width="255"
        height="72"
      />
      <h1>Spotlight</h1>
      <p class="finale-subtitle">{subtitle}</p>
      <a href={announcement.link} class="finale-announcement">
        <span class="announcement-pulse"></span>
        <span>{announcement.text}</span>
        <i aria-hidden="true">↗</i>
      </a>
    </div>

    <a class="explore-cue" href="#about">
      <span>{exploreLabel}</span>
      <i aria-hidden="true">↓</i>
    </a>
  </div>

  <button class="intro-control skip-intro" type="button" data-skip-intro>
    {skipLabel}<span aria-hidden="true"> →</span>
  </button>
  <button class="intro-control replay-intro" type="button" data-replay-intro>
    <span aria-hidden="true">↻ </span>{replayLabel}
  </button>
</section>

<script>
  const initSpotlightHeroes = () => {
    document.querySelectorAll("[data-spotlight-hero]").forEach((hero) => {
      if (!(hero instanceof HTMLElement) || hero.dataset.initialized === "true") return;
      hero.dataset.initialized = "true";
      document.body.dataset.themeNav = "light";
      document.body.dataset.spotlightIntro = "playing";

      const skipButton = hero.querySelector("[data-skip-intro]");
      const replayButton = hero.querySelector("[data-replay-intro]");
      let completionTimer;

      const completeIntro = () => {
        window.clearTimeout(completionTimer);
        hero.classList.remove("is-playing");
        hero.classList.add("is-complete");
        document.body.dataset.spotlightIntro = "complete";
      };

      const playIntro = () => {
        window.clearTimeout(completionTimer);
        hero.classList.remove("is-playing", "is-complete");
        document.body.dataset.spotlightIntro = "playing";
        void hero.offsetWidth;
        hero.classList.add("is-playing");
        completionTimer = window.setTimeout(completeIntro, 2700);
      };

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        completeIntro();
      } else {
        completionTimer = window.setTimeout(completeIntro, 2700);
      }

      skipButton?.addEventListener("click", completeIntro);
      replayButton?.addEventListener("click", playIntro);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSpotlightHeroes, { once: true });
  } else {
    initSpotlightHeroes();
  }
</script>

<style>
  @property --spot-x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 76%;
  }

  @property --spot-y {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 30%;
  }

  @property --spot-radius {
    syntax: '<length>';
    inherits: false;
    initial-value: 1px;
  }

  .spotlight-hero {
    --ink: #062e37;
    --mint: #64e6bd;
    --focus-x: 28%;
    --focus-y: 52%;
    --focus-radius: min(34vw, 26rem);
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #050708;
    color: #fff;
    font-family: 'Manrope', sans-serif;
    transition: background-color .6s ease;
  }

  .spotlight-scene,
  .hero-finale {
    position: absolute;
    inset: 0;
  }

  .spotlight-scene {
    --spot-x: 76%;
    --spot-y: 30%;
    --spot-radius: 1px;
    z-index: 7;
    background: var(--color-dark, #043e5d);
    -webkit-mask-image: radial-gradient(
      circle at var(--spot-x) var(--spot-y),
      transparent 0 calc(var(--spot-radius) - 28px),
      rgba(0, 0, 0, .16) calc(var(--spot-radius) - 20px),
      rgba(0, 0, 0, .52) calc(var(--spot-radius) - 9px),
      #000 var(--spot-radius)
    );
    mask-image: radial-gradient(
      circle at var(--spot-x) var(--spot-y),
      transparent 0 calc(var(--spot-radius) - 28px),
      rgba(0, 0, 0, .16) calc(var(--spot-radius) - 20px),
      rgba(0, 0, 0, .52) calc(var(--spot-radius) - 9px),
      #000 var(--spot-radius)
    );
    pointer-events: none;
  }

  :global(body[data-spotlight-intro="playing"] .main-nav-bar .has-sublinks svg) {
    stroke: var(--color-dark, #043e5d) !important;
  }

  :global(body[data-spotlight-intro="playing"] .main-nav-bar) {
    pointer-events: none;
  }

  :global(body[data-spotlight-intro="playing"] .main-nav-bar .lang-current),
  :global(body[data-spotlight-intro="playing"] .main-nav-bar .lang-current:hover) {
    color: var(--color-dark, #043e5d);
    border-color: var(--color-dark, #043e5d);
    background: var(--color-dark, #043e5d);
  }

  :global(body[data-spotlight-intro="playing"] .main-nav-bar .nav-actions .btn .btn-fill) {
    background: var(--color-dark, #043e5d) !important;
  }

  :global(body[data-spotlight-intro="playing"] .main-nav-bar .nav-actions .btn span) {
    color: var(--color-dark, #043e5d) !important;
  }

  .hero-finale {
    z-index: 6;
    display: grid;
    place-items: stretch;
    overflow: hidden;
    opacity: 1;
    color: var(--ink);
    background: #f8f9f6;
    pointer-events: none;
  }

  .finale-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: min(86vw, 78rem);
    margin: 0 auto;
    padding: clamp(8rem, 15vh, 10rem) 0 clamp(7rem, 13vh, 9rem);
    text-align: left;
  }

  .finale-eyebrow {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: .65rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: #315b52;
    font-size: clamp(.75rem, .82vw, .84rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: .13em;
    text-wrap: balance;
    text-transform: uppercase;
  }
  .finale-eyebrow span {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: none;
  }
  .finale-copy h1 {
    margin-top: clamp(1.15rem, 2vw, 1.75rem);
    color: var(--ink);
    font-family: 'Manrope', sans-serif;
    font-size: clamp(4.2rem, 10vw, 9rem);
    font-weight: 600;
    line-height: .92;
    letter-spacing: -.055em;
  }

  .finale-logo {
    width: clamp(8rem, 11vw, 10.5rem);
    height: auto;
    filter: brightness(0) saturate(100%) invert(17%) sepia(23%) saturate(1179%) hue-rotate(135deg) brightness(91%) contrast(96%);
  }
  .finale-subtitle {
    max-width: 38rem;
    margin: clamp(1.5rem, 3vw, 2.4rem) 0 0;
    color: #46605d;
    font-size: clamp(1.05rem, 1.3vw, 1.22rem);
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .finale-announcement {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    width: min(100%, 42rem);
    max-width: 100%;
    margin-top: clamp(1.75rem, 3.5vw, 3rem);
    padding: 1rem 0;
    border-top: 1px solid rgba(11,54,56,.22);
    border-bottom: 1px solid rgba(11,54,56,.22);
    border-radius: 0;
    color: #174c40;
    background: transparent;
    box-shadow: none;
    font-size: clamp(.8rem, .95vw, .92rem);
    font-weight: 600;
    line-height: 1.45;
    text-decoration: none;
    text-align: left;
    text-wrap: balance;
    pointer-events: auto;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .finale-announcement:hover {
    transform: none;
    border-color: rgba(11,54,56,.55);
    box-shadow: none;
  }
  .announcement-pulse {
    flex: 0 0 auto;
    width: .42rem;
    height: .42rem;
    border-radius: 50%;
    background: #48d2a5;
    box-shadow: none;
  }
  .finale-announcement i {
    flex: 0 0 auto;
    font-style: normal;
    font-size: 1rem;
  }

  .explore-cue {
    position: absolute;
    z-index: 3;
    bottom: 2.2rem;
    left: 7%;
    display: flex;
    align-items: center;
    gap: .6rem;
    transform: none;
    color: rgba(6,46,55,.65);
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-decoration: none;
    text-transform: uppercase;
    pointer-events: auto;
  }
  .explore-cue i {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 1px solid rgba(6,46,55,.19);
    border-radius: 50%;
    font-style: normal;
    animation: none;
  }

  .intro-control {
    position: absolute;
    z-index: 12;
    right: clamp(1.1rem, 3vw, 2.5rem);
    bottom: clamp(1.1rem, 3vw, 2.5rem);
    padding: .65rem .9rem;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 999px;
    color: rgba(255,255,255,.78);
    background: rgba(5,10,10,.22);
    backdrop-filter: blur(10px);
    font: inherit;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color .2s ease, background .2s ease, transform .2s ease;
  }
  .intro-control:hover {
    color: #fff;
    background: rgba(255,255,255,.1);
    transform: translateY(-2px);
  }
  .replay-intro {
    opacity: 0;
    visibility: hidden;
    color: rgba(6,46,55,.7);
    border-color: rgba(6,46,55,.15);
    background: transparent;
  }
  .replay-intro:hover {
    color: var(--ink);
    background: #fff;
  }

  .is-playing .spotlight-scene { animation: circularReveal 2.35s .12s cubic-bezier(.4,0,.18,1) both; }
  .is-playing .hero-finale a { pointer-events: none; }
  .is-playing .skip-intro { animation: controlExit .2s 1.8s ease forwards; }

  .is-complete {
    background: #fff;
  }
  .is-complete .spotlight-scene,
  .is-complete .skip-intro {
    opacity: 0;
    visibility: hidden;
  }
  .is-complete .hero-finale,
  .is-complete .finale-copy,
  .is-complete .explore-cue {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    animation: none;
  }
  .is-complete .replay-intro {
    opacity: 1;
    visibility: visible;
  }

  @keyframes circularReveal {
    0%, 7% {
      --spot-x: 76%;
      --spot-y: 30%;
      --spot-radius: 1px;
    }
    48%, 68% {
      --spot-x: var(--focus-x);
      --spot-y: var(--focus-y);
      --spot-radius: var(--focus-radius);
    }
    100% {
      --spot-x: var(--focus-x);
      --spot-y: var(--focus-y);
      --spot-radius: 160vmax;
    }
  }
  @keyframes controlExit { to { opacity: 0; visibility: hidden; } }
  @keyframes cueBounce { 50% { transform: translateY(4px); } }

  @media (max-width: 720px) {
    .spotlight-hero {
      --focus-x: 43%;
      --focus-y: 51%;
      --focus-radius: min(45vw, 12rem);
      min-height: max(100svh, 40rem);
    }
    .finale-copy {
      width: 88vw;
      padding: 7rem 0 6.5rem;
    }
    .finale-eyebrow {
      font-size: .72rem;
      letter-spacing: .1em;
    }
    .finale-copy h1 { font-size: clamp(3.45rem, 17vw, 6rem); }
    .finale-logo { width: 7.5rem; }
    .finale-subtitle { font-size: 1rem; }
    .finale-announcement {
      align-items: flex-start;
      padding: .9rem 0;
    }
    .finale-announcement i { margin-left: auto; }
    .explore-cue { bottom: 1.35rem; }
    .intro-control { bottom: 1.1rem; }
    .is-complete .replay-intro { bottom: auto; top: 6rem; }
  }

  @media (max-height: 700px) and (min-width: 721px) {
    .finale-copy { padding-top: 6rem; }
    .finale-copy h1 { font-size: clamp(4rem, 12vh, 7rem); }
    .finale-subtitle { margin-top: 1.3rem; }
    .finale-announcement { margin-top: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight-hero { background: #fff; }
    .spotlight-scene,
    .skip-intro { display: none; }
    .hero-finale,
    .finale-copy,
    .explore-cue {
      opacity: 1;
      transform: none;
      animation: none !important;
      pointer-events: auto;
    }
    .explore-cue i { animation: none; }
  }
</style>
