---
import type { Locale } from "../i18n/translations";

interface Props { locale: Locale; }
const { locale } = Astro.props;

const content = {
  zh: {
    title: "AI视觉创意大赛“瓦卡奖”",
    subtitle: "全球 AI 视觉创作赛事与交流平台",
    description: "瓦卡奖（VACAT）聚焦人工智能视觉创作与创新应用，发掘优秀 AI 视觉创意作品，连接全球创作者、艺术家、技术专家与产业机构。",
    format: "一赛、一汇、一坊",
    activities: ["AI视觉创意大赛", "AI视觉创意汇", "AI视觉工作坊"],
    hosts: "2026 年第三届由深圳市龙岗区人民政府、上海电影股份有限公司与抖音联合主办。",
    link: "查看赛事介绍",
    imageAlt: "第三届AI视觉创意大赛瓦卡奖宣传横幅：盛大起航",
  },
  en: {
    title: "AI Visual Creativity Competition — VACAT Awards",
    subtitle: "A global competition and exchange platform for AI visual creation",
    description: "VACAT highlights AI visual creativity and innovative applications, discovering outstanding work and connecting creators, artists, technical experts, and industry organisations worldwide.",
    format: "Competition, forum, and workshop",
    activities: ["AI Visual Creativity Competition", "AI Visual Creativity Forum", "AI Visual Workshop"],
    hosts: "The third edition in 2026 is jointly organised by Shenzhen’s Longgang District Government, Shanghai Film Co., Ltd., and Douyin.",
    link: "Explore the competition",
    imageAlt: "Launch banner for the third AI Visual Creativity Competition, the VACAT Awards",
  },
  fr: {
    title: "Concours de création visuelle par IA — Prix VACAT",
    subtitle: "Un concours mondial et une plateforme d’échange pour la création visuelle par IA",
    description: "VACAT met en lumière la création visuelle par IA et ses applications innovantes, révèle des œuvres remarquables et réunit créateurs, artistes, experts techniques et acteurs de l’industrie du monde entier.",
    format: "Concours, forum et atelier",
    activities: ["Concours de création visuelle par IA", "Forum de création visuelle par IA", "Atelier visuel IA"],
    hosts: "La troisième édition, en 2026, est organisée conjointement par le gouvernement du district de Longgang à Shenzhen, Shanghai Film Co., Ltd. et Douyin.",
    link: "Découvrir le concours",
    imageAlt: "Bannière de lancement de la troisième édition du concours de création visuelle par IA, les prix VACAT",
  },
};

const c = content[locale];
---

<section class="vacat-showcase" id="vacat" data-theme-section="light" data-bg-section="light" aria-labelledby="vacat-title">
  <div class="vacat-shell">
    <div class="vacat-intro">
      <div class="vacat-copy">
        <p class="vacat-eyebrow">VACAT · 2026</p>
        <h2 id="vacat-title">{c.title}</h2>
        <p class="vacat-subtitle">{c.subtitle}</p>
        <p class="vacat-description">{c.description}</p>
        <a class="vacat-link" href="https://www.lg.gov.cn/gab/zwdt/content/post_12890791.html" target="_blank" rel="noopener noreferrer">
          {c.link}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span>
        </a>
      </div>
      <img class="vacat-image" src="/images/shenzhen2026/vacat-2026.jpeg" alt={c.imageAlt} width="2494" height="1412" loading="lazy" decoding="async" />
    </div>
    <div class="vacat-format">
      <h3>{c.format}</h3>
      <ul>
        {c.activities.map((activity) => <li>{activity}</li>)}
      </ul>
    </div>
    <p class="vacat-hosts">{c.hosts}</p>
  </div>
</section>

<style>
  .vacat-showcase {
    color: #171918;
    background: #fffdf8;
    border-bottom: 1px solid #171918;
    padding: clamp(48px, 5.5vw, 84px) 0;
    font-family: "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif;
    scroll-margin-top: 130px;
  }
  .vacat-shell { width: min(1440px, calc(100% - 96px)); margin: 0 auto; }
  .vacat-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  .vacat-copy { min-width: 0; }
  .vacat-eyebrow { margin: 0 0 16px; color: #40596d; font-size: 14px; font-weight: 800; letter-spacing: .13em; }
  .vacat-copy h2 { margin: 0; font-size: clamp(28px, 3vw, 44px); font-weight: 700; line-height: 1.25; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .vacat-subtitle { margin: 18px 0 0; font-size: 18px; font-weight: 650; line-height: 1.6; }
  .vacat-description { margin: 16px 0 0; color: #5e625f; font-size: 16px; line-height: 1.8; }
  .vacat-link { display: inline-flex; align-items: center; gap: 10px; margin-top: 24px; padding-bottom: 4px; border-bottom: 1px solid currentColor; color: #171918; font-size: 14px; font-weight: 800; line-height: 1.5; text-decoration: none; }
  .vacat-link:hover { color: #a53a22; }
  .vacat-link:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .vacat-link .shape-icon { width: 11px; height: 11px; flex-shrink: 0; }
  .vacat-image { display: block; width: 100%; height: auto; border: 1px solid rgba(23,25,24,.2); }
  .vacat-format { margin-top: 36px; padding-top: 28px; border-top: 1px solid rgba(23,25,24,.22); }
  .vacat-format h3 { margin: 0 0 20px; font-size: 18px; font-weight: 750; line-height: 1.5; }
  .vacat-format ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .vacat-format li { padding-left: 16px; border-left: 3px solid #40596d; font-size: 17px; font-weight: 650; line-height: 1.6; }
  .vacat-hosts { margin: 28px 0 0; color: #5e625f; font-size: 14px; line-height: 1.8; }
  @media (max-width: 1100px) { .vacat-shell { width: calc(100% - 56px); } }
  @media (max-width: 960px) { .vacat-intro { grid-template-columns: 1fr; } .vacat-image { grid-row: 1; } }
  @media (max-width: 760px) {
    .vacat-shell { width: calc(100% - 32px); }
    .vacat-copy h2 { font-size: clamp(26px, 6vw, 34px); }
    .vacat-subtitle { font-size: 17px; }
    .vacat-format ul { grid-template-columns: 1fr; gap: 16px; }
    .vacat-format { margin-top: 28px; }
  }
</style>
