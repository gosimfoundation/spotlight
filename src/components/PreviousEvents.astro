---
// Packages
import { Picture } from 'astro:assets';

interface Props {
	title: string,
    events?: Array<{
        title: string,
        date: string,
        description: string,
        image: any,
        link: string,
    }>,
}

const { title, events } = Astro.props;
const count = events?.length ?? 0;
---

<section
    class="section section-resources-featured"
    data-theme-section="light"
    data-bg-section="lightgray"
>
    <div class="container">
        <div class="row">
            <div class="col">
                <h2>{title}</h2>
            </div>
        </div>

        <div
            class={`flickity-slider-group three-col count-${count}`}
            data-flickity-slider-type="cards"
        >
            <div class="flickity-carousel">
                {events?.map((loop) => (
                    <div class="flickity-slide">
                        <a
                            href={loop.link}
                            target={loop.link.startsWith("http") ? "_blank" : "_self"}
                            class="single-resources-card"
                        >
                            <div class="card-row card-row-image">
                                <div class="card-image">
                                    {loop?.image &&
                                        <Picture
                                            src={loop.image}
                                            formats={['webp', 'jpg']}
                                            alt={loop.title}
                                            widths={[225, 450, 600, 1000]}
                                            sizes="(max-width: 480px) 55vw, 500px"
                                        />
                                    }
                                </div>
                            </div>
                            <div class="card-row card-row-info">
                                <h4 style="padding-bottom: 16px;">{loop.title}</h4>
                                <p class="dateb">{loop.date}</p>
                                <p>{loop.description}</p>
                            </div>
                        </a>
                    </div>
                ))}
            </div>
            <div class="flickity-controls">
                <button class="flickity-arrow" data-flickity-control="prev" disabled aria-label="Previous">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </button>
                <button class="flickity-arrow" data-flickity-control="next" aria-label="Next">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>

<style>
  .flickity-arrow {
    border: none;
    outline: none;
    cursor: pointer;
  }
  .card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .card-image :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
