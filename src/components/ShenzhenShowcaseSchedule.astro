---
import { shenzhenSelectedProjects, shenzhenSelectionCopy, shenzhenShowcaseDays, shenzhenShowcaseTime, getShenzhenShowcaseSchedule } from "../data/shenzhen-selection";
import type { Locale } from "../i18n/translations";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = shenzhenSelectionCopy[locale];
const copy = {
  zh: {
    title: "Spotlight 演讲日程",
    introduction: "以下演讲在 GOSIM Shenzhen 2026 大会现场举行。",
    conferenceLink: "GOSIM Shenzhen 2026 大会官网",
    projectCount: "个路演项目",
  },
  en: {
    title: "Spotlight presentation schedule",
    introduction: "These talks take place on site at GOSIM Shenzhen 2026.",
    conferenceLink: "GOSIM Shenzhen 2026 conference website",
    projectCount: "presenting projects",
  },
  fr: {
    title: "Programme des présentations Spotlight",
    introduction: "Ces présentations ont lieu sur place, lors de GOSIM Shenzhen 2026.",
    conferenceLink: "Site de la conférence GOSIM Shenzhen 2026",
    projectCount: "projets présentés",
  },
}[locale];
const conferenceUrl = locale === "zh" ? "https://shenzhen2026.gosim.org/zh/" : "https://shenzhen2026.gosim.org/";
const days = shenzhenShowcaseDays.map((day) => ({ ...day, projects: getShenzhenShowcaseSchedule(day.day) }));
---

<section class="roadshow-schedule" id="schedule" data-theme-section="light" data-bg-section="light" aria-labelledby="showcase-schedule-title">
  <div class="schedule-shell">
    <div class="schedule-head">
      <div>
        <p class="schedule-eyebrow">SPOTLIGHT / GOSIM SHENZHEN 2026</p>
        <h2 id="showcase-schedule-title">{copy.title}</h2>
        <p class="schedule-introduction">{copy.introduction}</p>
      </div>
      <a class="schedule-conference-link" href={conferenceUrl} target="_blank" rel="noopener noreferrer">
        {copy.conferenceLink}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span>
      </a>
    </div>
    <div class="schedule-days">
      {days.map((day) => (
        <section class="schedule-day" data-showcase-day={day.day} aria-labelledby={`showcase-day-${day.day}`}>
          <h3 id={`showcase-day-${day.day}`}>{day.label[locale]} · <time datetime={day.date}>{day.dateLabel[locale]}</time></h3>
          <p class="schedule-day-time">{c.showcaseTime}</p>
          <p class="schedule-day-room">{c.showcaseRoom} · {day.projects.length} {copy.projectCount}</p>
          <table class="showcase-agenda">
            <caption>{c.showcaseSchedule}</caption>
            <thead><tr><th scope="col">{c.scheduleTime}</th><th scope="col">{c.scheduleProject}</th></tr></thead>
            <tbody>
              <tr class="showcase-introduction">
                <td>{shenzhenShowcaseTime.startTime}–{shenzhenShowcaseTime.introductionEndTime}</td>
                <th scope="row">{c.showcaseIntro}</th>
              </tr>
              {day.projects.map(({ project, startTime, endTime }) => (
                <tr>
                  <td><time datetime={`${day.date}T${startTime}:00+08:00`}>{startTime}</time>–<time datetime={`${day.date}T${endTime}:00+08:00`}>{endTime}</time></td>
                  <th scope="row"><a href={`#selected-project-${shenzhenSelectedProjects.indexOf(project) + 1}`}>{project.name}</a></th>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .roadshow-schedule { padding: clamp(48px, 5.5vw, 84px) 0; color: #171918; background: #fffdf8; border-bottom: 1px solid #171918; font-family: "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif; scroll-margin-top: 130px; }
  .schedule-shell { width: min(1440px, calc(100% - 96px)); margin: 0 auto; }
  .schedule-head { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 24px 48px; }
  .schedule-head > div { flex: 1 1 600px; }
  .schedule-eyebrow { margin: 0 0 14px; color: #40596d; font-size: 13px; font-weight: 800; letter-spacing: .08em; }
  .schedule-head h2 { margin: 0; color: #171918; font-size: clamp(2rem, 3.4vw, 3.4rem); font-weight: 700; line-height: 1.2; letter-spacing: -.025em; }
  .schedule-introduction { max-width: 850px; margin: 18px 0 0; color: #5e625f; font-size: 16px; line-height: 1.7; }
  .schedule-conference-link { display: inline-flex; align-items: center; gap: 20px; padding: 14px 18px; border: 1px solid #171918; color: #171918; font-size: 14px; font-weight: 750; line-height: 1.5; text-decoration: none; }
  .schedule-days { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; align-items: start; margin-top: 36px; }
  .schedule-day { min-width: 0; padding: 24px; border: 1px solid rgba(23,25,24,.3); background: #fff; }
  .schedule-day h3 { margin: 0; color: #171918; font-size: clamp(1.3rem, 2vw, 1.7rem); font-weight: 750; line-height: 1.4; }
  .schedule-day-time, .schedule-day-room { margin: 10px 0 0; color: #5e625f; font-size: 13px; line-height: 1.6; }
  .schedule-day-room { margin-top: 2px; }
  .showcase-agenda { width: 100%; margin: 20px 0 0; border-collapse: collapse; color: #171918; font-size: 14px; line-height: 1.5; }
  .showcase-agenda caption { padding: 0 0 12px; color: #40596d; font-weight: 800; text-align: left; }
  .showcase-agenda th, .showcase-agenda td { padding: 10px 12px; border-bottom: 1px solid rgba(23,25,24,.14); text-align: left; }
  .showcase-agenda thead th { background: rgba(64,89,109,.06); color: #5e625f; font-size: 12px; font-weight: 750; }
  .showcase-agenda td { width: 145px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .showcase-agenda tbody th { font-weight: 650; }
  .showcase-introduction { background: rgba(255,67,26,.04); }
  .showcase-agenda a { color: inherit; text-decoration: none; }
  .showcase-agenda a:hover { text-decoration: underline; }
  .roadshow-schedule a:hover { color: #a53a22; border-color: #a53a22; }
  .roadshow-schedule a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .roadshow-schedule .shape-icon { width: 11px; height: 11px; flex-shrink: 0; }
  @media (max-width: 1100px) { .schedule-shell { width: calc(100% - 56px); } .schedule-days { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .schedule-shell { width: calc(100% - 32px); } .schedule-day { padding: 20px 12px; } .showcase-agenda th, .showcase-agenda td { padding: 10px 8px; } .showcase-agenda td { width: 120px; } }
</style>
