---
import Layout from "layouts/Layout.astro";
import ShenzhenSelectedProjects from "./ShenzhenSelectedProjects.astro";
import ShenzhenDeadlines from "./ShenzhenDeadlines.astro";
import { shenzhenSelectionCopy } from "../data/shenzhen-selection";
import type { Locale } from "../i18n/translations";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const selection = shenzhenSelectionCopy[locale];
const content = {
  zh: {
    topicLabel: "本届主题 / TOPIC",
    topicTitle: "下一代 AI 原生产品",
    topicText: "围绕真实用户需求，探索新颖的 Agentic 用户体验：让 Agent 理解情境、调用工具并完成任务。",
    tags: ["真实用户问题", "Agent 完成任务", "可交互原型", "产品体验"],
    directionsTitle: "原征集方向",
    forms: [["自研智能硬件", "将摄像头、麦克风、传感器与 Agent 融入同一套交互，创造新的产品体验。"], ["现有设备与跨设备系统", "改造、整合现有设备，连接手表、智能眼镜、手机与电脑，让 Agent 跨设备接续任务。"]],
    materialsTitle: "原报名材料与时间",
    materials: ["团队与项目简介", "目标用户、使用场景与问题", "Agent 的核心工作与差异", "可访问原型与一分钟演示", "深圳目标、支持需求与开源计划"],
    formatTitle: "计划流程与项目支持",
    stages: [["线上项目评选", "通过申请材料和可体验原型了解用户、场景及产品实现。"], ["深圳集中共创", "围绕关键流程，提供产品、软件、硬件和演示辅导。"], ["GOSIM 现场展示", "通过项目展位、大会演讲与演示，连接开发者、产业伙伴和开源社区。"]],
    support: "入选项目可获得项目曝光、交流合作机会和前往深圳的差旅支持。",
    judgingTitle: "原评审与开源要求",
    judgingText: "60% 看产品价值和 AI 用户体验，40% 看原型是否真实、稳定、可验证。",
    openText: "线上海选不强制开源，但必须提供可验证原型；入选后原则上开放核心代码、原型或主要成果。涉及商业代码、硬件设计或隐私时可申请合理豁免。",
    faqTitle: "原征集常见问题",
    faqs: [["一定要做硬件吗？", "原征集要求为自研智能硬件，或改造、整合现有设备的项目（含跨设备系统），并提供可体验原型。"], ["只有概念可以申请吗？", "原申请要求至少提供能验证关键体验的交互原型。"], ["报名什么时候截止？", "海外申请已于 2026 年 9 月 13 日截止；中国国内申请已于 2026 年 10 月 4 日截止。两者均为北京时间 23:59（UTC+8）。现已停止提交。"]],
  },
  en: {
    topicLabel: "THIS EDITION / TOPIC",
    topicTitle: "Next-generation AI-native products",
    topicText: "Explore new agentic user experiences around real needs: agents that understand context, use tools, and complete tasks.",
    tags: ["Real user needs", "Agents completing tasks", "Interactive prototypes", "Product experience"],
    directionsTitle: "Original project directions",
    forms: [["New intelligent hardware", "Bring cameras, microphones, sensors, and agents into one interaction to create new product experiences."], ["Existing devices and cross-device systems", "Adapt and integrate devices such as watches, smart glasses, phones, and computers so agents can continue tasks across them."]],
    materialsTitle: "Original application materials & schedule",
    materials: ["Team and project introduction", "Target users, context, and problem", "Core agent work and differentiation", "Accessible prototype and one-minute demo", "Shenzhen goals, support needs, and open-source plans"],
    formatTitle: "Program format & project support",
    stages: [["Online project selection", "Review application materials and interactive prototypes to understand users, context, and implementation."], ["Shenzhen sprint", "Product, software, hardware, and demo guidance focused on the essential user journey."], ["GOSIM showcase", "Project booths, conference talks, and demos connect teams with developers, industry partners, and open-source communities."]],
    support: "Selected projects receive visibility, collaboration opportunities, and travel support to Shenzhen.",
    judgingTitle: "Original judging & open-source requirements",
    judgingText: "60% evaluates product value and AI user experience; 40% evaluates whether the prototype is real, stable, and verifiable.",
    openText: "Online selection required a verifiable prototype without mandatory open-sourcing. Selected projects are expected to open their core code, prototype, or main results, with reasonable exemptions for commercial code, hardware designs, or privacy.",
    faqTitle: "Original open-call FAQ",
    faqs: [["Was hardware required?", "The original call required new intelligent hardware or adapted and integrated existing devices, including cross-device systems, with an interactive prototype."], ["Were concepts alone eligible?", "The original application required an interactive prototype demonstrating the essential experience."], ["When did applications close?", "International applications closed on September 13, 2026; China applications closed on October 4, 2026, both at 23:59 Beijing time (UTC+8). Submissions are now closed."]],
  },
  fr: {
    topicLabel: "CETTE ÉDITION / THÈME",
    topicTitle: "Produits natifs IA de nouvelle génération",
    topicText: "Explorer de nouvelles expériences agentiques répondant à des besoins réels : comprendre le contexte, utiliser des outils et accomplir des tâches.",
    tags: ["Besoins réels", "Tâches accomplies par les agents", "Prototypes interactifs", "Expérience produit"],
    directionsTitle: "Orientations initiales",
    forms: [["Nouveaux appareils intelligents", "Réunir caméras, microphones, capteurs et agents dans une interaction pour créer de nouvelles expériences produit."], ["Appareils existants et systèmes multi-appareils", "Adapter et intégrer montres, lunettes intelligentes, téléphones et ordinateurs pour poursuivre les tâches entre appareils."]],
    materialsTitle: "Dossier et calendrier initiaux",
    materials: ["Présentation de l’équipe et du projet", "Utilisateurs, contexte et problème", "Travail de l’agent et différenciation", "Prototype accessible et démo d’une minute", "Objectifs à Shenzhen, besoins et plan open source"],
    formatTitle: "Déroulement et soutien",
    stages: [["Sélection en ligne", "Étude des dossiers et prototypes interactifs pour comprendre les utilisateurs, le contexte et la réalisation."], ["Accélération à Shenzhen", "Accompagnement produit, logiciel, matériel et démonstration autour du parcours essentiel."], ["Présentation GOSIM", "Stands, conférences et démonstrations pour rencontrer développeurs, partenaires et communautés open source."]],
    support: "Les projets sélectionnés bénéficient de visibilité, d’occasions de collaboration et d’un soutien au voyage à Shenzhen.",
    judgingTitle: "Critères initiaux et open source",
    judgingText: "60 % pour la valeur produit et l’expérience IA ; 40 % pour un prototype réel, stable et vérifiable.",
    openText: "La sélection en ligne exigeait un prototype vérifiable sans ouverture obligatoire du code. Les projets sélectionnés doivent ouvrir leur code central, leur prototype ou leurs principaux résultats, avec des exemptions raisonnables.",
    faqTitle: "FAQ de l’appel initial",
    faqs: [["Le matériel était-il requis ?", "L’appel initial demandait un appareil intelligent original ou l’adaptation et l’intégration d’appareils existants, avec un prototype interactif."], ["Un concept seul était-il accepté ?", "Le dossier initial exigeait un prototype interactif démontrant l’expérience essentielle."], ["Quand les candidatures ont-elles fermé ?", "Les candidatures internationales ont fermé le 13 septembre 2026 et les candidatures chinoises le 4 octobre 2026, à 23 h 59, heure de Pékin (UTC+8). Les candidatures sont closes."]],
  },
} as const;
const c = content[locale];
---

<Layout title={`Spotlight Shenzhen 2026 · ${selection.topic}`} description={selection.description} navDarkMode={false} navBackground="header-home" pageTransitionName="Spotlight Shenzhen 2026" socialImage="/images/shenzhen2026/og-shenzhen-film.png" locale={locale} nativeScroll={true} footerVariant="spotlight">
  <div class="shenzhen-results-page">
    <ShenzhenSelectedProjects locale={locale} />
    <section class="topic-section" id="about" data-theme-section="light" aria-labelledby="topic-title">
      <div class="program-shell topic-layout">
        <div>
          <p class="topic-label">{c.topicLabel}</p>
          <h2 id="topic-title">{c.topicTitle}</h2>
        </div>
        <div>
          <p class="topic-text">{c.topicText}</p>
          <ul class="topic-tags">{c.tags.map((tag) => <li>{tag}</li>)}</ul>
        </div>
      </div>
    </section>
    <section class="archive-section" data-theme-section="light">
      <div class="program-shell">
        <details class="program-archive" id="program-archive">
          <summary><span>{selection.archive}</span><span class="archive-toggle" aria-hidden="true">+</span></summary>
          <div class="archive-content">
            <p class="archive-intro"><strong>{selection.status}</strong> · {selection.archiveIntro}</p>
            <div class="archive-group" id="directions">
              <h3>{c.directionsTitle}</h3>
              <dl>{c.forms.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
            </div>
            <div class="archive-group" id="submission">
              <h3>{c.materialsTitle}</h3>
              <ul>{c.materials.map((material) => <li>{material}</li>)}</ul>
              <div class="archived-schedule"><ShenzhenDeadlines locale={locale} /></div>
            </div>
            <div class="archive-group" id="format">
              <h3>{c.formatTitle}</h3>
              <dl>{c.stages.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
              <p>{c.support}</p>
            </div>
            <div class="archive-group" id="judging">
              <h3>{c.judgingTitle}</h3>
              <p>{c.judgingText}</p>
              <p>{c.openText}</p>
            </div>
            <div class="archive-group" id="faq">
              <h3>{c.faqTitle}</h3>
              {c.faqs.map(([question, answer]) => <details class="archive-faq"><summary>{question}</summary><p>{answer}</p></details>)}
            </div>
          </div>
        </details>
      </div>
    </section>
  </div>
</Layout>

<style>
  .shenzhen-results-page { color: #171918; background: #f4f3ef; font-family: "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif; }
  .program-shell { width: min(1200px, calc(100% - 96px)); margin: 0 auto; }
  .topic-section { padding: 38px 0; border-block: 1px solid #d7d8d1; background: #e7edf1; scroll-margin-top: 90px; }
  .topic-layout { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 40px; align-items: center; }
  .topic-label { margin: 0 0 12px; color: #40596d; font-size: 12px; font-weight: 800; letter-spacing: .1em; }
  .topic-layout h2 { margin: 0; color: #171918; font-size: clamp(24px, 2.5vw, 34px); line-height: 1.25; font-weight: 650; letter-spacing: -.035em; }
  .topic-text { margin: 0; color: #454846; font-size: 16px; line-height: 1.65; }
  .topic-tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 16px 0 0; list-style: none; }
  .topic-tags li { padding: 5px 9px; border: 1px solid #b8c3cb; color: #40596d; font-size: 12px; line-height: 1.4; }
  .archive-section { padding: 24px 0 48px; }
  .program-archive { border: 1px solid #d7d8d1; background: #fafaf7; }
  .program-archive > summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; color: #5e625f; font-size: 15px; font-weight: 700; cursor: pointer; list-style: none; }
  .program-archive > summary::-webkit-details-marker { display: none; }
  .program-archive > summary:hover { color: #171918; background: #edf0e9; }
  summary:focus-visible { outline: 3px solid #a53a22; outline-offset: 3px; }
  .archive-toggle { font-size: 24px; line-height: 1; }
  .program-archive[open] > summary .archive-toggle { transform: rotate(45deg); }
  .archive-content { padding: 0 32px 24px; border-top: 1px solid #d7d8d1; color: #5e625f; font-size: 14px; line-height: 1.65; }
  .archive-intro { margin: 20px 0; }
  .archive-intro strong { color: #455b43; }
  .archive-group { padding-block: 18px; border-top: 1px solid #d7d8d1; }
  .archive-group h3 { margin: 0 0 12px; color: #454846; font-size: 18px; font-weight: 700; }
  .archive-group p { margin: 10px 0; }
  .archive-group ul { padding-left: 20px; list-style: disc; }
  .archive-group dl { display: grid; gap: 12px; margin: 0; }
  .archive-group dt { color: #454846; font-weight: 700; }
  .archive-group dd { margin: 4px 0 0 16px; }
  .archived-schedule { max-width: 650px; margin-top: 20px; padding: 16px; background: #40596d; }
  .archive-faq { border-bottom: 1px solid #d7d8d1; }
  .archive-faq > summary { padding-block: 10px; cursor: pointer; }
  .archive-faq p { padding-left: 16px; }
  @media (max-width: 760px) {
    .program-shell { width: calc(100% - 40px); }
    .topic-layout { grid-template-columns: 1fr; gap: 18px; }
    .topic-text { font-size: 14px; }
    .program-archive > summary { padding: 16px; font-size: 14px; }
    .archive-content { padding: 0 20px 16px; }
    .archived-schedule { padding: 8px; }
  }
</style>
