    capabilities: [["Voix", "Commander le produit en langage naturel"], ["Multimodal", "Comprendre caméra, micro, écran et capteurs"], ["Mémoire longue", "Conserver préférences, historique et contexte"], ["Outils", "Appeler recherche, apps, services et matériel"], ["UI dynamique", "Générer ou adapter l’interface à la tâche"], ["Multi-appareils", "Continuer sur téléphone, montre et robot"], ["Service proactif", "Rappeler, planifier et exécuter spontanément"]],
    formatKicker: "05 / FORMAT",
    formatTitle: "Sélection en ligne → Accélération à Shenzhen → Démonstration finale",
    formatText: "La première étape valide l’idée, l’expérience et la capacité d’exécution à faible coût. La seconde concentre les ressources pour finaliser ou améliorer un prototype réel.",
    stages: [["01", "Sélection en ligne", "Valider valeur, expérience et faisabilité", "Prototype interactif, courte vidéo et plan de réalisation"], ["02", "Accélération à Shenzhen", "Environ deux jours pour construire et affiner", "Produit fonctionnel avec soutien logiciel, matériel et mentorat"], ["03", "Démonstration finale", "Présenter la prochaine génération de produits IA", "Visibilité, prix, promotion et opportunités d’incubation"]],
    submitKicker: "04 / SOUMISSION EN LIGNE",
    submitTitle: "Pas un appel à idées.\nUne validation de l’expérience produit.",
    submitText: "Téléphone, site web ou appareil existant peuvent porter le prototype. Aucun matériel coûteux n’est requis au départ, mais l’expérience doit être claire et réalisable. Les concepts uniquement textuels ne seront en principe pas retenus.",
    materialsTitle: "À soumettre",
    materials: [["Présentation", "Public, scénario, problème et valeur"], ["Expérience Agent", "Comment l’Agent remplace ou repense le parcours"], ["Prototype interactif", "Web, Figma, app, simulateur ou appareil réel"], ["Vidéo de démo", "Moins d’une minute recommandé, avec le parcours complet"], ["Plan sur place", "Ce que l’équipe peut terminer si elle est retenue"], ["Besoins et preuves", "Soutiens demandés, liens, builds, captures ou vidéos"]],
    questionsTitle: "Chaque projet doit répondre",
    questions: ["Pourquoi ne peut-il pas être une application ordinaire ?", "Quel rôle essentiel joue l’Agent ?", "Comment améliore-t-il l’expérience grand public existante ?", "Que pouvez-vous terminer sur place ?", "De quel soutien avez-vous besoin ?"],
    toolkitTitle: "Kit de prototypage officiel",
    toolkitText: "Coques d’interface téléphone, montre et appareil avec écran, exemples Agent OS, guide de software factory et projets de référence pour valider rapidement une expérience.",
    accelerateKicker: "06 / ACCÉLÉRATION À SHENZHEN",
    accelerateTitle: "Transformer une bonne idée en produit crédible et fonctionnel",
    accelerateText: "Les équipes retenues participent à environ deux jours de construction avant la conférence. Les produits complets peaufinent leur expérience ; les autres reçoivent un soutien ciblé en logiciel, matériel ou narration.",
    support: [["Aide au prototype", "Jusqu’à l’équivalent de 100 $US remboursés par projet"], ["Logiciels", "Crédits modèles, outils et software factory"], ["Soutien technique", "Assistants, ingénieurs et accompagnement sur place"], ["Fabrication", "Impression 3D, pièces de base et espace d’assemblage"], ["Espace", "Bureau à Shenzhen ou lieu de collaboration désigné"], ["Coaching démo", "Narration, déroulé et présentation"]],
    budgetTitle: "Dépenses éligibles",
    budget: ["Téléphones Android et cartes RK3566 / RK3576 / RK3588", "Rabbit R1, montres intelligentes et robots", "Caméras, réseaux de micros, écrans et capteurs", "Circuits, impression 3D, coques et pièces mécaniques", "Appels modèles, outils et services logiciels nécessaires"],
    budgetNote: "Remboursement sur dépenses réelles ; le surplus reste à la charge de l’équipe. Dépenser plus n’est pas un avantage. L’organisation accompagne, mais l’équipe reste responsable du résultat.",
    judgingKicker: "07 / ÉVALUATION",
    judgingTitle: "Valeur produit et réalisation comptent autant",
    judgingText: "La note finale combine l’avis du jury et des points objectifs de réalisation. Le matériel ajoute des points, mais ne suffit pas pour gagner.",
    subjective: "Évaluation du jury",
    objective: "Réalisation objective",
    subjectiveItems: [["Valeur produit et cas d’usage", "15%"], ["Expérience native Agent", "15%"], ["UX et design d’interaction", "15%"], ["Innovation", "10%"], ["Coût et capacité de diffusion", "5%"]],
    objectiveItems: ["Prototype web fonctionnel", "Application mobile installable", "Intégration ou modification d’appareil", "Structure sur mesure / imprimée en 3D", "Intégration logiciel-matériel", "Capacités clés d’Agent OS", "Produit complet réalisé en autonomie"],
    judgingNote: "Une interaction banale avec peu de valeur Agent ne sera pas bien notée simplement grâce à une coque fabriquée.",
    awardsTitle: "Prix envisagés",
    awards: ["Meilleur projet Spotlight", "Meilleure application Agent OS", "Meilleur design produit", "Meilleure réalisation technique", "Meilleur prototype matériel", "Meilleur potentiel commercial", "Prix du jury"],
    openKicker: "08 / RÉSULTATS & OPEN SOURCE",
    openTitle: "Du prototype crédible au résultat public",
    openStages: [["Sélection en ligne", "Open source facultatif, mais prototype vérifiable"], ["Après sélection", "Code central, prototype ou résultat principal à ouvrir en principe"], ["Démonstration finale", "Dépôt public, page projet ou méthode de publication claire"]],
    openNote: "Des dérogations raisonnables sont possibles pour code commercial tiers, design matériel ou données personnelles. Les meilleurs projets pourront bénéficier de la promotion et de l’incubation GOSIM.",
    faqKicker: "09 / FAQ",
    faqTitle: "Questions fréquentes",
    faqs: [["Faut-il construire du matériel ?", "Non. Un excellent produit logiciel peut gagner. Le matériel améliore la fidélité, mais l’expérience et la valeur Agent priment."], ["Agent OS officiel est-il obligatoire ?", "Non. Il ouvre le prix dédié ; les autres solutions sont acceptées avec une interaction système ou native Agent."], ["Une idée seule suffit-elle ?", "Non. La première étape exige un prototype visuel, interactif ou vérifiable."], ["Peut-on participer avec peu de compétences techniques ?", "Oui. Les projets au design fort peuvent recevoir un soutien logiciel et technique sur place, tout en restant responsables du résultat."], ["Quel lien avec le hackathon ?", "Ce sont deux programmes parallèles. Spotlight privilégie le produit grand public et l’expérience ; le hackathon se concentre davantage sur les software factories, Agent OS et l’implémentation."], ["Quand ouvrent les candidatures ?", "Le formulaire est en préparation. Les boutons en haut et en bas de cette page seront mis à jour dès son ouverture."]],
    applyEyebrow: "READY TO BUILD THE NEXT INTERFACE?",
    applyTitle: "Transformer le prochain produit IA\nen une expérience à essayer",
    applyText: "Le formulaire est en préparation. Commencez dès maintenant à affiner votre scénario, prototype interactif et démo d’une minute.",
    applyButton: "Candidatures bientôt ouvertes",
    applyHint: "Le formulaire sera disponible ici",
    conference: "Visiter GOSIM Shenzhen 2026",
  },
} as const;

const c = content[locale] || content.en;
const sectionTitle = (text: string) => text.split("\n");
---

<Layout
  title={c.metaTitle}
  description={c.metaDesc}
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Spotlight Shenzhen 2026"
  locale={locale}
>
  <div class="spotlight-page">
    <section class="sz-hero" id="top" data-theme-section="dark">
      <video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
        <source src="/videos/shenzhen-spotlight-hero.mp4" type="video/mp4" />
      </video>
      <div class="hero-colorwash"></div>
      <div class="hero-scrim"></div>
      <div class="hero-grid"></div>

      <div class="spotlight-container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow light">{c.eyebrow}</p>
          <h1>{c.heroTitle}<br /><span>{c.heroAccent}</span></h1>
          <p class="hero-lede">{c.heroText}</p>
          <div class="hero-actions">
            <a class="spot-button primary" href="#about">{c.heroPrimary}<span aria-hidden="true">↓</span></a>
            <a class="spot-button ghost" href="#apply" aria-describedby="application-note">{c.heroSecondary}</a>
          </div>
          <p class="application-note" id="application-note"><span></span>{c.heroNote}</p>
        </div>

        <div class="agent-console" aria-label="Agent experience concept">
          <div class="console-top">
            <div class="console-dots"><i></i><i></i><i></i></div>
            <span>{c.agentLabel}</span>
          </div>
          <div class="console-body">
            <div class="user-bubble">“{c.agentPrompt}”</div>
            <div class="agent-state">
              <div class="agent-orb"><span>AI</span></div>
              <div>
                <small>{c.agentContext}</small>
                <p>{c.agentStatus}</p>
              </div>
            </div>
            <ol class="agent-flow">
              {c.agentSteps.map((step, index) => <li class={index < c.agentSteps.length - 1 ? "done" : "active"}><span>{String(index + 1).padStart(2, "0")}</span>{step}</li>)}
            </ol>
          </div>
        </div>
      </div>

      <div class="spotlight-container hero-meta">
        {c.meta.map((item) => <div>{item}</div>)}
      </div>
    </section>

    <section class="signal-strip" aria-label={c.signalLabel}>
      <div class="spotlight-container signal-inner">
        <div>
          <p class="eyebrow">{c.signalLabel}</p>
          <h2>{c.signalTitle}</h2>
        </div>
        <div class="signal-tags">{c.signalTags.map((tag) => <span>{tag}</span>)}</div>
      </div>
    </section>

    <section class="spot-section definition" id="about">
      <div class="spotlight-container">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">{c.definitionKicker}</p>
            <h2>{sectionTitle(c.definitionTitle).map((line) => <>{line}<br /></>)}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.definitionText}</p>
            <img
              class="section-sticker sticker-core"
              src="/images/shenzhen2026/agent-core-sticker.png"
              alt=""
              width="1254"
              height="1254"
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
          </div>
        </div>

        <div class="quick-fact-grid">
          {c.quickFacts.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{item[0]}</p>
              <h3>{item[1]}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="spot-section directions" id="directions" data-theme-section="dark">
      <div class="spotlight-container">
        <div class="section-head split-head light-head">
          <div>
            <p class="eyebrow light">{c.directionsKicker}</p>
            <h2>{c.directionsTitle}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.directionsText}</p>
            <img
              class="section-sticker sticker-consumer"
              src="/images/shenzhen2026/consumer-scenes-sticker.png"
              alt=""
              width="1254"
              height="1254"
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
          </div>
        </div>

        <div class="direction-grid">
          {c.directions.map((item) => (
            <article>
              <span>{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p>
            </article>
          ))}
        </div>

        <div class="direction-footer">
          <div>
            <p class="eyebrow light">{c.principlesTitle}</p>
            <div class="principle-strip">
            {c.principles.map((item, index) => (
                <article><span>{index + 1}</span><div><h4>{item[0]}</h4><p>{item[1]}</p></div></article>
            ))}
            </div>
          </div>
          <div class="form-summary">
            <p class="eyebrow light">{c.formsTitle}</p>
            {c.forms.map((item) => <article><h3>{item[0]}</h3><p>{item[1]}</p></article>)}
          </div>
        </div>
      </div>
    </section>

    <section class="spot-section agent-os" id="agent-os">
      <div class="spotlight-container os-grid">
        <div class="os-copy">
          <p class="eyebrow">{c.osKicker}</p>
          <h2>{sectionTitle(c.osTitle).map((line) => <>{line}<br /></>)}</h2>
          <p class="section-intro">{c.osText}</p>
          <blockquote>{c.osRule}</blockquote>
          <img
            class="section-sticker sticker-os"
            src="/images/shenzhen2026/agent-os-sticker.png"
            alt=""
            width="1254"
            height="1254"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </div>
        <div class="capability-grid">
          {c.capabilities.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item[0]}</h3>
              <p>{item[1]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="spot-section submission" id="submission" data-theme-section="dark">
      <div class="spotlight-container">
        <div class="section-head split-head light-head">
          <div>
            <p class="eyebrow light">{c.submitKicker}</p>
            <h2>{sectionTitle(c.submitTitle).map((line) => <>{line}<br /></>)}</h2>
          </div>
          <p class="section-intro">{c.submitText}</p>
        </div>

        <h3 class="subheading">{c.materialsTitle}</h3>
        <div class="material-grid">
          {c.materials.map((item, index) => (
            <article><span>{String(index + 1).padStart(2, "0")}</span><div><h4>{item[0]}</h4><p>{item[1]}</p></div></article>
          ))}
        </div>

        <div class="submission-notes">
          <details class="questions-card">
            <summary><h3>{c.questionsTitle}</h3><i aria-hidden="true">+</i></summary>
            <ol>{c.questions.map((question, index) => <li><span>{index + 1}</span><p>{question}</p></li>)}</ol>
          </details>
          <div class="toolkit-card">
            <div class="toolkit-mark">KIT</div>
            <div><h3>{c.toolkitTitle}</h3><p>{c.toolkitText}</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="spot-section format" id="format">
      <div class="spotlight-container">
        <div class="section-head center-head">
          <p class="eyebrow">{c.formatKicker}</p>
          <h2>{c.formatTitle}</h2>
          <p class="section-intro">{c.formatText}</p>
        </div>
        <div class="stage-grid">
          {c.stages.map((stage, index) => (
            <article class="stage-card">
              <div class="stage-top"><span>{stage[0]}</span>{index < 2 && <i aria-hidden="true">→</i>}</div>
              <h3>{stage[1]}</h3>
              <strong>{stage[2]}</strong>
              <p>{stage[3]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="spot-section accelerate" id="support">
      <div class="spotlight-container">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">{c.accelerateKicker}</p>
            <h2>{c.accelerateTitle}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.accelerateText}</p>
            <img
              class="section-sticker sticker-prototype"
              src="/images/shenzhen2026/prototype-sprint-sticker.png"
              alt=""
              width="1254"
              height="1254"
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
          </div>
        </div>
        <div class="support-grid">
          {c.support.map((item, index) => (
            <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>
          ))}
        </div>
        <details class="budget-panel">
          <summary><span>{c.budgetTitle}</span><i aria-hidden="true">+</i></summary>
          <div class="budget-body"><ul>{c.budget.map((item) => <li>{item}</li>)}</ul><p>{c.budgetNote}</p></div>
        </details>
      </div>
    </section>

    <section class="spot-section judging" id="judging">
      <div class="spotlight-container">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">{c.judgingKicker}</p>
            <h2>{c.judgingTitle}</h2>
          </div>
          <p class="section-intro">{c.judgingText}</p>
        </div>

        <div class="score-grid">
          <article class="score-card subjective-card">
            <div class="score-header"><div class="score-ring ring-60"><strong>60</strong><small>%</small></div><h3>{c.subjective}</h3></div>
            <div class="score-lines">
              {c.subjectiveItems.map((item) => <div><span>{item[0]}</span><strong>{item[1]}</strong></div>)}
            </div>
          </article>
          <article class="score-card objective-card">
            <div class="score-header"><div class="score-ring ring-40"><strong>40</strong><small>%</small></div><h3>{c.objective}</h3></div>
            <ul>{c.objectiveItems.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
        <blockquote class="judging-note">“{c.judgingNote}”</blockquote>

        <div class="awards-wrap">
          <p class="eyebrow">{c.awardsTitle}</p>
          <div class="award-grid">{c.awards.map((award, index) => <div><span>{String(index + 1).padStart(2, "0")}</span>{award}</div>)}</div>
        </div>
        <div class="outcome-note" id="outcomes">
          <div><p class="eyebrow">{c.openKicker}</p><h3>{c.openTitle}</h3></div>
          <p>{c.openNote}</p>
        </div>
      </div>
    </section>

    <section class="spot-section faq-section" id="faq">
      <div class="spotlight-container faq-layout">
        <div class="faq-title"><p class="eyebrow">{c.faqKicker}</p><h2>{c.faqTitle}</h2></div>
        <div class="faq-list">
          {c.faqs.slice(0, 5).map((faq) => (
            <details>
              <summary><span>{faq[0]}</span><i aria-hidden="true">+</i></summary>
              <p>{faq[1]}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="apply-section" id="apply" data-theme-section="dark">
      <div class="apply-glow"></div>
      <div class="spotlight-container apply-inner">
        <p class="eyebrow light">{c.applyEyebrow}</p>
        <h2>{sectionTitle(c.applyTitle).map((line) => <>{line}<br /></>)}</h2>
        <p>{c.applyText}</p>
        <div class="apply-actions">
          <button type="button" disabled>{c.applyButton}<span aria-hidden="true">↗</span></button>
