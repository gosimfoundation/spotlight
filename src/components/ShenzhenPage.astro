    pillars: [["Agent OS", "Socle logiciel et interaction recommandé"], ["Agent IA", "Cœur intelligent du produit"], ["Interface", "Support de base de l’expérience"], ["Matériel", "Forme qui augmente la fidélité"], ["Expérience produit", "Objet principal de l’évaluation"]],
    shiftTitle: "Le changement de paradigme recherché",
