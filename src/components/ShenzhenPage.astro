    principles: [["Thèse de catégorie", "Redéfinir une frontière produit plutôt qu’optimiser une fonction"], ["Natif Agent", "Sans l’Agent, la valeur centrale disparaît"], ["Système complet", "Matériel, logiciel, modèles et interaction expriment une même conviction"], ["Potentiel mondial", "Résoudre un problème important sur un marché extensible"]],
    formsTitle: "Toutes les formes sont possibles",
    optionLabel: "OPTION",
    forms: [["Créer un matériel intelligent original", "Façonnez un appareil par impression 3D ou CNC, puis réunissez caméra, microphones, capteurs et Agent dans une même interaction pour créer une nouvelle expérience agentique."], ["Connecter des systèmes multi-appareils", "Reliez montres open source, lunettes intelligentes, téléphones et ordinateurs pour poursuivre une tâche entre appareils."], ["Créer un logiciel natif IA", "App mobile, produit desktop ou site web : l’Agent doit réellement accomplir la tâche."]],
    formatKicker: "04 / FORMAT",
    formatTitle: ["Sélection en ligne", "Accélération à Shenzhen", "Démonstration finale"],
    formatText: "La première étape valide l’idée, l’expérience et la capacité d’exécution à faible coût. La seconde concentre les ressources pour finaliser ou améliorer un prototype réel.",
    stages: [["01", "Sélection en ligne", "Valider valeur, expérience et faisabilité", "Prototype interactif, courte vidéo et plan de réalisation"], ["02", "Accélération à Shenzhen", "Environ deux jours pour construire et affiner", "Produit fonctionnel avec soutien logiciel, matériel et mentorat"], ["03", "Présentation GOSIM", "Stand d’exposition + intervention sur la scène principale", "Chaque projet dispose d’un stand pour les démonstrations et les échanges, ainsi que d’un créneau dédié sur la scène principale de la conférence pour présenter le produit et réaliser une démonstration en direct devant l’ensemble du public."]],
    sprintSupportTitle: "Soutien sur place",
    sprintSupport: ["Revue produit et UX", "Conseil IA, ingénierie et systèmes", "Impression 3D et fabrication de base", "Espace de travail et répétition de la démo"],
    submitKicker: "03 / CE QUE DEMANDE LE FORMULAIRE",
    submitTitle: "Préparez ces éléments,\npuis candidatez",
    submitText: "Le formulaire prend environ 10–15 minutes. Les liens du prototype et de la démo doivent rester accessibles pendant l’évaluation.",
    materialsTitle: "Le formulaire exige",
    materials: ["Présentation de l’équipe et du projet", "Utilisateurs, contexte et problème", "Travail central de l’Agent et différence", "Prototype accessible et démo d’une minute", "Objectif à Shenzhen, besoins et plan open source"],
    judgingKicker: "05 / ÉVALUATION",
    judgingTitle: "Évaluation",
    judgingText: "60 % évaluent la valeur produit et l’UX IA ; 40 % vérifient que le prototype est réel, stable et vérifiable.",
    subjective: "Valeur produit et UX",
    objective: "Réalisation et complétude",
    subjectiveItems: [["Un problème utilisateur important", ""], ["Une expérience utilisateur IA convaincante", ""], ["Innovation et potentiel", ""]],
    objectiveItems: ["Un prototype réellement testable", "Une réalisation stable et crédible", "Une équipe capable de livrer la version finale"],
    openKicker: "06 / RÉSULTATS & OPEN SOURCE",
    openTitle: "Laisser un résultat public",
    openStages: [["Sélection en ligne", "Open source facultatif, mais prototype vérifiable"], ["Après sélection", "Code central, prototype ou résultat principal à ouvrir en principe"], ["Démonstration finale", "Dépôt public, page projet ou méthode de publication claire"]],
    openNote: "Les finalistes doivent fournir un dépôt public, une note technique ou un produit accessible. Des dérogations sont possibles pour code commercial, design matériel ou données privées.",
    faqKicker: "07 / FAQ",
    faqTitle: "Questions fréquentes",
    qaGroupLink: "Scanner pour rejoindre le groupe WeChat（微信群）",
    qaGroupAlt: "Code QR du groupe WeChat（微信群）de GOSIM Spotlight",
    faqs: [["Faut-il construire du matériel ?", "Ce n’est pas obligatoire, mais c’est vivement encouragé. Concevoir une nouvelle forme matérielle ou adapter un appareil existant permet d’explorer plus pleinement l’interaction native Agent ; un projet entièrement logiciel reste admissible lorsque le logiciel est le meilleur support de l’expérience centrale."], ["Quel niveau de prototype est attendu ?", "L’expérience essentielle doit surtout être claire et vérifiable. Site web, Figma, application, simulateur ou appareil peuvent tous servir de point de départ."], ["Peut-on participer avec peu de compétences techniques ?", "Oui. Les projets au design fort peuvent recevoir un soutien logiciel et technique sur place, tout en restant responsables du résultat."], ["Quand les candidatures ferment-elles ?", "Le premier tour ferme le dimanche 13 septembre 2026 à 23 h 59, heure de Pékin (UTC+8). Les résultats sont annoncés le 21 septembre."]],
    applyEyebrow: "READY TO BUILD THE NEXT INTERFACE?",
    applyTitle: "NEXT IS NOT GIVEN.\nDEFINE IT.",
    applyText: "Présentez votre thèse de catégorie, votre prototype système et votre plan de première version pour Spotlight Shenzhen 2026.",
    applyButton: "Commencer la candidature",
    applyHint: "Prévoyez 10–15 minutes ; dossiers acceptés en français, anglais ou chinois",
    conference: "Visiter GOSIM Shenzhen 2026",
  },
} as const;

const c = content[locale] || content.en;
const sectionTitle = (text: string) => text.split("\n");
const applyPath = locale === "zh"
  ? "/shenzhen2026/apply/"
  : `/${locale}/shenzhen2026/apply/`;
---

<Layout
  title={c.metaTitle}
  description={c.metaDesc}
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Spotlight Shenzhen 2026: Next-Gen AI-Native Products"
  socialImage="/images/shenzhen2026/og-shenzhen-film.png"
  locale={locale}
  nativeScroll={true}
  footerVariant="spotlight"
>
  <div class="spotlight-page monolith-page">
    <a class="application-ribbon" href={applyPath} aria-label={`${c.ribbonStatus}。${c.ribbonDeadline}。${c.ribbonCta}`}>
      <div class="application-ribbon__status">
        <span aria-hidden="true"></span>
        {c.ribbonStatus}
      </div>
      <div class="application-ribbon__marquee" aria-label={c.ribbonDeadline}>
        <div class="application-ribbon__track" aria-hidden="true">
          {Array.from({ length: 6 }).map(() => (
            <span class="application-ribbon__item">
              <b>SPOTLIGHT SHENZHEN 2026</b>
              <span>{c.ribbonDeadline}</span>
              <strong>{c.ribbonCta}<i class="shape-icon shape-icon--arrow shape-icon--up-right"></i></strong>
            </span>
          ))}
        </div>
      </div>
    </a>

    <section class="sz-hero" id="top" data-theme-section="light">
      <video
        id="shenzhen-hero-video"
        class="hero-video"
        data-autoplay-video
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline="true"
        preload="auto"
        poster="/images/shenzhen2026/shenzhen-hero-poster.jpg"
        aria-hidden="true"
        tabindex="-1"
      >
        <source
          src="/videos/shenzhen-spotlight-soundless-mobile.mp4"
          type="video/mp4"
          media="(max-width: 760px)"
        />
        <source src="/videos/shenzhen-spotlight-soundless.mp4" type="video/mp4" />
      </video>
      <div class="hero-wash" aria-hidden="true"></div>
      <div class="spotlight-container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow light">{c.eyebrow}</p>
          <h1>{sectionTitle(c.heroProgramTitle).map((line) => <>{line}<br /></>)}</h1>
          <p class="hero-slogan">{c.heroTitle} {c.heroAccent}</p>
        </div>
        <div class="hero-footer">
          <div class="hero-meta">
            {c.meta.map((item) => <div>{item}</div>)}
          </div>
          <div class="hero-actions">
            <a class="spot-button primary" href="https://shenzhen2026.gosim.org" target="_blank" rel="noopener noreferrer">{c.heroConference}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span></a>
            <a class="spot-button ghost" href={applyPath} aria-describedby="application-note">{c.heroSecondary}</a>
          </div>
          <p class="application-note" id="application-note"><span></span>{c.heroNote}</p>
        </div>
      </div>
    </section>

    <section class="spot-section directions" id="about" data-theme-section="light">
      <div class="spotlight-container">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">{c.directionsKicker}</p>
            <h2>{sectionTitle(c.directionsTitle).map((line) => <span class="directions-title-line">{line}</span>)}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.directionsText}</p>
          </div>
        </div>

        <div class="form-grid-primary">
          {c.forms.map((item, index) => (
            <article><span>{c.optionLabel} {String.fromCharCode(65 + index)}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="spot-section benefits" id="benefits" data-theme-section="light">
      <div class="spotlight-container">
        <div class="section-head split-head benefits-head">
          <div>
            <p class="eyebrow">{c.benefitsKicker}</p>
            <h2>{sectionTitle(c.benefitsTitle).map((line) => <>{line}<br /></>)}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.benefitsText}</p>
          </div>
        </div>
        <div class="benefit-grid">
          {c.benefits.map((benefit, index) => (
            <article>
              <div class="benefit-top">
                <span>{String(index + 1).padStart(2, "0")} / {benefit[1]}</span>
                <img src={benefit[4]} alt="" aria-hidden="true" loading="lazy" />
              </div>
              <h3>{benefit[0]}</h3>
              <p>{benefit[2]}</p>
              <strong>{benefit[3]}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="spot-section submission" id="submission" data-theme-section="light">
      <div class="spotlight-container">
        <div class="section-head split-head light-head">
          <div>
            <p class="eyebrow light">{c.submitKicker}</p>
            <h2>{sectionTitle(c.submitTitle).map((line) => <>{line}<br /></>)}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.submitText}</p>
          </div>
        </div>

        <h3 class="subheading">{c.materialsTitle}</h3>
        <ul class="requirement-list">
          {c.materials.map((item) => <li>{item}</li>)}
        </ul>
        <div class="submission-action">
          <a href={applyPath}>{c.ribbonCta}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span></a>
        </div>
      </div>
    </section>

    <section class="spot-section format" id="format" data-theme-section="light">
      <div class="spotlight-container">
        <div class="section-head center-head">
          <p class="eyebrow">{c.formatKicker}</p>
          <h2 class="format-title">
            {c.formatTitle.map((step, index) => <><span>{step}</span>{index < c.formatTitle.length - 1 && <span class="shape-icon shape-icon--arrow format-title-arrow" aria-hidden="true"></span>}</>)}
          </h2>
          <p class="section-intro">{c.formatText}</p>
        </div>
        <div class="stage-grid">
          {c.stages.map((stage, index) => (
            <article class="stage-card">
              <div class="stage-top"><span>{stage[0]}</span>{index < 2 && <span class="shape-icon shape-icon--arrow stage-flow-icon" aria-hidden="true"></span>}</div>
              <h3>{stage[1]}</h3>
              <strong>{stage[2]}</strong>
              <p>{stage[3]}</p>
              {index === 1 && (
                <div class="stage-support">
                  <span>{c.sprintSupportTitle}</span>
                  <ul>{c.sprintSupport.map((item) => <li>{item}</li>)}</ul>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="spot-section judging" id="judging" data-theme-section="light">
      <div class="spotlight-container">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">{c.judgingKicker}</p>
            <h2>{c.judgingTitle}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.judgingText}</p>
          </div>
        </div>

        <div class="score-grid">
          <article class="score-card subjective-card">
            <div class="score-header"><div class="score-ring ring-60"><strong>60</strong><small>%</small></div><h3>{c.subjective}</h3></div>
            <div class="score-lines">
              {c.subjectiveItems.map((item) => <div><span>{item[0]}</span></div>)}
            </div>
          </article>
          <article class="score-card objective-card">
            <div class="score-header"><div class="score-ring ring-40"><strong>40</strong><small>%</small></div><h3>{c.objective}</h3></div>
            <ul>{c.objectiveItems.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
        <div class="outcome-note" id="outcomes">
          <div><p class="eyebrow">{c.openKicker}</p><h3>{c.openTitle}</h3></div>
          <p>{c.openNote}</p>
        </div>
      </div>
    </section>

    <section class="spot-section faq-section" id="faq">
      <div class="spotlight-container faq-layout">
        <div class="faq-title">
          <p class="eyebrow">{c.faqKicker}</p>
          <h2>{c.faqTitle}</h2>
          <a
            class="qa-group-link"
            href="/images/shenzhen2026/spotlight-qa-wechat-group.png"
            target="_blank"
            rel="noopener noreferrer"
          >
            {c.qaGroupLink}
            <span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span>
          </a>
          <img
            class="qa-group-qr"
            src="/images/shenzhen2026/spotlight-qa-wechat-group.png"
            alt={c.qaGroupAlt}
            loading="lazy"
          />
        </div>
        <div class="faq-list">
          {c.faqs.map((faq) => (
            <details>
              <summary><span>{faq[0]}</span><span class="faq-toggle" aria-hidden="true"><span class="shape-icon shape-icon--plus"></span></span></summary>
              <p>{faq[1]}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="apply-section" id="apply" data-theme-section="light">
      <div class="spotlight-container apply-inner">
        <p class="eyebrow light">{c.applyEyebrow}</p>
        <h2>{sectionTitle(c.applyTitle).map((line) => <>{line}<br /></>)}</h2>
        <p>{c.applyText}</p>
        <div class="apply-actions">
          <a class="apply-primary" href={applyPath}>{c.applyButton}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span></a>
          <a href="https://shenzhen2026.gosim.org" target="_blank" rel="noopener noreferrer">{c.conference}<span class="shape-icon shape-icon--arrow shape-icon--up-right" aria-hidden="true"></span></a>
        </div>
        <small><span></span>{c.applyHint}</small>
      </div>
    </section>
  </div>
</Layout>


<style>
  :global(html) { scroll-behavior: auto; }
  :global(body) { background: #f4f3ef; }
  :global(.monolith-page) {
    --ink: #171918;
    --paper: #f4f3ef;
    --white: #fff;
    --red: #ff431a;
    --mineral: #94b8ad;
    --mineral-deep: #174943;
    --graphite: #1b1d1c;
    --mist: #dbe7e3;
    --muted: #5e625f;
    --line: rgba(23, 25, 24, .22);
    background: var(--paper);
    color: var(--ink);
    font-family: "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif;
  }

  :global(body[data-bg-nav="header-home"] .main-nav-bar) {
    padding-top: 12px;
    padding-bottom: 12px;
    isolation: isolate;
    z-index: 20;
    box-shadow: none !important;
  }
  :global(body[data-bg-nav="header-home"] .main-nav-bar .nav-fill) {
    opacity: 1 !important;
    overflow: hidden;
    background:
      linear-gradient(112deg, rgba(255, 255, 255, .1) 0%, rgba(255, 255, 255, .015) 34%, rgba(93, 131, 123, .11) 62%, rgba(7, 9, 8, .08) 100%),
      rgba(12, 14, 13, .56) !important;
    -webkit-backdrop-filter: blur(28px) saturate(1.12) contrast(1.04);
    backdrop-filter: blur(28px) saturate(1.12) contrast(1.04);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .2), inset 0 -1px 0 rgba(255, 255, 255, .06) !important;
  }
  :global(body[data-bg-nav="header-home"] .main-nav-bar .nav-fill::before) {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(75% 180% at 16% -95%, rgba(255, 255, 255, .3), transparent 58%),
      radial-gradient(58% 150% at 82% 175%, rgba(101, 158, 146, .16), transparent 62%);
  }
  :global(body[data-bg-nav="header-home"] .main-nav-bar .nav-fill::after) {
    content: "";
    position: absolute;
    top: -150%;
    bottom: -150%;
    left: 24%;
    width: 20%;
    pointer-events: none;
    transform: rotate(18deg);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .07), transparent);
    filter: blur(10px);
  }
  :global(body[data-bg-nav="header-home"] .main-nav-bar .border-bottom) {
    opacity: 1 !important;
    background: rgba(255, 255, 255, .14) !important;
  }
  :global(body[data-bg-nav="header-home"] .main-nav-bar .logo svg path) { fill: #fff !important; }
  :global(body[data-bg-nav="header-home"] .main-nav-bar .link .link-click > span),
  :global(body[data-bg-nav="header-home"] .main-nav-bar .lang-current) { color: #fff !important; text-shadow: none !important; }
  :global(body[data-bg-nav="header-home"] .main-nav-bar .has-sublinks svg) { stroke: #fff !important; }
  :global(body[data-bg-nav="header-home"] .main-nav-bar .hamburger .bar) { background: #fff !important; }
  :global(.footer--spotlight) { background: #181818 !important; border-top: 1px solid rgba(255, 255, 255, .18); }

  .application-ribbon {
    --ribbon-bg: #ff6a43;
    position: fixed;
    top: 72px;
    left: 0;
    z-index: 18;
    width: 100%;
    height: 46px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: stretch;
    color: var(--ink);
    background: var(--ribbon-bg);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: 13px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: transform .45s cubic-bezier(.7, 0, .3, 1), opacity .2s ease;
  }
  .application-ribbon:hover { --ribbon-bg: #ff805f; color: var(--ink); }
  .application-ribbon:focus-visible { outline: 3px solid #fff; outline-offset: -4px; }
  .application-ribbon__status {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 22px;
    white-space: nowrap;
  }
  .application-ribbon__status { border-right: 1px solid var(--ink); background: var(--ribbon-bg); }
  .application-ribbon__status > span {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 4px rgba(23, 25, 24, .14);
  }
  .application-ribbon__marquee { min-width: 0; display: flex; align-items: center; overflow: hidden; }
  .application-ribbon__track {
    width: max-content;
    display: flex;
    align-items: center;
    will-change: transform;
    animation: application-ribbon-scroll 42s linear infinite;
  }
  .application-ribbon__item { display: flex; align-items: center; gap: 42px; padding-left: 42px; white-space: nowrap; }
  .application-ribbon__track b { color: rgba(23, 25, 24, .56); font-weight: 650; }
  .application-ribbon__item strong { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); font-weight: 900; }
  .application-ribbon__item strong::before { content: ""; width: 18px; height: 1px; margin-right: 2px; background: rgba(23, 25, 24, .55); }
  .application-ribbon__item .shape-icon { width: 11px; height: 11px; }
  :global(body[data-scrolling-started="true"][data-scrolling-direction="down"]) .application-ribbon { transform: translateY(-72px); }
  :global(body[data-navigation-status="active"]) .application-ribbon { opacity: 0; pointer-events: none; }

  @keyframes application-ribbon-scroll {
    to { transform: translateX(-50%); }
  }

  .spotlight-container { width: min(1440px, calc(100% - 96px)); margin: 0 auto; }
  .spot-section { position: relative; padding: clamp(80px, 8vw, 118px) 0; }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #a53a22;
    font-size: 14px;
    line-height: 1.35;
    letter-spacing: .13em;
    text-transform: uppercase;
    font-weight: 800;
  }
  .eyebrow::before { content: ""; width: 15px; height: 3px; flex: 0 0 auto; background: var(--red); }
  .section-head { margin-bottom: 52px; }
  .split-head { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(340px, .85fr); gap: 7vw; align-items: end; }
  .section-head h2,
  .faq-title h2 {
    max-width: 17ch;
    margin-top: 15px;
    color: var(--ink);
    font-size: clamp(2.5rem, 3.4vw, 3.85rem);
    line-height: 1.05;
    letter-spacing: -.045em;
    font-weight: 700;
  }
  :global(html[lang="zh"]) .section-head h2,
  :global(html[lang="zh"]) .faq-title h2 { max-width: none; line-height: 1.2; letter-spacing: -.025em; }
  .section-intro { max-width: 700px; color: var(--muted); font-size: clamp(1.05rem, 1.15vw, 1.2rem); line-height: 1.72; }

  .sz-hero {
    position: relative;
    height: 100svh;
    min-height: 720px;
    overflow: hidden;
    background: #111;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background: #111;
    filter: none;
  }
  .hero-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .3;
    background:
      linear-gradient(90deg, #080808 0%, rgba(8, 8, 8, .86) 22%, rgba(8, 8, 8, .18) 50%, transparent 68%),
      linear-gradient(180deg, transparent 52%, rgba(8, 8, 8, .2) 68%, #080808 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(150px, 18vh, 190px) 0 42px;
  }
  .hero-copy {
    width: min(730px, 62vw);
