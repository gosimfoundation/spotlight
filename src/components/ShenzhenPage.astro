    applyText: "The application form is in preparation. Start refining your core scenario, interactive prototype, and one-minute demo flow now.",
    applyButton: "Applications coming soon",
    applyHint: "The form will open here when ready",
    conference: "Visit GOSIM Shenzhen 2026",
  },
  fr: {
