    formatText: "La première étape valide l’idée, l’expérience et la capacité d’exécution à faible coût. La seconde concentre les ressources pour finaliser ou améliorer un prototype réel.",
    stages: [["01", "Sélection en ligne", "Valider valeur, expérience et faisabilité", "Prototype interactif, courte vidéo et plan de réalisation"], ["02", "Accélération à Shenzhen", "Environ deux jours pour construire et affiner", "Produit fonctionnel avec soutien logiciel, matériel et mentorat"], ["03", "Démonstration finale", "Présenter la prochaine génération de produits IA", "Visibilité, promotion et opportunités d’incubation"]],
    submitKicker: "03 / SOUMISSION EN LIGNE",
    submitTitle: "Transformer l’idée\nen une expérience à essayer",
    submitText: "La phase en ligne recherche une idée produit claire et une manière de l’expérimenter ou de la vérifier. Site web, Figma, application, simulateur ou appareil existant peuvent porter le concept, sans investissement matériel coûteux au départ.",
    materialsTitle: "Éléments recommandés",
    materials: [["Concept produit", "Public, scénario et valeur essentielle"], ["Expérience Agent", "Comment l’Agent améliore ou repense le parcours"], ["Prototype interactif", "Web, Figma, app, simulateur ou appareil réel"], ["Vidéo de démo", "Moins d’une minute recommandé, avec le parcours principal"], ["Étape suivante", "Ce que vous souhaitez terminer à Shenzhen et le soutien utile"]],
    accelerateKicker: "05 / ACCÉLÉRATION À SHENZHEN",
    accelerateTitle: "Transformer une bonne idée en produit crédible et fonctionnel",
    accelerateText: "Les équipes retenues participent à environ deux jours de construction avant la conférence. Les produits complets peaufinent leur expérience ; les autres reçoivent un soutien ciblé en logiciel, matériel ou narration.",
    support: [["Aide au prototype", "Jusqu’à l’équivalent de 100 $US remboursés par projet"], ["Logiciels", "Crédits modèles, outils et software factory"], ["Soutien technique", "Assistants, ingénieurs et accompagnement sur place"], ["Fabrication", "Impression 3D, pièces de base et espace d’assemblage"], ["Espace", "Bureau à Shenzhen ou lieu de collaboration désigné"], ["Coaching démo", "Narration, déroulé et présentation"]],
    budgetTitle: "Soutien au prototype",
    budgetNote: "Le soutien peut couvrir les logiciels, l’intégration d’appareils et la fabrication nécessaires, sur remboursement des dépenses réelles.",
    judgingKicker: "06 / ÉVALUATION",
    judgingTitle: "Valeur produit et réalisation comptent autant",
    judgingText: "60 % portent sur la valeur produit, l’expérience Agent, l’interaction et l’innovation ; 40 % sur la complétude, la difficulté de réalisation et la crédibilité du prototype.",
    subjective: "Évaluation du jury",
    objective: "Réalisation objective",
    subjectiveItems: [["Valeur produit et cas d’usage", ""], ["Expérience Agent", ""], ["UX et design d’interaction", ""], ["Innovation et potentiel de diffusion", ""]],
    objectiveItems: ["Prototype fonctionnel et vérifiable", "Intégration logiciel ou appareil", "Difficulté et stabilité", "Complétude et capacité d’exécution"],
    openKicker: "07 / RÉSULTATS & OPEN SOURCE",
    openTitle: "Du prototype crédible au résultat public",
    openStages: [["Sélection en ligne", "Open source facultatif, mais prototype vérifiable"], ["Après sélection", "Code central, prototype ou résultat principal à ouvrir en principe"], ["Démonstration finale", "Dépôt public, page projet ou méthode de publication claire"]],
    openNote: "Des dérogations raisonnables sont possibles pour code commercial tiers, design matériel ou données personnelles. Les meilleurs projets pourront bénéficier de la promotion et de l’incubation GOSIM.",
    faqKicker: "08 / FAQ",
    faqTitle: "Questions fréquentes",
    faqs: [["Faut-il construire du matériel ?", "Ce n’est pas obligatoire, mais c’est vivement encouragé. Concevoir une nouvelle forme matérielle ou adapter un appareil existant permet d’explorer plus pleinement l’interaction native Agent ; un projet entièrement logiciel reste admissible lorsque le logiciel est le meilleur support de l’expérience centrale."], ["Quel niveau de prototype est attendu ?", "L’expérience essentielle doit surtout être claire et vérifiable. Site web, Figma, application, simulateur ou appareil peuvent tous servir de point de départ."], ["Peut-on participer avec peu de compétences techniques ?", "Oui. Les projets au design fort peuvent recevoir un soutien logiciel et technique sur place, tout en restant responsables du résultat."], ["Quand les candidatures ferment-elles ?", "Les candidatures sont ouvertes. La date de clôture sera annoncée sur cette page ; les premiers dossiers pourront être évalués au fil de l’eau."]],
    applyEyebrow: "READY TO BUILD THE NEXT INTERFACE?",
    applyTitle: "NEXT IS NOT GIVEN.\nDEFINE IT.",
    applyText: "Présentez votre thèse de catégorie, votre prototype système et votre plan de première version pour Spotlight Shenzhen 2026.",
    applyButton: "Commencer la candidature",
    applyHint: "Prévoyez 20–30 minutes ; dossiers acceptés en français, anglais ou chinois",
    conference: "Visiter GOSIM Shenzhen 2026",
  },
} as const;

const c = content[locale] || content.en;
const sectionTitle = (text: string) => text.split("\n");
const applyPath = locale === "zh"
  ? "/shenzhen2026/apply/"
  : `/${locale}/shenzhen2026/apply/`;
---

<Layout
  title={c.metaTitle}
  description={c.metaDesc}
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Spotlight Shenzhen 2026: Next-Gen AI-Native Products"
  socialImage="/images/shenzhen2026/og-shenzhen.png"
  locale={locale}
>
  <div class="spotlight-page monolith-page">
    <section class="sz-hero" id="top" data-theme-section="dark">
      <div class="hero-grid"></div>
      <div class="hero-aura"></div>

      <div class="spotlight-container hero-inner">
        <div class="hero-orbit" aria-hidden="true">
          {c.heroOrbit.map((item) => <span>{item}</span>)}
        </div>
        <div class="hero-copy">
          <p class="eyebrow light">{c.eyebrow}</p>
          <h1>{c.heroTitle}<br /><span>{c.heroAccent}</span></h1>
          <p class="hero-statement">{c.heroStatement}</p>
          <p class="hero-lede">{c.heroText}</p>
          <div class="hero-actions">
            <a class="spot-button primary" href="https://shenzhen2026.gosim.org" target="_blank" rel="noopener noreferrer">{c.heroConference}<span aria-hidden="true">↗</span></a>
            <a class="spot-button ghost" href={applyPath} aria-describedby="application-note">{c.heroSecondary}</a>
          </div>
          <p class="application-note" id="application-note"><span></span>{c.heroNote}</p>
        </div>

        <div class="agent-console" aria-label="Agent experience concept">
          <div class="console-top">
            <div class="console-dots"><i></i><i></i><i></i></div>
            <span>{c.agentLabel}</span>
          </div>
          <div class="console-body">
            <div class="user-bubble">“{c.agentPrompt}”</div>
            <div class="agent-state">
              <div class="agent-orb"><span>AI</span></div>
              <div>
                <small>{c.agentContext}</small>
                <p>{c.agentStatus}</p>
              </div>
            </div>
            <ol class="agent-flow">
              {c.agentSteps.map((step, index) => <li class={index < c.agentSteps.length - 1 ? "done" : "active"}><span>{String(index + 1).padStart(2, "0")}</span>{step}</li>)}
            </ol>
          </div>
        </div>
      </div>

      <div class="spotlight-container hero-meta">
        {c.meta.map((item) => <div>{item}</div>)}
      </div>
    </section>

    <section class="signal-strip" aria-label={c.signalLabel}>
      <div class="spotlight-container signal-inner">
        <div>
          <p class="eyebrow">{c.signalLabel}</p>
          <h2>{c.signalTitle}</h2>
        </div>
        <div class="signal-tags">{c.signalTags.map((tag) => <span>{tag}</span>)}</div>
      </div>
    </section>

    <section class="spot-section definition" id="about">
      <div class="spotlight-container">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">{c.definitionKicker}</p>
            <h2>{sectionTitle(c.definitionTitle).map((line) => <>{line}<br /></>)}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.definitionText}</p>
          </div>
        </div>

        <div class="timeline-grid">
          {c.timeline.map((item, index) => (
            <article>
              <div class="timeline-marker"><span>{String(index + 1).padStart(2, "0")}</span></div>
              <time>{item[0]}</time>
              <h3>{item[1]}</h3>
              <p>{item[2]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="spot-section directions" id="directions" data-theme-section="dark">
      <div class="spotlight-container">
        <div class="section-head split-head light-head">
          <div>
            <p class="eyebrow light">{c.directionsKicker}</p>
            <h2>{c.directionsTitle}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.directionsText}</p>
          </div>
        </div>

        <div class="form-grid-primary">
          {c.forms.map((item, index) => (
            <article><span>OPTION {String.fromCharCode(65 + index)}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>
          ))}
        </div>

        <div class="principles-compact">
          <p class="eyebrow light">{c.principlesTitle}</p>
          <div class="principle-strip">
            {c.principles.map((item, index) => (
              <article><span>{index + 1}</span><div><h4>{item[0]}</h4><p>{item[1]}</p></div></article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="spot-section submission" id="submission" data-theme-section="dark">
      <div class="spotlight-container">
        <div class="section-head split-head light-head">
          <div>
            <p class="eyebrow light">{c.submitKicker}</p>
            <h2>{sectionTitle(c.submitTitle).map((line) => <>{line}<br /></>)}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.submitText}</p>
          </div>
        </div>

        <h3 class="subheading">{c.materialsTitle}</h3>
        <div class="material-grid">
          {c.materials.map((item, index) => (
            <article><span>{String(index + 1).padStart(2, "0")}</span><div><h4>{item[0]}</h4><p>{item[1]}</p></div></article>
          ))}
        </div>

      </div>
    </section>

    <section class="spot-section format" id="format">
      <div class="spotlight-container">
        <div class="section-head center-head">
          <p class="eyebrow">{c.formatKicker}</p>
          <h2>{c.formatTitle}</h2>
          <p class="section-intro">{c.formatText}</p>
        </div>
        <div class="stage-grid">
          {c.stages.map((stage, index) => (
            <article class="stage-card">
              <div class="stage-top"><span>{stage[0]}</span>{index < 2 && <i aria-hidden="true">→</i>}</div>
              <h3>{stage[1]}</h3>
              <strong>{stage[2]}</strong>
              <p>{stage[3]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="spot-section accelerate" id="support">
      <div class="spotlight-container">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">{c.accelerateKicker}</p>
            <h2>{c.accelerateTitle}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.accelerateText}</p>
          </div>
        </div>
        <div class="support-grid">
          {c.support.map((item, index) => (
            <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>
          ))}
        </div>
        <div class="support-note"><strong>{c.budgetTitle}</strong><p>{c.budgetNote}</p></div>
      </div>
    </section>

    <section class="spot-section judging" id="judging">
      <div class="spotlight-container">
        <div class="section-head split-head">
          <div>
            <p class="eyebrow">{c.judgingKicker}</p>
            <h2>{c.judgingTitle}</h2>
          </div>
          <div class="head-side">
            <p class="section-intro">{c.judgingText}</p>
          </div>
        </div>

        <div class="score-grid">
          <article class="score-card subjective-card">
            <div class="score-header"><div class="score-ring ring-60"><strong>60</strong><small>%</small></div><h3>{c.subjective}</h3></div>
            <div class="score-lines">
              {c.subjectiveItems.map((item) => <div><span>{item[0]}</span></div>)}
            </div>
          </article>
          <article class="score-card objective-card">
            <div class="score-header"><div class="score-ring ring-40"><strong>40</strong><small>%</small></div><h3>{c.objective}</h3></div>
            <ul>{c.objectiveItems.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
        <div class="outcome-note" id="outcomes">
          <div><p class="eyebrow">{c.openKicker}</p><h3>{c.openTitle}</h3></div>
          <p>{c.openNote}</p>
        </div>
      </div>
    </section>

    <section class="spot-section faq-section" id="faq">
      <div class="spotlight-container faq-layout">
        <div class="faq-title"><p class="eyebrow">{c.faqKicker}</p><h2>{c.faqTitle}</h2></div>
        <div class="faq-list">
          {c.faqs.map((faq) => (
            <details>
              <summary><span>{faq[0]}</span><i aria-hidden="true">+</i></summary>
              <p>{faq[1]}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="apply-section" id="apply" data-theme-section="dark">
      <div class="apply-glow"></div>
      <div class="spotlight-container apply-inner">
        <p class="eyebrow light">{c.applyEyebrow}</p>
        <h2>{sectionTitle(c.applyTitle).map((line) => <>{line}<br /></>)}</h2>
        <p>{c.applyText}</p>
        <div class="apply-actions">
          <a class="apply-primary" href={applyPath}>{c.applyButton}<span aria-hidden="true">↗</span></a>
          <a href="https://shenzhen2026.gosim.org" target="_blank" rel="noopener noreferrer">{c.conference}<span aria-hidden="true">↗</span></a>
        </div>
        <small><span></span>{c.applyHint}</small>
      </div>
    </section>
  </div>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f4f2ed; }
  :global(.spotlight-page) { --ink: #151a17; --muted: #58625d; --acid: #76f0c8; --violet: #a8c9be; --line: rgba(21, 26, 23, 0.15); font-family: "Manrope", sans-serif; color: var(--ink); }
  .spotlight-container { width: min(1440px, calc(100% - 80px)); margin: 0 auto; }
  .spot-section { padding: 96px 0; position: relative; }
  .eyebrow { color: #29515d; font-size: 12px; line-height: 1.2; letter-spacing: .15em; text-transform: uppercase; font-weight: 700; }
  .eyebrow.light { color: var(--acid); }
  .section-head { margin-bottom: 48px; }
  .split-head { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr); gap: 5vw; align-items: end; }
  .section-head h2 { white-space: normal; font-size: clamp(2.35rem, 4.2vw, 4.6rem); line-height: 1.02; letter-spacing: -.055em; margin-top: 16px; color: var(--ink); }
  .section-intro { color: var(--muted); font-size: clamp(1rem, 1.15vw, 1.2rem); line-height: 1.6; }
  .head-side { min-width: 0; }
  .section-sticker { display: block; width: min(100%, 560px); height: auto; margin: 20px 0 -18px auto; object-fit: contain; object-position: center; pointer-events: none; user-select: none; filter: drop-shadow(0 18px 28px rgba(21,26,23,.18)); }
  .sticker-camera { width: min(100%, 540px); transform: rotate(1.5deg); }
  .sticker-accessibility { width: min(100%, 580px); transform: rotate(-1.5deg); filter: drop-shadow(0 18px 30px rgba(118,240,200,.18)); }
  .sticker-travel { transform: rotate(1deg); }
  .sticker-study { width: min(100%, 580px); transform: rotate(-1.5deg); }
  .sticker-wellness { transform: rotate(1.5deg); }
  .light-head h2, [data-theme-section="dark"] .section-head h2 { color: #fff; }
  .light-head .section-intro, [data-theme-section="dark"] .section-intro { color: rgba(255,255,255,.68); }

  .sz-hero { min-height: min(880px, 100svh); position: relative; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; background: #0c100e; padding: 145px 0 0; }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.12) brightness(.8); }
  .hero-colorwash { position: absolute; inset: 0; background: linear-gradient(145deg, rgba(6,32,24,.72) 0%, rgba(13,96,73,.62) 48%, rgba(4,45,34,.8) 100%); mix-blend-mode: multiply; }
  .hero-colorwash::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(36,151,116,.42) 0%, rgba(18,104,79,.28) 48%, rgba(4,48,36,.32) 100%); mix-blend-mode: color; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(2,10,8,.7) 0%, rgba(4,25,19,.38) 50%, rgba(4,34,26,.12) 100%), linear-gradient(0deg, rgba(2,13,10,.62) 0%, transparent 58%); box-shadow: inset 0 0 0 100vmax rgba(3,24,18,.1); }
  .hero-grid { position: absolute; inset: 0; opacity: .15; background-image: linear-gradient(rgba(118,240,200,.2) 1px, transparent 1px), linear-gradient(90deg, rgba(118,240,200,.2) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom, transparent 3%, #000 45%, #000 100%); }
  .hero-inner { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(340px, .72fr); gap: 6vw; align-items: center; flex: 1; padding: 20px 0 44px; }
  .hero-copy h1 { color: #fff; font-size: clamp(3.5rem, 6.4vw, 6.8rem); line-height: .92; letter-spacing: -.07em; max-width: 11ch; margin: 20px 0 24px; font-weight: 600; }
  .hero-copy h1 span { color: var(--acid); }
  .hero-lede { color: rgba(255,255,255,.78); font-size: clamp(1.05rem, 1.4vw, 1.4rem); line-height: 1.62; max-width: 670px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .spot-button { min-height: 56px; padding: 0 24px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; gap: 36px; font-size: 15px; font-weight: 700; text-decoration: none; transition: transform .25s ease, background .25s ease; }
  .spot-button:hover { transform: translateY(-2px); }
  .spot-button.primary { background: var(--acid); color: #10201a; }
  .spot-button.ghost { border: 1px solid rgba(255,255,255,.35); color: #fff; background: rgba(255,255,255,.07); backdrop-filter: blur(12px); }
  .application-note { margin-top: 16px; display: flex; align-items: center; gap: 9px; color: rgba(255,255,255,.5); font-size: 12px; }
  .application-note span, .apply-inner small span { width: 7px; height: 7px; background: #f4c65c; border-radius: 50%; box-shadow: 0 0 12px rgba(244,198,92,.85); }
  .agent-console { background: linear-gradient(145deg, rgba(7,37,29,.82), rgba(9,18,15,.72)); border: 1px solid rgba(118,240,200,.34); border-radius: 24px; backdrop-filter: blur(22px); box-shadow: 0 24px 80px rgba(0,0,0,.34), 0 0 70px rgba(118,240,200,.08); overflow: hidden; transform: rotate(1.5deg); }
  .console-top { height: 52px; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.12); display: flex; justify-content: space-between; align-items: center; color: rgba(255,255,255,.48); font-size: 10px; letter-spacing: .14em; }
  .console-dots { display: flex; gap: 6px; }.console-dots i { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,.25); }
  .console-body { padding: 20px; }
  .user-bubble { background: rgba(255,255,255,.09); color: rgba(255,255,255,.82); border-radius: 16px 16px 4px 16px; padding: 17px 18px; font-size: 14px; line-height: 1.5; margin-left: 15%; }
  .agent-state { display: flex; align-items: center; gap: 14px; margin: 20px 0 15px; }
  .agent-orb { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle at 32% 30%, #e2fff6, var(--acid) 40%, #3e7b69 78%); box-shadow: 0 0 32px rgba(118,240,200,.3); color: #10251e; font-weight: 800; font-size: 12px; }
  .agent-state small { color: var(--acid); font-size: 9px; letter-spacing: .16em; }.agent-state p { color: #fff; font-size: 13px; line-height: 1.4; margin-top: 4px; }
  .agent-flow { display: grid; gap: 8px; }
  .agent-flow li { min-height: 38px; padding: 0 13px; border: 1px solid rgba(255,255,255,.1); border-radius: 11px; display: flex; align-items: center; gap: 13px; color: rgba(255,255,255,.48); font-size: 12px; }
  .agent-flow li span { font-size: 9px; color: rgba(255,255,255,.32); }.agent-flow li.done { color: rgba(255,255,255,.78); }.agent-flow li.done::after { content: "DONE"; margin-left: auto; color: var(--acid); font-size: 8px; letter-spacing: .12em; }.agent-flow li.active { border-color: rgba(118,240,200,.55); color: #fff; box-shadow: inset 0 0 25px rgba(118,240,200,.07); }
  .hero-meta { min-height: 64px; position: relative; z-index: 2; border-top: 1px solid rgba(118,240,200,.24); display: grid; grid-template-columns: repeat(3,1fr); }
  .hero-meta div { display: flex; align-items: center; padding: 0 22px; border-right: 1px solid rgba(118,240,200,.2); color: rgba(224,255,246,.74); font-size: 11px; letter-spacing: .12em; }.hero-meta div:first-child { padding-left: 0; }.hero-meta div:last-child { border: 0; }

  .signal-strip { background: var(--acid); padding: 36px 0; }
  .signal-inner { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; }
  .signal-inner .eyebrow { color: rgba(7,27,37,.62); }.signal-inner h2 { max-width: 950px; font-size: clamp(1.8rem, 3vw, 3.6rem); line-height: 1.08; letter-spacing: -.045em; margin-top: 12px; color: var(--ink); }
  .signal-tags { display: grid; grid-template-columns: repeat(2,auto); gap: 8px; }.signal-tags span { border: 1px solid rgba(7,27,37,.35); border-radius: 999px; padding: 8px 13px; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }

  .definition { background: #f4f2ed; }
  .timeline-grid { position: relative; display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .timeline-grid::before { content: ""; position: absolute; z-index: 0; top: 38px; left: 4%; right: 4%; height: 2px; background: linear-gradient(90deg, var(--acid), #9ccfbe 62%, var(--ink)); }
  .timeline-grid article { position: relative; z-index: 1; min-height: 238px; padding: 22px 24px 24px; border-right: 1px solid var(--line); }
  .timeline-grid article:last-child { border-right: 0; }
